--- a/tests/test_governance.py	2026-11-13 14:57:35
+++ b/tests/test_governance.py	2026-11-14 11:22:54
@@ -174,6 +174,78 @@
     )["status"] == "expired"
 
 
+def test_repeated_execution_is_invalid_state_without_executor_call():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, successful_executor)
+    snapshot = deepcopy(executed)
+    calls = []
+
+    def executor(executor_input):
+        calls.append(executor_input)
+        return {"receipt": "second"}
+
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(executed, "execute", "alice", NOW, executor)
+    assert calls == []
+    assert executed == snapshot
+
+
+def test_boolean_pseudonymized_flag_is_not_accepted_as_privacy_plan():
+    legacy = request("submitted", pseudonymized=True)
+    del legacy["privacy_plan"]
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(legacy, "approve", "bob", NOW)
+
+    wrong_domain = request("submitted")
+    wrong_domain["privacy_plan"]["domain"] = "other purpose"
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(wrong_domain, "approve", "bob", NOW)
+
+    extra_field = request("approved", approval_expires_on="2025-02-01")
+    extra_field["privacy_plan"]["fields"].append("name")
+    calls = []
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(
+            extra_field, "execute", "alice", NOW, lambda r: calls.append(r) or {}
+        )
+    assert calls == []
+
+
+def test_missing_metadata_blocks_approval_and_execution():
+    missing = request("submitted")
+    del missing["metadata"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(missing, "approve", "bob", NOW)
+
+    approved = request("approved", approval_expires_on="2025-02-01")
+    approved["metadata"]["representative"] = False
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, successful_executor)
+
+
+def test_executor_returning_non_dict_fails_execution():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    snapshot = deepcopy(approved)
+    with pytest.raises(ValueError, match="EXECUTION_FAILED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, lambda r: None)
+    assert approved == snapshot
+
+
+def test_history_chronology_with_offset_timezone_and_rejection():
+    plus_two = timezone(timedelta(hours=2))
+    submitted = apply_reuse_action(
+        request(), "submit", "alice", datetime(2025, 1, 1, 14, 0, tzinfo=plus_two)
+    )
+    rejected = apply_reuse_action(submitted, "reject", "bob", NOW + timedelta(hours=1))
+    assert rejected["status"] == "rejected"
+    assert rejected["history"] == [
+        {"action": "submit", "actor": "alice", "at": "2025-01-01T12:00:00Z"},
+        {"action": "reject", "actor": "bob", "at": "2025-01-01T13:00:00Z"},
+    ]
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(rejected, "approve", "bob", NOW)
+
+
