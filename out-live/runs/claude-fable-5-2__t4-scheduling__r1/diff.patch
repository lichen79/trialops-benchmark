+
+    assert [visit["offset_months"] for visit in visits] == [2, 1, 0]
+    assert [visit["local"] for visit in visits] == [
+        "2023-03-31T09:00:00+02:00",
+        "2023-03-01T09:00:00+01:00",
+        "2023-01-31T09:00:00+01:00",
+    ]
+
+
+def test_capacity_boundary_is_inclusive_across_competing_visits():
+    closed = {date(2024, 1, 31)} | {
+        date(2024, 2, day) for day in range(1, 29)
+    }
+    capacity = {date(2024, 2, 29): 2, date(2024, 3, 1): 0}
+
+    visits = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1, 2],
+        hour=10,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+        capacity=capacity,
+    )
+
+    assert [visit["local"][:10] for visit in visits] == [
+        "2024-02-29",
+        "2024-02-29",
+        "2024-03-31",
+    ]
+    assert capacity == {date(2024, 2, 29): 2, date(2024, 3, 1): 0}
