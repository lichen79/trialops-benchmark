+def test_history_chronology_for_rejected_and_expired_branches():
+    submitted = apply_reuse_action(request(), "submit", "alice", NOW)
+    rejected = apply_reuse_action(
+        submitted, "reject", "bob", NOW + timedelta(minutes=1)
+    )
+    assert rejected["status"] == "rejected"
+    assert [entry["action"] for entry in rejected["history"]] == ["submit", "reject"]
+    assert [entry["at"] for entry in rejected["history"]] == [
+        "2025-01-01T12:00:00Z",
+        "2025-01-01T12:01:00Z",
+    ]
+
+    # A rejected request can no longer be approved, executed, or expired.
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(rejected, "approve", "bob", NOW + timedelta(days=1))
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(rejected, "expire", "system", NOW + timedelta(days=1))
+    with pytest.raises(PermissionError, match="REQUESTER_REQUIRED"):
+        apply_reuse_action(
+            rejected, "execute", "bob", NOW + timedelta(days=1), successful_executor
+        )
+
+    pending = apply_reuse_action(request(), "submit", "alice", NOW)
+    expired = apply_reuse_action(
+        pending, "expire", "retention-job", datetime(2025, 7, 1, tzinfo=timezone.utc)
+    )
+    assert expired["status"] == "expired"
+    assert expired["history"][-1]["at"] == "2025-07-01T00:00:00Z"
+    assert [entry["action"] for entry in expired["history"]] == ["submit", "expire"]
+
