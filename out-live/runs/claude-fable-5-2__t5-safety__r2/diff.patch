+@pytest.mark.parametrize(
+    ("levels", "expected"),
+    [
+        (["other", "other"], "other"),
+        (["other", "hospitalization"], "hospitalization"),
+        (["hospitalization", "life_threatening"], "life_threatening"),
+        (["life_threatening", "fatal"], "fatal"),
+        (["other", "fatal"], "fatal"),
+        (["hospitalization", "other", "life_threatening"], "life_threatening"),
+        (["other", "hospitalization", "life_threatening", "fatal"], "fatal"),
+    ],
+)
+def test_highest_seriousness_wins_wherever_it_appears_in_the_chain(levels, expected):
+    for ordered in (levels, levels[::-1]):
+        events = [
+            event(
+                f"S{index}",
+                seriousness=level,
+                follow_up_of=f"S{index - 1}" if index else None,
+            )
+            for index, level in enumerate(ordered)
+        ]
+        [case] = triage_events(events, now=NOW)
+        assert case["case_id"] == "S0"
+        assert case["seriousness"] == expected
+
