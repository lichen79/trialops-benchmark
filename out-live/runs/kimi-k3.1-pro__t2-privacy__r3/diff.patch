+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request with its governed privacy export."""
+
+    # Import lazily so the standalone export remains usable without importing
+    # the governance workflow, and governance validation precedes consumption.
+    from .governance import apply_reuse_action
+
+    def executor(approved_request: dict[str, object]) -> dict[str, Any]:
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(
+        request, "execute", actor, now, executor=executor
+    )
