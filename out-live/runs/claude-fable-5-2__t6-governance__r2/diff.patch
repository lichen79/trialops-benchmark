+def test_reject_records_history_and_blocks_later_execution():
+    submitted = request("submitted")
+    rejected = apply_reuse_action(submitted, "reject", "bob", NOW)
+    assert rejected["status"] == "rejected"
+    assert rejected["history"] == [
+        {"action": "reject", "actor": "bob", "at": "2025-01-01T12:00:00Z"}
+    ]
+    assert submitted["status"] == "submitted"
+    assert submitted["history"] == []
+
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(rejected, "execute", "alice", NOW, executor)
+    assert str(caught.value) == "INVALID_STATE"
+    assert calls == []
