+def book_subject_visits(
+    subject,
+    protocol,
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Check eligibility, plan all visits, then commit their reservations."""
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a caller-owned dict of dates to slots")
+
+    evaluation = evaluate_subject(subject, protocol, on)
+    if not evaluation["eligible"]:
+        raise ValueError("INELIGIBLE: " + ", ".join(evaluation["reasons"]))
+
+    # plan_visits owns all scheduling validation and uses a private allocation
+    # snapshot. The caller's capacity is changed only after the full plan exists.
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    for visit in visits:
+        visit_day = date.fromisoformat(visit["local"][:10])
+        if visit_day in capacity:
+            capacity[visit_day] -= 1
+
+    return visits
 
