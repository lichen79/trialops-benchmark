+def test_from_records_requires_both_trusted_arguments():
+    original = two_event_chain()
+
+    with pytest.raises(TypeError):
+        AuditChain.from_records(original.records)
+    with pytest.raises(TypeError):
+        AuditChain.from_records(original.records, expected_head=original.head())
+    with pytest.raises(TypeError):
+        AuditChain.from_records(original.records, expected_length=2)
+
+    # None means "not supplied" to verify(); it must not skip a restore check.
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            original.records, expected_head=None, expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH"
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            original.records, expected_head=original.head(), expected_length=None
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:LENGTH_MISMATCH"
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records([], expected_head=None, expected_length=None)
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+
+
+def test_from_records_rejects_wrong_anchors():
+    original = two_event_chain()
+    records = original.records
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            records, expected_head=records[0]["hash"], expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH"
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            records, expected_head=original.head(), expected_length=3
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:LENGTH_MISMATCH"
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            records, expected_head=GENESIS_HASH, expected_length=0
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+
+    # A bool is not a trusted length even though True == 1.
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            records[:1], expected_head=records[0]["hash"], expected_length=True
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:LENGTH_MISMATCH"
+
+
+def test_from_records_rejects_truncated_suffix():
+    original = two_event_chain()
+    truncated = original.records[:1]
+    assert AuditChain.verify(truncated) == []
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            truncated, expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+
+    # Either anchor alone is enough to expose the truncation.
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            truncated, expected_head=original.head(), expected_length=1
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH"
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            truncated, expected_head=truncated[0]["hash"], expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:LENGTH_MISMATCH"
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            [], expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+
+
+def test_from_records_rejects_tampered_and_rehashed_snapshots():
+    original = two_event_chain()
+
+    tampered = deepcopy(original.records)
+    tampered[0]["payload"]["nested"]["value"] = 99
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            tampered, expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:BAD_HASH"
+
+    # A fully rehashed edit is internally consistent; only the anchor sees it.
+    rehashed = deepcopy(original.records)
+    rehashed[0]["payload"]["nested"]["value"] = 99
+    rehash(rehashed[0])
+    rehashed[1]["previous_hash"] = rehashed[0]["hash"]
+    rehash(rehashed[1])
+    assert AuditChain.verify(rehashed) == []
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            rehashed, expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH"
+
+    # Several codes are reported sorted and comma-joined.
+    replayed = [original.records[0], deepcopy(original.records[0])]
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            replayed, expected_head=original.head(), expected_length=3
+        )
+    assert str(excinfo.value) == (
+        "INVALID_CHAIN:BAD_PREVIOUS_HASH,BAD_SEQUENCE,DUPLICATE_EVENT_ID,"
+        "HEAD_MISMATCH,LENGTH_MISMATCH,NON_INCREASING_TIMESTAMP"
+    )
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            None, expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:MALFORMED_RECORD"
+
+
+def test_from_records_empty_snapshot_needs_genesis_anchor():
+    restored = AuditChain.from_records(
+        [], expected_head=GENESIS_HASH, expected_length=0
+    )
+    assert restored.records == []
+    assert restored.head() == GENESIS_HASH
+
+    first = append_event(restored)
+    assert first["sequence"] == 1
+    assert first["previous_hash"] == GENESIS_HASH
+    assert first == append_event(AuditChain())
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records([], expected_head=first["hash"], expected_length=0)
+    assert str(excinfo.value) == "INVALID_CHAIN:HEAD_MISMATCH"
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records([], expected_head=GENESIS_HASH, expected_length=1)
+    assert str(excinfo.value) == "INVALID_CHAIN:LENGTH_MISMATCH"
+
+
+def test_restored_instances_are_independent():
+    original = two_event_chain()
+    snapshot = deepcopy(original.records)
+    first = AuditChain.from_records(
+        snapshot, expected_head=original.head(), expected_length=2
+    )
+    second = AuditChain.from_records(
+        snapshot, expected_head=original.head(), expected_length=2
+    )
+
+    assert first.records is not second.records
+    assert first.records[0] is not second.records[0]
+
+    later = AT + timedelta(seconds=2)
+    appended = append_event(first, "event-3", later)
+    assert len(first.records) == 3
+    assert len(second.records) == 2
+    assert second.head() == original.head()
+    assert len(original.records) == 2
+
+    # The duplicate index is per instance: the other restore may reuse the ID.
+    assert append_event(second, "event-3", later) == appended
+    first.records[0]["payload"]["nested"]["value"] = 7
+    assert second.records[0]["payload"]["nested"]["value"] == 1
+    assert snapshot == original.records
+
+
+def test_from_records_reports_uncopyable_nesting_as_invalid_chain(monkeypatch):
+    original = two_event_chain()
+
+    def too_deep(value):
+        raise RecursionError
+
+    monkeypatch.setattr("trialops.audit.deepcopy", too_deep)
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            original.records, expected_head=original.head(), expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN:BAD_PAYLOAD"
+
