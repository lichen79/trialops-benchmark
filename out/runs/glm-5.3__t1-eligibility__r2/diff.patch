@@ -0,0 +1,77 @@
+from datetime import date, datetime
+
+from trialops.eligibility import evaluate_subject
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3], "Z": [10, 20]},
+        "exclusions": ["DO_NOT_ENROLL", "PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+        "labs": {"A": 2, "Z": 15},
+        "flags": [],
+    }
+
+
+def show(label, fn):
+    try:
+        print(label, "=> OK", fn())
+    except Exception as exc:  # noqa: BLE001
+        print(label, "=>", type(exc).__name__, repr(str(exc)))
+
+
+def mod(**kw):
+    s = make_subject()
+    s.update(kw)
+    return s
+
+
+def pmod(**kw):
+    p = make_protocol()
+    p.update(kw)
+    return p
+
+
+ON = date(2024, 6, 15)
+
+
+def run(subject, protocol, on=ON):
+    return lambda: evaluate_subject(subject, protocol, on)
+
+
+print("=== subject required fields ===")
+for key in ["birth_date", "consents", "labs", "flags"]:
+    s = make_subject()
+    del s[key]
+    show(f"del subject.{key}", run(s, make_protocol()))
+
+print("=== protocol required fields ===")
+for key in ["min_age", "max_age", "required_consent_version", "consent_valid_from", "labs", "exclusions"]:
+    p = make_protocol()
+    del p[key]
+    show(f"del protocol.{key}", run(make_subject(), p))
+
+print("=== subject birth_date malformed ===")
+for v in ["not-a-date", "20240615", "2024-W24-1", "2024-06-15T00:00:00", 5, None, datetime(2000, 6, 15), "2024-13-01", "2000-2-29", ""]:
+    show(f"birth_date={v!r}", run(mod(birth_date=v), make_protocol()))
+
+print("=== consents malformed ===")
+for v in ["nope", {}, None, [{}], ["v2"], [{"version": "v2"}], [{"signed_on": "2024-06-15"}],
+          [{"version": 2, "signed_on": "2024-06-15"}], [{"version": "v2", "signed_on": "bad"}],
+          [{"version": "v2", "signed_on": 5}], [{"version": "", "signed_on": "2024-06-15"}],
+          [{"version": "v2", "signed_on": "2024-06-15", "extra": 1}], [{"version": "v2", "signed_on": "2024-06-15"}, "x"]]:
+    show(f"consents={v!r}", run(mod(consents=v), make_protocol()))
+
+print("=== subject labs malformed ===")
+for v in ["nope", None, {"A": "2", "Z": 15}, {"A": True, "Z": 15}, {"A": 2, "Z": 15}, {"A": 2}]:
+    show(f"labs={v!r}", run(mod(labs=v), make_protocol()))
