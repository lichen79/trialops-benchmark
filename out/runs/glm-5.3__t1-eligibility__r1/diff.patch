+def test_no_eligible_consent_yields_none_version_and_missing_reason():
+    protocol = make_protocol()
+
+    empty = make_subject()
+    empty["consents"] = []
+    assert evaluate_subject(empty, protocol, date(2024, 6, 15)) == {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": None,
+    }
+
+    future_only = make_subject()
+    future_only["consents"] = [{"version": "v2", "signed_on": "2024-06-16"}]
+    assert evaluate_subject(future_only, protocol, date(2024, 6, 15)) == {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": None,
+    }
+
