+def test_history_normalizes_offset_aware_timestamps_to_utc_z():
+    offset_now = datetime(2025, 1, 1, 14, 30, tzinfo=timezone(timedelta(hours=2)))
+    submitted = apply_reuse_action(request(), "submit", "alice", offset_now)
+    assert submitted["history"] == [
+        {"action": "submit", "actor": "alice", "at": "2025-01-01T12:30:00Z"}
+    ]
+
+    west = datetime(2025, 1, 2, 9, 15, tzinfo=timezone(timedelta(hours=-5)))
+    approved = apply_reuse_action(submitted, "approve", "bob", west)
+    assert approved["approval_expires_on"] == "2025-02-01"
+    assert [entry["at"] for entry in approved["history"]] == [
+        "2025-01-01T12:30:00Z",
+        "2025-01-02T14:15:00Z",
+    ]
+
