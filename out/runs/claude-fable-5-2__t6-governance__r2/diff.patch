+def test_results_never_share_nested_state_with_the_input():
+    original = request("submitted")
+    snapshot = deepcopy(original)
+
+    approved = apply_reuse_action(original, "approve", "bob", NOW)
+    approved["metadata"]["quality_score"] = 0
+    approved["privacy_plan"]["fields"].append("email")
+    approved["history"].clear()
+
+    assert original == snapshot
+    assert "approval_expires_on" not in original
+
+    rejected = apply_reuse_action(original, "reject", "bob", NOW)
+    assert rejected["status"] == "rejected"
+    assert rejected["history"] is not original["history"]
+    assert original == snapshot
+
