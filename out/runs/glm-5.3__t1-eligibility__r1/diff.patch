+def test_lab_reasons_are_sorted_by_lab_name_regardless_of_protocol_order():
+    protocol = make_protocol()
+    protocol["labs"] = {"C": [1, 3], "A": [1, 3], "B": [1, 3]}
+    subject = make_subject()
+    subject["labs"] = {"C": 4, "B": 0, "A": 2}
+
+    result = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert result["reasons"] == ["LAB_B_LOW", "LAB_C_HIGH"]
