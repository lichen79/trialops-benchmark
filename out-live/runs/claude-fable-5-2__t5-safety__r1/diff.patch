+    ]
+
+    # 7 days after the follow-up's own onset would be 2024-02-08; the case
+    # deadline is 7 days after the earliest onset, 2024-01-17T08:00:00Z.
+    [case] = triage_events(events, now=datetime(2024, 1, 18, tzinfo=timezone.utc))
+
+    assert case["report_by"] == "2024-01-17T08:00:00Z"
+    assert case["overdue"] is True
