+@pytest.mark.parametrize("defect", PRIVACY_PLAN_DEFECTS)
+def test_approval_requires_the_exact_privacy_plan_not_a_boolean(defect):
+    candidate = request("submitted")
+    defect(candidate)
+    assert_fails_atomically(
+        candidate, "approve", "bob", NOW, "PSEUDONYMIZATION_REQUIRED"
+    )
