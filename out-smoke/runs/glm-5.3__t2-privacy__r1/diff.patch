+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, object]] | object,
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request against a pseudonymized export.
+
+    ``subjects`` is consumed only inside the single executor callback, so
+    governance rejections happen before any subject is even read. Every
+    export failure is converted into ``EXECUTION_FAILED`` by governance,
+    which also leaves the approved request and its history untouched.
+    """
+    # Imported lazily so this module never carries an import-time dependency
+    # on the export module.
+    from trialops.privacy import export_subjects
+
+    if not isinstance(request, dict):
+        raise TypeError("request must be a dict")
+
+    # Normalise ``now`` once, up front, so the executor's export date is the
+    # same UTC calendar day the history entry records.
+    now_utc_date = _aware_utc(now).date()
+
+    def executor(approved_snapshot: dict[str, object]) -> dict[str, object]:
+        # The snapshot is a deep copy owned by governance and carries the
+        # approved purpose; the supplied secret never touches it.
+        purpose = approved_snapshot.get("purpose")
+        return export_subjects(
+            subjects,
+            purpose=purpose,  # type: ignore[arg-type]
+            secret=secret,
+            on=now_utc_date,
+        )
+
+    executed = apply_reuse_action(
+        request, "execute", actor, now, executor=executor
+    )
+    assert isinstance(executed, dict)
+    return executed
