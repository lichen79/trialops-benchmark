+
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore an independent chain from a trusted persisted snapshot.
+
+        Both trusted anchors are required: the snapshot is only accepted when
+        it matches ``expected_head`` and ``expected_length`` exactly.
+        """
+
+        if expected_head is None:
+            raise TypeError("expected_head is required")
+        if expected_length is None:
+            raise TypeError("expected_length is required")
+
+        try:
+            snapshot = list(records)
+        except (TypeError, ValueError, OverflowError):
+            errors = ["MALFORMED_RECORD"]
+        else:
+            errors = cls.verify(
+                snapshot,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+
+        if errors:
+            raise ValueError(f"INVALID_CHAIN:{','.join(errors)}")
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        chain.previous_hash = (
+            chain.records[-1]["hash"] if chain.records else GENESIS_HASH
+        )
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        return chain
