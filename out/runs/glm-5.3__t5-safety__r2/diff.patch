+
+def test_non_mapping_events_are_rejected():
+    with pytest.raises(ValueError, match="INVALID_EVENT"):
+        triage_events(["not-an-event"], now=AWARE_NOW)
+    with pytest.raises(TypeError):
+        triage_events(None, now=AWARE_NOW)
