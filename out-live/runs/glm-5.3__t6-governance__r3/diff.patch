+def test_expire_uses_the_deadline_relevant_to_the_state():
+    approved = request(
+        "approved", approval_expires_on="2025-02-01", retention_until="2025-12-31"
+    )
+    # The approval lapses long before retention does.
+    lapsed = apply_reuse_action(
+        approved, "expire", "system", datetime(2025, 2, 2, tzinfo=timezone.utc)
+    )
+    assert lapsed["status"] == "expired"
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(
+            approved, "expire", "system", datetime(2025, 1, 15, tzinfo=timezone.utc)
+        )
+
+    submitted = request("submitted", retention_until="2025-06-30")
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(submitted, "expire", "system", NOW)
+    assert apply_reuse_action(
+        submitted, "expire", "system", datetime(2025, 7, 1, tzinfo=timezone.utc)
+    )["status"] == "expired"
