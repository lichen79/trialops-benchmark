+def reuse_request(**changes):
+    purpose = changes.get("purpose", "research")
+    value = {
+        "id": "reuse-001",
+        "requester": "alice",
+        "reviewer": "bob",
+        "purpose": purpose,
+        "status": "approved",
+        "approval_expires_on": "2024-06-30",
+        "retention_until": "2024-06-30",
+        "privacy_plan": {
+            "algorithm": "hmac-sha256",
+            "domain": purpose,
+            "fields": ["pseudonym", "country", "birth_year", "visits"],
+        },
+        "metadata": {
+            "representative": True,
+            "complete": True,
+            "quality_score": 0.99,
+        },
+        "history": [{"action": "approve", "actor": "bob"}],
+    }
+    value.update(changes)
+    return value
+
+
+def test_execute_reuse_export_uses_approved_purpose_and_utc_date():
+    subject = make_subject(
+        "utc-boundary",
+        consents=[{"purpose": "research", "signed_on": "2024-06-16"}],
+    )
+    approved = reuse_request()
+    original = deepcopy(approved)
+    # At this offset, the UTC date is June 15 even though local time is June 16.
+    now = datetime(2024, 6, 16, 1, 0, tzinfo=timezone(timedelta(hours=12)))
+    expected = export_subjects(
+        [subject], purpose="research", secret="test-secret", on=date(2024, 6, 15)
+    )
+
+    executed = execute_reuse_export(
+        approved, [subject], actor="alice", secret="test-secret", now=now
+    )
+
+    assert executed["status"] == "executed"
+    assert executed["execution_result"] == expected
+    assert executed["execution_result"]["manifest"]["count"] == 0
+    assert executed["history"][-1] == {
+        "action": "execute",
+        "actor": "alice",
+        "at": "2024-06-15T13:00:00Z",
+    }
+    assert approved == original
+    assert "execution_result" not in approved
+
+    exported = canonical(executed["execution_result"])
+    history = canonical(executed["history"])
+    for sensitive in ("utc-boundary", "Fictional Person", "person@example.test", "test-secret"):
+        assert sensitive not in exported
+        assert sensitive not in history
+
+
+def test_reuse_export_failure_rolls_back_and_execution_is_not_repeated():
+    malformed = make_subject("sensitive-id", birth_date="not-a-date")
+    approved = reuse_request()
+    snapshot = deepcopy(approved)
+    now = datetime(2024, 6, 15, 12, 0, tzinfo=timezone.utc)
+
+    with pytest.raises(ValueError) as caught:
+        execute_reuse_export(
+            approved, [malformed], actor="alice", secret="test-secret", now=now
+        )
+    assert str(caught.value) == "EXECUTION_FAILED"
+    assert approved == snapshot
+    for sensitive in ("sensitive-id", "test-secret", "Fictional Person", "person@example.test"):
+        assert sensitive not in str(caught.value)
+        assert sensitive not in canonical(approved)
+
+    class CountingSubjects:
+        def __init__(self):
+            self.calls = 0
+
+        def __iter__(self):
+            self.calls += 1
+            yield make_subject("unused")
+
+    # Wrong actor and already-executed requests are governance failures, so
+    # neither path may advance the supplied subject collection.
+    for request_value, actor in (
+        (reuse_request(), "bob"),
+        (reuse_request(status="executed"), "alice"),
+    ):
+        subjects = CountingSubjects()
+        with pytest.raises((ValueError, PermissionError)) as caught:
+            execute_reuse_export(
+                request_value,
+                subjects,
+                actor=actor,
+                secret="test-secret",
+                now=now,
+            )
+        assert subjects.calls == 0
+        assert str(caught.value) in {"REQUESTER_REQUIRED", "INVALID_STATE"}
