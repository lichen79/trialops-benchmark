@@ -140,5 +142,30 @@
             "sha256": hashlib.sha256(canonical_rows).hexdigest(),
         },
     }
+
+
+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request without consuming it prematurely.
+
+    ``apply_reuse_action`` performs all role, state, retention, and approval
+    checks before invoking this local executor.  Keeping subject iteration in
+    that callback means rejected workflows never consume a lazy input.
+    """
+
+    def executor(approved_request: dict[str, object]) -> dict[str, Any]:
+        purpose = approved_request.get("purpose")
+        on = now.astimezone(timezone.utc).date()
+        return export_subjects(subjects, purpose=purpose, secret=secret, on=on)
+
+    return apply_reuse_action(
+        request, "execute", actor, now, executor=executor
+    )
 
 
