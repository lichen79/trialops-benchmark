         )
 
 
+NOW = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+
+@pytest.mark.parametrize(
+    ("seriousness", "report_by"),
+    [
+        ("fatal", "2024-03-08T00:00:00Z"),
+        ("life_threatening", "2024-03-08T00:00:00Z"),
+        ("hospitalization", "2024-03-16T00:00:00Z"),
+        ("other", "2024-03-31T00:00:00Z"),
+    ],
+)
+def test_reporting_offsets_from_earliest_onset(seriousness, report_by):
+    # Earliest onset (with a +01:00 offset) is the clock; the later follow-up
+    # arrival does not move the deadline. Window spans a leap day.
+    events = [
+        event("R", onset="2024-03-01T00:00:00Z"),
+        event(
+            "F",
+            follow_up_of="R",
+            onset="2024-03-01T01:00:00+01:00",
+            seriousness=seriousness,
+        ),
+        event("G", follow_up_of="F", onset="2024-03-05T00:00:00Z"),
+    ]
+    case = triage_events(events, now=NOW)[0]
+    assert case["onset"] == "2024-03-01T00:00:00Z"
+    assert case["seriousness"] == seriousness
+    assert case["report_by"] == report_by
+
+
+@pytest.mark.parametrize(
+    ("values", "expected"),
+    [
+        (["other", "hospitalization"], "hospitalization"),
+        (["hospitalization", "life_threatening", "other"], "life_threatening"),
+        (["life_threatening", "fatal", "hospitalization"], "fatal"),
+        (["fatal", "other"], "fatal"),
+        (["other", "other"], "other"),
+    ],
+)
+def test_seriousness_precedence(values, expected):
+    events = [event("E0", seriousness=values[0])]
+    for index, value in enumerate(values[1:], start=1):
+        events.append(event(f"E{index}", follow_up_of=f"E{index - 1}", seriousness=value))
+    assert triage_events(events, now=NOW)[0]["seriousness"] == expected
+
+
+def test_overdue_boundary_is_strict():
+    events = [event("A", onset="2024-01-01T00:00:00Z", seriousness="hospitalization")]
+    report_by = datetime(2024, 1, 16, tzinfo=timezone.utc)
+    assert triage_events(events, now=report_by)[0]["overdue"] is False
+    assert triage_events(events, now=report_by - report_by.resolution)[0]["overdue"] is False
+    assert triage_events(events, now=report_by + report_by.resolution)[0]["overdue"] is True
+    # Equal instant expressed in another offset is still not overdue.
+    other_zone = datetime.fromisoformat("2024-01-16T02:00:00+02:00")
+    assert triage_events(events, now=other_zone)[0]["overdue"] is False
+
+
+def test_input_order_does_not_affect_output():
+    events = [
+        event("R1", onset="2024-01-05T00:00:00Z", source="site-c"),
+        event("F1", follow_up_of="R1", source="site-a", uncertain=True),
+        event("F2", follow_up_of="F1", source="site-a", seriousness="fatal"),
+        event("R2", subject_pseudonym="subject-002", onset="2024-01-05T00:00:00Z"),
+        event("F3", follow_up_of="R2", subject_pseudonym="subject-002"),
+    ]
+    expected = triage_events(events, now=NOW)
+    assert triage_events(list(reversed(events)), now=NOW) == expected
+    assert triage_events(events[2:] + events[:2], now=NOW) == expected
+    assert [case["case_id"] for case in expected] == ["R1", "R2"]
+    assert expected[0]["event_ids"] == ["F1", "F2", "R1"]
+    assert expected[0]["sources"] == ["site-a", "site-c"]
+    assert expected[0]["onset"] == "2024-01-05T00:00:00Z"
+    assert expected[0]["uncertain"] is True
+    assert expected[1]["uncertain"] is False
+
+
+def test_output_contains_only_tracking_fields():
+    case = triage_events([event("A")], now=NOW)[0]
+    assert set(case) == {
+        "case_id", "subject_pseudonym", "event_code", "onset", "seriousness",
+        "report_by", "sources", "event_ids", "uncertain", "overdue",
+    }
+
+
+def test_duplicate_root_ids_are_rejected():
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [event("R"), event("F", follow_up_of="R"), event("R", source="site-z")],
+            now=NOW,
+        )
+
+
+def test_self_link_and_long_cycles_are_rejected():
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events([event("A", follow_up_of="A")], now=NOW)
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events(
+            [
+                event("R"),
+                event("A", follow_up_of="C"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B"),
+            ],
+            now=NOW,
+        )
+
+
+def test_mixed_subjects_and_deep_mixed_codes_are_rejected():
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [event("A"), event("B", follow_up_of="A", subject_pseudonym="subject-999")],
+            now=NOW,
+        )
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [
+                event("C", follow_up_of="B", event_code="SYNTH-02"),
+                event("B", follow_up_of="A"),
+                event("A"),
+            ],
+            now=NOW,
+        )
+
+
+@pytest.mark.parametrize("value", ["severe", "FATAL", "", None, 3])
+def test_unknown_seriousness_is_rejected(value):
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=value)], now=NOW)
+
+
+def test_non_boolean_uncertain_is_rejected():
+    with pytest.raises(ValueError, match="INVALID_UNCERTAIN"):
+        triage_events([event("A", uncertain="yes")], now=NOW)
+
+
 def test_naive_now_and_onset_are_rejected():
     with pytest.raises(ValueError, match="INVALID_NOW"):
         triage_events([], now=datetime(2024, 1, 1))
