+def test_history_chronology_normalizes_offsets_and_stays_append_only():
+    imported_entry = {
+        "action": "imported",
+        "actor": "system",
+        "at": "2024-12-31T09:00:00Z",
+    }
+    original = request(history=[imported_entry])
+    original_snapshot = deepcopy(original)
+
+    submitted = apply_reuse_action(original, "submit", "alice", NOW)
+    assert original == original_snapshot
+    assert original["history"] == [imported_entry]
+
+    # A +05:30 wall clock and a -05:00 wall clock that both denote 12:00 UTC
+    # on consecutive days must serialize to the same chronology as UTC inputs.
+    approved = apply_reuse_action(
+        submitted,
+        "approve",
+        "bob",
+        datetime(
+            2025, 1, 2, 17, 30, tzinfo=timezone(timedelta(hours=5, minutes=30))
+        ),
+    )
+    # The expiry window is computed from the UTC date, not the local wall clock.
+    assert approved["approval_expires_on"] == "2025-02-01"
+    executed = apply_reuse_action(
+        approved,
+        "execute",
+        "alice",
+        datetime(2025, 1, 3, 7, 0, tzinfo=timezone(-timedelta(hours=5))),
+        successful_executor,
+    )
+
+    assert [entry["action"] for entry in executed["history"]] == [
+        "imported",
+        "submit",
+        "approve",
+        "execute",
+    ]
+    assert [entry["at"] for entry in executed["history"]] == [
+        "2024-12-31T09:00:00Z",
+        "2025-01-01T12:00:00Z",
+        "2025-01-02T12:00:00Z",
+        "2025-01-03T12:00:00Z",
+    ]
+    assert [entry["actor"] for entry in executed["history"]] == [
+        "system",
+        "alice",
+        "bob",
+        "alice",
+    ]
+    timestamps = [
+        datetime.fromisoformat(entry["at"].replace("Z", "+00:00"))
+        for entry in executed["history"]
+    ]
+    assert timestamps == sorted(timestamps)
+    assert submitted["history"][-1]["at"] == "2025-01-01T12:00:00Z"
+    assert approved["history"][-1]["at"] == "2025-01-02T12:00:00Z"
+
