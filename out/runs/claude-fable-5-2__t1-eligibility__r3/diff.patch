+def test_leap_day_birthday_on_the_leap_day_and_in_a_non_leap_year():
+    protocol = make_protocol()
+    protocol.update(min_age=24, max_age=24, labs={}, exclusions=[])
+    subject = make_subject()
+    subject.update(
+        birth_date="2000-02-29",
+        consents=[{"version": "v2", "signed_on": "2024-01-01"}],
+        labs={},
+    )
+
+    assert evaluate_subject(subject, protocol, date(2024, 2, 29))["eligible"] is True
+
+    # In a non-leap year the birthday has not happened on 28 February and
+    # has happened on 1 March.
+    protocol.update(min_age=25, max_age=25)
+    assert evaluate_subject(subject, protocol, date(2025, 2, 28))["reasons"] == [
+        "AGE_BELOW_MIN"
+    ]
+    assert evaluate_subject(subject, protocol, date(2025, 3, 1))["eligible"] is True
+
+
+@pytest.mark.parametrize(
+    ("birth_date", "reasons"),
+    [
+        ("2006-06-15", []),  # turns 18 on the evaluation date
+        ("2006-06-16", ["AGE_BELOW_MIN"]),  # turns 18 the next day
+        ("1993-06-16", []),  # still 30, turns 31 the next day
+        ("1993-06-15", ["AGE_ABOVE_MAX"]),  # turns 31 on the evaluation date
+    ],
+)
+def test_age_limits_are_inclusive_to_the_day(birth_date, reasons):
+    subject = make_subject()
+    subject["birth_date"] = birth_date
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["reasons"] == reasons
+    assert result["eligible"] is (not reasons)
+
+
+@pytest.mark.parametrize(
+    ("labs", "reasons"),
+    [
+        ({"A": 1, "Z": 10}, []),
+        ({"A": 3, "Z": 20}, []),
+        ({"A": 0.99, "Z": 15}, ["LAB_A_LOW"]),
+        ({"A": 3.01, "Z": 15}, ["LAB_A_HIGH"]),
+        ({"A": 2, "Z": 9.99}, ["LAB_Z_LOW"]),
+        ({"A": 2, "Z": 20.01}, ["LAB_Z_HIGH"]),
+    ],
+)
+def test_lab_limits_are_inclusive(labs, reasons):
+    subject = make_subject()
+    subject["labs"] = labs
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["reasons"] == reasons
+
+
+@pytest.mark.parametrize(
+    ("consents", "reasons", "consent_version"),
+    [
+        ([], ["CONSENT_MISSING"], None),
+        # Signed the day after the evaluation date: not yet in effect.
+        ([{"version": "v2", "signed_on": "2024-06-16"}], ["CONSENT_MISSING"], None),
+        # Signed exactly on the first valid day.
+        ([{"version": "v2", "signed_on": "2024-01-01"}], [], "v2"),
+        # Right version, but signed before the consent became valid.
+        ([{"version": "v2", "signed_on": "2023-12-31"}], ["CONSENT_MISSING"], "v2"),
+        # Validly dated, but the wrong version.
+        ([{"version": "v1", "signed_on": "2024-06-15"}], ["CONSENT_VERSION"], "v1"),
+    ],
+)
+def test_consent_selection_and_assessment(consents, reasons, consent_version):
+    subject = make_subject()
+    subject["consents"] = consents
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result == {
+        "eligible": not reasons,
+        "reasons": reasons,
+        "consent_version": consent_version,
+    }
+
+
+def test_exclusions_follow_protocol_order_and_labs_sort_by_name():
+    protocol = make_protocol()
+    protocol.update(
+        exclusions=["ZETA", "ALPHA", "UNUSED"],
+        labs={"Z": [10, 20], "M": [0, 1], "A": [1, 3]},
+    )
+    subject = make_subject()
+    subject.update(
+        birth_date="2010-01-01",
+        consents=[],
+        flags=["ALPHA", "ZETA", "NOT_IN_PROTOCOL"],
+        labs={"A": 4, "M": 0.5, "Z": 9},
+    )
+
+    result = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert result == {
+        "eligible": False,
+        "reasons": [
+            "CONSENT_MISSING",
+            "AGE_BELOW_MIN",
+            "EXCLUSION_ZETA",
+            "EXCLUSION_ALPHA",
+            "LAB_A_HIGH",
+            "LAB_Z_LOW",
+        ],
+        "consent_version": None,
+    }
+
+
+@pytest.mark.parametrize("field", ["birth_date", "consents", "labs", "flags"])
+def test_missing_subject_field_raises_value_error_naming_it(field):
+    subject = make_subject()
+    del subject[field]
+
+    with pytest.raises(ValueError, match=field):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+
+@pytest.mark.parametrize(
+    "field",
+    [
+        "min_age",
+        "max_age",
+        "required_consent_version",
+        "consent_valid_from",
+        "labs",
+        "exclusions",
+    ],
+)
+def test_missing_protocol_field_raises_value_error_naming_it(field):
+    protocol = make_protocol()
+    del protocol[field]
+
+    with pytest.raises(ValueError, match=field):
+        evaluate_subject(make_subject(), protocol, date(2024, 6, 15))
+
+
+def test_malformed_consent_and_protocol_dates_raise_value_error_naming_the_field():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-02-30"}]
+    with pytest.raises(ValueError, match="signed_on"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    subject = make_subject()
+    subject["consents"] = [{"signed_on": "2024-06-15"}]
+    with pytest.raises(ValueError, match="version"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    protocol = make_protocol()
+    protocol["consent_valid_from"] = "01/01/2024"
+    with pytest.raises(ValueError, match="consent_valid_from"):
+        evaluate_subject(make_subject(), protocol, date(2024, 6, 15))
