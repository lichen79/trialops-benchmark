@@ -0,0 +1,191 @@
+from copy import deepcopy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import book_subject_visits, plan_visits
+
+ON = date(2024, 6, 15)
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3], "Z": [10, 20]},
+        "exclusions": ["DO_NOT_ENROLL", "PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+        "labs": {"A": 2, "Z": 15},
+        "flags": [],
+    }
+
+
+def book(capacity, **overrides):
+    arguments = {
+        "on": ON,
+        "first_day": date(2024, 7, 1),
+        "offsets_months": [0],
+        "hour": 9,
+        "minute": 0,
+        "timezone": "America/New_York",
+        "capacity": capacity,
+    }
+    arguments.update(overrides)
+    subject = arguments.pop("subject", None) or make_subject()
+    protocol = arguments.pop("protocol", None) or make_protocol()
+    return book_subject_visits(subject, protocol, **arguments)
+
+
+def test_sequential_bookings_contend_for_the_same_slot():
+    capacity = {date(2024, 7, 1): 1}
+
+    first = book(capacity)
+    assert [visit["local"] for visit in first] == ["2024-07-01T09:00:00-04:00"]
+    assert capacity == {date(2024, 7, 1): 0}
+
+    second = book(capacity)
+    assert [visit["local"] for visit in second] == ["2024-07-02T09:00:00-04:00"]
+    # The overflow day is unlisted: still unconstrained, and never inserted.
+    assert capacity == {date(2024, 7, 1): 0}
+
+
+def test_visits_of_one_plan_share_a_day_and_each_take_a_slot():
+    closed = {date(2024, 1, 31)} | {date(2024, 2, day) for day in range(1, 29)}
+    original_closed = closed.copy()
+    capacity = {date(2024, 2, 29): 3, date(2024, 12, 25): 4}
+
+    visits = book(
+        capacity,
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        closed_days=closed,
+    )
+
+    assert [visit["local"][:10] for visit in visits] == ["2024-02-29", "2024-02-29"]
+    assert capacity == {date(2024, 2, 29): 1, date(2024, 12, 25): 4}
+    assert closed == original_closed
+
+
+def test_later_visit_failure_rolls_back_but_keeps_earlier_bookings():
+    capacity = {date(2024, 7, 1): 2}
+    book(capacity)
+    assert capacity == {date(2024, 7, 1): 1}
+
+    second_nominal = date(2024, 8, 1)
+    closed = {second_nominal + timedelta(days=days) for days in range(367)}
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(capacity, offsets_months=[0, 1], closed_days=closed)
+
+    assert capacity == {date(2024, 7, 1): 1}
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"offsets_months": [0, 0]},
+        {"offsets_months": [-1]},
+        {"hour": 24},
+        {"minute": 60},
+        {"timezone": "Not/A_Real_Zone"},
+    ],
+)
+def test_invalid_planning_input_leaves_capacity_unchanged(overrides):
+    capacity = {date(2024, 7, 1): 1}
+
+    with pytest.raises(ValueError):
+        book(capacity, **overrides)
+
+    assert capacity == {date(2024, 7, 1): 1}
+
+
+def test_ineligible_subject_reports_ordered_reasons_and_books_nothing():
+    subject = make_subject()
+    subject.update(birth_date="1970-01-01", flags=["PRIOR", "DO_NOT_ENROLL"])
+    capacity = {date(2024, 7, 1): 1}
+
+    with pytest.raises(ValueError) as raised:
+        # Eligibility is checked before planning, so the bad zone is not reached.
+        book(capacity, subject=subject, timezone="Not/A_Real_Zone")
+
+    assert str(raised.value) == (
+        "INELIGIBLE:AGE_ABOVE_MAX,EXCLUSION_DO_NOT_ENROLL,EXCLUSION_PRIOR"
+    )
+    assert capacity == {date(2024, 7, 1): 1}
+
+
+def test_inputs_other_than_capacity_are_not_mutated():
+    subject, protocol = make_subject(), make_protocol()
+    original_subject, original_protocol = deepcopy(subject), deepcopy(protocol)
+    closed = [date(2024, 7, 1)]
+
+    book({}, subject=subject, protocol=protocol, closed_days=closed)
+
+    assert subject == original_subject
+    assert protocol == original_protocol
+    assert closed == [date(2024, 7, 1)]
+
+
+def test_capacity_must_be_a_dict():
+    with pytest.raises(TypeError):
+        book(None)
+
+
+def test_booking_returns_the_plan_with_dst_and_month_end_behaviour():
+    arguments = {
+        "first_day": date(2024, 1, 31),
+        "offsets_months": [1, 2, 13],
+        "hour": 2,
+        "minute": 30,
+        "timezone": "Europe/Paris",
+    }
+    capacity = {date(2024, 2, 29): 1, date(2024, 3, 31): 1, date(2025, 2, 28): 1}
+    expected = plan_visits(capacity=capacity, **arguments)
+
+    visits = book(capacity, **arguments)
+
+    assert visits == expected
+    assert [visit["local"] for visit in visits] == [
+        "2024-02-29T02:30:00+01:00",
+        "2024-03-31T03:30:00+02:00",  # spring-forward gap
+        "2025-02-28T02:30:00+01:00",
+    ]
+    assert capacity == {
+        date(2024, 2, 29): 0,
+        date(2024, 3, 31): 0,
+        date(2025, 2, 28): 0,
+    }
+
+
+def test_booking_moved_onto_new_york_transitions_keeps_the_wall_time():
+    capacity = {date(2024, 3, 9): 0, date(2024, 3, 10): 1, date(2024, 11, 2): 0}
+
+    spring = book(capacity, first_day=date(2024, 3, 9), hour=2, minute=30)
+    fall = book(capacity, first_day=date(2024, 11, 2), hour=1, minute=30)
+
+    assert spring == [
+        {
+            "offset_months": 0,
+            "local": "2024-03-10T03:30:00-04:00",
+            "utc": "2024-03-10T07:30:00Z",
+        }
+    ]
+    assert fall == [
+        {
+            "offset_months": 0,
+            "local": "2024-11-03T01:30:00-04:00",  # ambiguous: fold=0
+            "utc": "2024-11-03T05:30:00Z",
+        }
+    ]
+    assert capacity == {
+        date(2024, 3, 9): 0,
+        date(2024, 3, 10): 0,
+        date(2024, 11, 2): 0,
+    }
