+def test_from_records_deep_copies_input_records():
+    chain = AuditChain()
+    append_event(chain)
+    snapshot = deepcopy(chain.records)
+
+    restored = AuditChain.from_records(
+        snapshot, expected_head=chain.head(), expected_length=1
+    )
+
+    # Mutating the snapshot (or the restored records) does not affect the other.
+    snapshot[0]["payload"]["value"] = 99
+    assert restored.records[0]["payload"] == {"value": 1}
+    restored.records[0]["actor"] = "someone-else"
+    assert snapshot[0]["actor"] == "actor-1"
+    assert restored.verify(restored.records) == ["BAD_HASH"]
+
+    # A pristine restore remains valid.
+    pristine = AuditChain.from_records(
+        deepcopy(chain.records), expected_head=chain.head(), expected_length=1
+    )
+    assert pristine.verify(pristine.records) == []
+
+
+def test_from_records_rejects_wrong_anchors():
+    chain = AuditChain()
+    append_event(chain)
+    append_event(chain, "event-2", AT + timedelta(seconds=1))
+
+    with pytest.raises(ValueError) as wrong_length:
+        AuditChain.from_records(
+            chain.records, expected_head=chain.head(), expected_length=1
+        )
+    assert wrong_length.value.args[0] == "INVALID_CHAIN:LENGTH_MISMATCH"
