+++ b/trialops/audit.py	2026-11-13 20:29:00
@@ -235,3 +235,35 @@
             previous_record = record
 
         return sorted(errors)
+
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore an independently owned chain from a verified snapshot."""
+
+        try:
+            snapshot = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = cls.verify(
+            snapshot,
+            expected_head=expected_head,
+            expected_length=expected_length,
+        )
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        if chain.records:
+            chain.previous_hash = chain.records[-1]["hash"]
+        chain._event_ids = {
+            record["event_id"] for record in chain.records
+        }
+        return chain
