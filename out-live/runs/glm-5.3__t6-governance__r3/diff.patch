+def test_separation_of_duties_is_atomic_and_role_scoped():
+    """A requester may never review their own or anyone else's request."""
+
+    self_review = request("submitted", reviewer="alice")
+    snapshot = deepcopy(self_review)
+
+    with pytest.raises(ValueError, match="SELF_REVIEW"):
+        apply_reuse_action(self_review, "approve", "alice", NOW)
+
+    assert self_review == snapshot
+    assert self_review["status"] == "submitted"
+    assert self_review["history"] == []
+    assert "approval_expires_on" not in self_review
+
+    reviewer_may_not_submit = request("draft", requester="carol")
+    with pytest.raises(PermissionError, match="REQUESTER_REQUIRED"):
+        apply_reuse_action(reviewer_may_not_submit, "submit", "bob", NOW)
+
+    other_reviewer = request("submitted", reviewer="dana")
+    assert apply_reuse_action(other_reviewer, "approve", "dana", NOW)["status"] == "approved"
+
+    rejected = apply_reuse_action(other_reviewer, "reject", "dana", NOW)
+    assert rejected["status"] == "rejected"
+    assert "approval_expires_on" not in rejected
+
