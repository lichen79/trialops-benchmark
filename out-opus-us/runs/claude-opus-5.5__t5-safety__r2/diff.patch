         )
 
 
+NOW = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+
+@pytest.mark.parametrize(
+    ("seriousness", "report_by"),
+    [
+        ("fatal", "2024-03-08T00:00:00Z"),
+        ("life_threatening", "2024-03-08T00:00:00Z"),
+        ("hospitalization", "2024-03-16T00:00:00Z"),
+        ("other", "2024-03-31T00:00:00Z"),
+    ],
+)
+def test_report_by_offsets_from_earliest_onset(seriousness, report_by):
+    # Leap-year February; the follow-up arrives later but the clock starts at
+    # the earliest onset.
+    events = [
+        event("R", onset="2024-03-01T00:00:00Z"),
+        event(
+            "F",
+            follow_up_of="R",
+            onset="2024-03-05T00:00:00Z",
+            seriousness=seriousness,
+        ),
+    ]
+    (case,) = triage_events(events, now=NOW)
+    assert case["onset"] == "2024-03-01T00:00:00Z"
+    assert case["seriousness"] == seriousness
+    assert case["report_by"] == report_by
+
+
+@pytest.mark.parametrize(
+    ("levels", "expected"),
+    [
+        (["other", "hospitalization"], "hospitalization"),
+        (["hospitalization", "life_threatening", "other"], "life_threatening"),
+        (["life_threatening", "fatal"], "fatal"),
+        (["fatal", "other"], "fatal"),
+        (["other", "other"], "other"),
+    ],
+)
+def test_seriousness_precedence(levels, expected):
+    events = [event("E0", seriousness=levels[0])]
+    for index, level in enumerate(levels[1:], start=1):
+        events.append(
+            event(f"E{index}", follow_up_of=f"E{index - 1}", seriousness=level)
+        )
+    (case,) = triage_events(list(reversed(events)), now=NOW)
+    assert case["seriousness"] == expected
+
+
+def test_overdue_boundary_is_strict():
+    events = [event("A", onset="2024-01-01T00:00:00Z", seriousness="fatal")]
+    report_by = datetime(2024, 1, 8, tzinfo=timezone.utc)
+    resolution = report_by.resolution
+    assert not triage_events(events, now=report_by - resolution)[0]["overdue"]
+    assert not triage_events(events, now=report_by)[0]["overdue"]
+    assert triage_events(events, now=report_by + resolution)[0]["overdue"]
+    # An equal instant expressed in another offset is still not overdue.
+    other_zone = datetime.fromisoformat("2024-01-08T05:00:00+05:00")
+    assert not triage_events(events, now=other_zone)[0]["overdue"]
+
+
+def test_input_order_does_not_affect_output():
+    events = [
+        event("A1", onset="2024-01-05T00:00:00Z", source="site-c"),
+        event("A2", follow_up_of="A1", source="site-a", uncertain=True),
+        event("A3", follow_up_of="A2", source="site-c"),
+        event("B1", subject_pseudonym="subject-002", onset="2024-01-05T00:00:00Z"),
+        event("C1", subject_pseudonym="subject-003", event_code="SYNTH-02"),
+    ]
+    expected = triage_events(events, now=NOW)
+    assert triage_events(list(reversed(events)), now=NOW) == expected
+    assert triage_events(events[2:] + events[:2], now=NOW) == expected
+    by_id = {case["case_id"]: case for case in expected}
+    assert by_id["A1"]["event_ids"] == ["A1", "A2", "A3"]
+    assert by_id["A1"]["sources"] == ["site-a", "site-c"]
+    assert by_id["A1"]["uncertain"] is True
+    assert by_id["B1"]["uncertain"] is False
+
+
+def test_duplicate_root_ids_are_rejected_even_when_chained():
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [event("R"), event("F", follow_up_of="R"), event("R", source="x")],
+            now=NOW,
+        )
+
+
+def test_missing_root_in_middle_of_chain_is_rejected():
+    with pytest.raises(ValueError, match="MISSING_ROOT"):
+        triage_events(
+            [event("R"), event("F2", follow_up_of="F1")],
+            now=NOW,
+        )
+
+
+def test_self_link_and_long_cycles_are_rejected():
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events([event("A", follow_up_of="A")], now=NOW)
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events(
+            [
+                event("Root"),
+                event("A", follow_up_of="C"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B"),
+                event("D", follow_up_of="C"),
+            ],
+            now=NOW,
+        )
+
+
+def test_mixed_subject_and_mixed_code_deep_in_chain_are_rejected():
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [
+                event("A"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B", subject_pseudonym="subject-999"),
+            ],
+            now=NOW,
+        )
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [
+                event("C", follow_up_of="B", event_code="SYNTH-99"),
+                event("B", follow_up_of="A"),
+                event("A"),
+            ],
+            now=NOW,
+        )
+
+
+@pytest.mark.parametrize("value", ["severe", "Fatal", "", None, 3])
+def test_unknown_seriousness_is_rejected(value):
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=value)], now=NOW)
+
+
 def test_naive_now_and_onset_are_rejected():
