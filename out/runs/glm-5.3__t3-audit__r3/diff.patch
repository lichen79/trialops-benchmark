+def test_from_records_reports_sorted_error_codes():
+    original = build_chain(2)
+    broken = deepcopy(original.records)
+    broken[1]["sequence"] = 7
+    broken[1]["event_id"] = broken[0]["event_id"]
+
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            broken, expected_head=original.head(), expected_length=2
+        )
+
+    message = str(excinfo.value)
+    assert message.startswith("INVALID_CHAIN:")
+    codes = message.split(":", 1)[1].split(",")
+    assert codes == sorted(set(codes))
+    assert "BAD_SEQUENCE" in codes
+    assert "BAD_HASH" in codes
+    assert "DUPLICATE_EVENT_ID" in codes
+
