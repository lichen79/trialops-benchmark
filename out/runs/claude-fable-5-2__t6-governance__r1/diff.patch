+def test_reject_is_terminal_and_recorded():
+    submitted = request("submitted")
+    rejected = apply_reuse_action(submitted, "reject", "bob", NOW)
+    assert rejected["status"] == "rejected"
+    assert "approval_expires_on" not in rejected
+    assert rejected["history"] == [
+        {"action": "reject", "actor": "bob", "at": "2025-01-01T12:00:00Z"}
+    ]
+    assert submitted["status"] == "submitted"
+    assert submitted["history"] == []
+
+    for action, actor in (
+        ("submit", "alice"),
+        ("approve", "bob"),
+        ("reject", "bob"),
+        ("execute", "alice"),
+        ("expire", "system"),
+    ):
+        executor = RecordingExecutor()
+        assert_fails_atomically(
+            rejected, action, actor, NOW, "INVALID_STATE", executor
+        )
+        assert executor.calls == []
