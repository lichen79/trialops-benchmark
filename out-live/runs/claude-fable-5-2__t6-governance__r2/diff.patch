+def test_executor_must_return_a_dict_or_execution_fails():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    snapshot = deepcopy(approved)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return ["not", "a", "dict"]
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    assert str(caught.value) == "EXECUTION_FAILED"
+    assert len(calls) == 1
+    assert approved == snapshot
