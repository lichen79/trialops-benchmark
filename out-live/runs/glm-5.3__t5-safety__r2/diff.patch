+def test_unknown_seriousness_and_malformed_links_are_rejected():
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness="critical")], now=NOW)
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=None)], now=NOW)
