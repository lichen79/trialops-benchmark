+def test_overdue_boundary_is_strict():
+    events = [event("A", onset="2024-01-10T00:00:00Z", seriousness="fatal")]
+    boundary = datetime(2024, 1, 17, tzinfo=timezone.utc)
+    assert triage_events(events, now=boundary - timedelta(microseconds=1))[0]["overdue"] is False
+    assert triage_events(events, now=boundary)[0]["overdue"] is False
+    assert triage_events(events, now=boundary + timedelta(microseconds=1))[0]["overdue"] is True
+    # Same instant expressed in another offset is still not overdue.
+    other_zone = boundary.astimezone(timezone(timedelta(hours=-5)))
+    assert triage_events(events, now=other_zone)[0]["overdue"] is False
+
+
