+@pytest.mark.parametrize(
+    ("seriousness_values", "expected_seriousness", "expected_days"),
+    [
+        (["other"], "other", 30),
+        (["hospitalization"], "hospitalization", 15),
+        (["life_threatening"], "life_threatening", 7),
+        (["fatal"], "fatal", 7),
+        (["other", "other"], "other", 30),
+        (["other", "hospitalization"], "hospitalization", 15),
+        (["hospitalization", "other"], "hospitalization", 15),
+        (["hospitalization", "life_threatening"], "life_threatening", 7),
+        (["life_threatening", "fatal"], "fatal", 7),
+        (["other", "life_threatening", "fatal"], "fatal", 7),
+        (["fatal", "life_threatening", "hospitalization", "other"], "fatal", 7),
+    ],
+)
+def test_seriousness_precedence_and_reporting_windows(
+    seriousness_values, expected_seriousness, expected_days
+):
+    first_onset = datetime(2024, 1, 1, 12, 0, tzinfo=timezone.utc)
+    events = []
+    parent = None
+    for index, seriousness in enumerate(seriousness_values):
+        onset = first_onset + timedelta(days=index)
+        changes = {
+            "seriousness": seriousness,
+            "onset": onset.isoformat().replace("+00:00", "Z"),
+        }
+        if parent is not None:
+            changes["follow_up_of"] = parent
+        events.append(event(f"E{index}", **changes))
+        parent = f"E{index}"
+
+    [case] = triage_events(events, now=first_onset)
+
+    assert case["case_id"] == "E0"
+    assert case["onset"] == "2024-01-01T12:00:00Z"
+    assert case["seriousness"] == expected_seriousness
+    expected_report_by = first_onset + timedelta(days=expected_days)
+    assert case["report_by"] == expected_report_by.isoformat().replace("+00:00", "Z")
+
+
+def test_deadline_clock_starts_at_earliest_onset_not_followup_arrival():
+    events = [
+        event("ROOT", onset="2024-01-20T00:00:00Z", seriousness="other"),
+        event("EARLIER", follow_up_of="ROOT", onset="2024-01-05T00:00:00Z", source="site-a"),
+    ]
+
+    [case] = triage_events(events, now=datetime(2024, 2, 18, tzinfo=timezone.utc))
+
+    assert case["onset"] == "2024-01-05T00:00:00Z"
+    assert case["report_by"] == "2024-02-04T00:00:00Z"
+    assert case["event_ids"] == ["EARLIER", "ROOT"]
+    # Root onset plus 30 days would be 2024-02-19, which would not be overdue.
+    assert case["overdue"] is True
+
+
+def test_overdue_boundary_is_strict_and_instant_based():
+    events = [event("A", onset="2024-01-01T00:00:00Z", seriousness="other")]
+    report_by = datetime(2024, 1, 31, tzinfo=timezone.utc)
+
+    assert triage_events(events, now=report_by)[0]["overdue"] is False
+    assert (
+        triage_events(events, now=report_by + timedelta(microseconds=1))[0]["overdue"]
+        is True
+    )
+    # The same instant expressed in a non-UTC offset is still not overdue.
+    offset_now = report_by.astimezone(timezone(timedelta(hours=5, minutes=45)))
+    assert triage_events(events, now=offset_now)[0]["overdue"] is False
+
+
+def test_onset_offsets_normalize_to_the_same_utc_instant():
+    zulu = [
+        event("A", onset="2024-06-01T12:00:00Z"),
+        event("B", follow_up_of="A", onset="2024-06-01T09:00:00-03:00", source="site-a"),
+    ]
+    offsets = [
+        event("A", onset="2024-06-01T14:00:00+02:00"),
+        event("B", follow_up_of="A", onset="2024-06-01T12:00:00+00:00", source="site-a"),
+    ]
+
+    zulu_cases = triage_events(zulu, now=NOW)
+    offset_cases = triage_events(offsets, now=NOW)
+
+    assert zulu_cases == offset_cases
+    assert zulu_cases[0]["onset"] == "2024-06-01T12:00:00Z"
+    assert zulu_cases[0]["report_by"] == "2024-07-01T12:00:00Z"
