+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore an independent chain from a persisted, trusted snapshot.
+
+        The snapshot must verify against the trusted ``expected_head`` and
+        ``expected_length`` anchors; an empty snapshot is only valid with the
+        genesis hash and a length of zero.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = cls.verify(
+            materialized, expected_head=expected_head, expected_length=expected_length
+        )
+        if expected_length is None:
+            # A trusted length anchor is required when restoring a snapshot.
+            errors = sorted(set(errors) | {"LENGTH_MISMATCH"})
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        try:
+            chain.records = deepcopy(materialized)
+        except (TypeError, ValueError, RecursionError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+        for record in chain.records:
+            chain._event_ids.add(record["event_id"])
+        if chain.records:
+            chain.previous_hash = chain.records[-1]["hash"]
+        return chain
