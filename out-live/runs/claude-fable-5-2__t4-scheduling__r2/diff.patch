+def test_last_day_of_the_search_window_is_still_schedulable():
+    nominal = date(2024, 1, 1)
+    closed = {nominal + timedelta(days=days) for days in range(366)}
+
+    [visit] = plan_visits(
+        first_day=nominal,
+        offsets_months=[0],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+    )
+
+    assert visit["local"] == "2025-01-01T09:00:00-05:00"
+
+
+def test_multiple_visits_share_slots_until_the_day_is_full():
+    closed = {date(2024, 1, 31)} | {date(2024, 2, day) for day in range(1, 29)}
+    capacity = {date(2024, 2, 29): 2, date(2024, 3, 1): 0}
+
+    visits = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[2, 0, 1],
+        hour=10,
+        minute=0,
+        timezone="Europe/Paris",
+        closed_days=closed,
+        capacity=capacity,
+    )
+
+    # Protocol order is kept, and offset 2 still derives from first_day.
+    assert [visit["offset_months"] for visit in visits] == [2, 0, 1]
+    assert [visit["local"] for visit in visits] == [
+        "2024-03-31T10:00:00+02:00",
+        "2024-02-29T10:00:00+01:00",
+        "2024-02-29T10:00:00+01:00",
+    ]
+    assert capacity == {date(2024, 2, 29): 2, date(2024, 3, 1): 0}
+
+
+def test_full_day_moves_forward_and_keeps_the_wall_time_across_dst():
+    visits = plan_visits(
+        first_day=date(2024, 3, 9),
+        offsets_months=[0, 8],
+        hour=1,
+        minute=30,
+        timezone="America/New_York",
+        capacity={date(2024, 3, 9): 0, date(2024, 11, 9): 1},
+    )
+
+    assert visits == [
+        {
+            "offset_months": 0,
+            "local": "2024-03-10T01:30:00-05:00",
+            "utc": "2024-03-10T06:30:00Z",
+        },
+        {
+            "offset_months": 8,
+            "local": "2024-11-09T01:30:00-05:00",
+            "utc": "2024-11-09T06:30:00Z",
+        },
+    ]
+
+
+def test_non_leap_year_month_end_clamps_to_february_28():
+    visits = plan_visits(
+        first_day=date(2023, 1, 31),
+        offsets_months=[1, 2, 13],
+        hour=8,
+        minute=0,
+        timezone="Europe/Paris",
+    )
+
+    assert [visit["local"][:10] for visit in visits] == [
+        "2023-02-28",
+        "2023-03-31",
+        "2024-02-29",
+    ]
