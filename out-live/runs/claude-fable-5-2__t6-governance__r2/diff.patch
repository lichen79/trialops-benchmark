+@pytest.mark.parametrize("mutate", PLAN_MUTATIONS, ids=lambda fn: fn.__name__)
+def test_approve_and_execute_require_the_exact_privacy_plan(mutate):
+    submitted = request("submitted")
+    mutate(submitted)
+    snapshot = deepcopy(submitted)
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(submitted, "approve", "bob", NOW)
+    assert str(caught.value) == "PSEUDONYMIZATION_REQUIRED"
+    assert submitted == snapshot
+
+    approved = request("approved", approval_expires_on="2025-02-01")
+    mutate(approved)
+    snapshot = deepcopy(approved)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    assert str(caught.value) == "PSEUDONYMIZATION_REQUIRED"
+    assert calls == []
+    assert approved == snapshot
+
