+def test_failed_actions_are_atomic(candidate, action, actor, error, code):
+    candidate["history"].append(
+        {"action": "imported", "actor": "system", "at": "2024-12-01T00:00:00Z"}
+    )
+    snapshot = deepcopy(candidate)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {}
+
+    with pytest.raises(error, match=code):
+        apply_reuse_action(candidate, action, actor, NOW, executor)
+    assert candidate == snapshot
+    assert calls == []
