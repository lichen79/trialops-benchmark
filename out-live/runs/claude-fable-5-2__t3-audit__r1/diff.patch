+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore an independent chain from a snapshot and its trusted anchors.
+
+        Both anchors are mandatory: ``verify`` treats ``None`` as "not
+        supplied", so an explicit ``None`` is reported here as a mismatch
+        instead of silently skipping the anchored check.
+        """
+
+        errors: set[str] = set()
+        try:
+            # Materialize exactly once so one-shot iterables are verified and
+            # restored from the same snapshot.
+            snapshot = list(records)
+        except (TypeError, ValueError):
+            snapshot = []
+            errors.add("MALFORMED_RECORD")
+        else:
+            errors.update(
+                cls.verify(
+                    snapshot,
+                    expected_head=expected_head,
+                    expected_length=expected_length,
+                )
+            )
+        if expected_head is None:
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = (
+            chain.records[-1]["hash"] if chain.records else GENESIS_HASH
+        )
+        return chain
+
