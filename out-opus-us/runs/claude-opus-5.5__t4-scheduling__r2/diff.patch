@@ -0,0 +1,139 @@
+import copy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import book_subject_visits
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3]},
+        "exclusions": ["PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-01-02"}],
+        "labs": {"A": 2},
+        "flags": [],
+    }
+
+
+def book(capacity, **overrides):
+    kwargs = dict(
+        on=date(2024, 1, 10),
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+    kwargs.update(overrides)
+    subject = kwargs.pop("subject", make_subject())
+    protocol = kwargs.pop("protocol", make_protocol())
+    return book_subject_visits(subject, protocol, **kwargs)
+
+
+def test_sequential_slot_contention_commits_between_calls():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 1}
+
+    first = book(capacity)
+    assert [v["local"][:10] for v in first] == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+    second = book(capacity)
+    assert [v["local"][:10] for v in second] == ["2024-02-01", "2024-03-01"]
+    # Unlisted dates are unconstrained and never inserted.
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+
+def test_multiple_visits_in_one_plan_share_a_slot():
+    capacity = {date(2024, 2, 29): 2}
+    closed = {date(2024, 1, 31)} | {date(2024, 2, d) for d in range(1, 29)}
+    visits = book(capacity, closed_days=closed)
+    assert [v["local"][:10] for v in visits] == ["2024-02-29", "2024-02-29"]
+    assert capacity == {date(2024, 2, 29): 0}
+
+
+def test_later_visit_failure_rolls_back_all_capacity():
+    capacity = {date(2024, 1, 31): 1, date(2024, 3, 1): 4}
+    snapshot = dict(capacity)
+    closed = {date(2024, 2, 29) + timedelta(days=d) for d in range(367)}
+    closed_snapshot = set(closed)
+
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(capacity, closed_days=closed)
+    assert capacity == snapshot
+    assert closed == closed_snapshot
+
+
+def test_invalid_input_leaves_capacity_unchanged_after_prior_success():
+    capacity = {date(2024, 1, 31): 2}
+    book(capacity, offsets_months=[0])
+    assert capacity == {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError):
+        book(capacity, offsets_months=[0, 0])
+    with pytest.raises(ValueError):
+        book(capacity, timezone="Not/A_Real_Zone")
+    assert capacity == {date(2024, 1, 31): 1}
+
+
+def test_ineligible_subject_is_rejected_without_changes():
+    subject = make_subject()
+    subject["flags"] = ["PRIOR"]
+    subject["labs"] = {"A": 9}
+    protocol = make_protocol()
+    subject_copy, protocol_copy = copy.deepcopy(subject), copy.deepcopy(protocol)
+    capacity = {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError) as excinfo:
+        book(capacity, subject=subject, protocol=protocol)
+    message = str(excinfo.value)
+    assert message.startswith("INELIGIBLE:")
+    assert message.index("EXCLUSION_PRIOR") < message.index("LAB_A_HIGH")
+    assert capacity == {date(2024, 1, 31): 1}
+    assert subject == subject_copy
+    assert protocol == protocol_copy
+
+
+def test_dst_and_month_end_behaviour_is_preserved():
+    capacity = {date(2024, 3, 10): 1}
+    visits = book(
+        capacity,
+        first_day=date(2024, 1, 10),
+        offsets_months=[2, 10],
+        hour=2,
+        minute=30,
+    )
+    assert visits == [
+        {"offset_months": 2, "local": "2024-03-10T03:30:00-04:00",
+         "utc": "2024-03-10T07:30:00Z"},
+        {"offset_months": 10, "local": "2024-11-10T02:30:00-05:00",
+         "utc": "2024-11-10T07:30:00Z"},
+    ]
+    assert capacity == {date(2024, 3, 10): 0}
+
+    paris = book({}, first_day=date(2024, 1, 31), offsets_months=[1, 2],
+                 hour=2, minute=30, timezone="Europe/Paris")
+    assert [v["local"] for v in paris] == [
+        "2024-02-29T02:30:00+01:00",
+        "2024-03-31T03:30:00+02:00",
+    ]
+
+
+def test_fall_back_capacity_moved_visit_keeps_wall_time_fold_zero():
+    capacity = {date(2024, 11, 2): 0}
+    [visit] = book(capacity, first_day=date(2024, 11, 2), offsets_months=[0],
+                   hour=1, minute=30)
+    assert visit["local"] == "2024-11-03T01:30:00-04:00"
+    assert visit["utc"] == "2024-11-03T05:30:00Z"
+    assert capacity == {date(2024, 11, 2): 0}
