+def book_subject_visits(
+    subject: Mapping[str, object],
+    protocol: Mapping[str, object],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: Mapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Eligibility-gated booking with caller-owned, persistent reservations.
+
+    Planning is fully delegated to :func:`plan_visits`, which never observes
+    this mapping. Capacity is therefore only decremented once a complete plan
+    exists, so any earlier failure leaves the reservation ledger untouched.
+    """
+
+    if not isinstance(capacity, Mapping):
+        raise TypeError("capacity must be a mapping of dates to slots")
+
+    result = evaluate_subject(subject, protocol, on)
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(result["reasons"]))
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Commit only on complete success, and only for dates already recorded.
+    # Unlisted dates stay unlisted and retain their unconstrained behaviour.
+    decrements: dict[date, int] = {}
+    for visit in visits:
+        visit_day = date.fromisoformat(visit["local"][:_ISO_DATE_PREFIX])
+        if visit_day in capacity:
+            decrements[visit_day] = decrements.get(visit_day, 0) + 1
+
+    # The planning copy already enforced the slot limits, so these writes can
+    # only fail for an exotic mapping. Restore the snapshot in that case so a
+    # caller-owned ledger is never left half-committed.
+    snapshot = {day: capacity[day] for day in decrements}
+    try:
+        for visit_day, count in decrements.items():
+            capacity[visit_day] = snapshot[visit_day] - count
+    except Exception:
+        for visit_day, slots in snapshot.items():
+            with suppress(Exception):
+                capacity[visit_day] = slots
+        raise
     return visits
 
 
