+def test_failed_execution_stays_approved_and_can_be_retried():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    approved_snapshot = deepcopy(approved)
+    attempts = []
+
+    def flaky_executor(approved_request):
+        attempts.append(approved_request)
+        if len(attempts) == 1:
+            approved_request["status"] = "executed"
+            approved_request["history"].append({"action": "fake"})
+            raise RuntimeError("synthetic transient failure")
+        return {"attempt": 2}
+
+    with pytest.raises(ValueError, match="EXECUTION_FAILED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, flaky_executor)
+
+    assert approved == approved_snapshot
+    assert approved["status"] == "approved"
+    assert approved["history"] == []
+    assert "execution_result" not in approved
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, flaky_executor)
+
+    assert executed["status"] == "executed"
+    assert executed["execution_result"] == {"attempt": 2}
+    assert len(attempts) == 2
+    assert [entry["action"] for entry in executed["history"]] == ["execute"]
+    assert approved == approved_snapshot
+
