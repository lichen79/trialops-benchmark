+def test_export_failures_roll_back_to_the_unchanged_approved_request(subjects, secret):
+    approved = make_request(
+        history=[
+            {"action": "submit", "actor": "alice", "at": "2024-12-30T09:00:00Z"},
+            {"action": "approve", "actor": "bob", "at": "2024-12-31T09:00:00Z"},
