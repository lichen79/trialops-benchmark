+def test_deadline_clock_starts_at_earliest_onset_not_followup_arrival():
+    # A follow-up reporting an earlier onset pulls the clock back...
+    [earlier] = triage_events(
+        [
+            event("A", onset="2024-06-10T00:00:00Z", seriousness="hospitalization"),
+            event("B", follow_up_of="A", onset="2024-06-08T12:00:00Z"),
+        ],
+        now=NOW,
+    )
+    assert earlier["onset"] == "2024-06-08T12:00:00Z"
+    assert earlier["report_by"] == "2024-06-23T12:00:00Z"
+
+    # ...while a later follow-up never extends it, even when it is the event
+    # that raises the seriousness.
+    [later] = triage_events(
+        [
+            event("A", onset="2024-06-10T00:00:00Z"),
+            event(
+                "B",
+                follow_up_of="A",
+                onset="2024-06-20T00:00:00Z",
+                seriousness="hospitalization",
+            ),
+        ],
+        now=NOW,
+    )
+    assert later["onset"] == "2024-06-10T00:00:00Z"
+    assert later["report_by"] == "2024-06-25T00:00:00Z"
