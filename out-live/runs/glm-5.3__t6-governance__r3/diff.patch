+def test_failed_execution_leaves_the_request_approved_and_history_intact():
+    approved = request(
+        "approved",
+        approval_expires_on="2025-02-01",
+        history=[
+            {"action": "submit", "actor": "alice", "at": "2025-01-01T12:00:00Z"},
+            {"action": "approve", "actor": "bob", "at": "2025-01-02T12:00:00Z"},
+        ],
+    )
+    snapshot = deepcopy(approved)
+    attempts = []
+
+    class SyntheticBackendError(Exception):
+        pass
+
+    def executor(approved_request):
+        attempts.append(approved_request["id"])
+        raise SyntheticBackendError("backend unavailable")
+
+    with pytest.raises(ValueError, match="EXECUTION_FAILED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, executor)
+
+    assert attempts == ["reuse-001"]
+    assert approved == snapshot
+    assert approved["status"] == "approved"
+    assert approved["history"] == snapshot["history"]
+    assert "execution_result" not in approved
+
+    # A later retry still sees an unchanged, approvable request.
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, successful_executor)
+    assert executed["status"] == "executed"
+    assert executed["history"][-1]["action"] == "execute"
+    assert len(executed["history"]) == 3
