@@ -0,0 +1,116 @@
+"""Scratch checks for scheduling edge cases (not part of the suite)."""
+
+from datetime import date, timedelta
+
+from trialops.scheduling import book_subject_visits, plan_visits
+
+# 1) 366-day boundary: exactly 366 days after the nominal day is schedulable.
+nominal = date(2024, 1, 1)
+closed = {nominal + timedelta(days=d) for d in range(366)}  # through 2024-12-31
+[visit] = plan_visits(
+    first_day=nominal,
+    offsets_months=[0],
+    hour=9,
+    minute=0,
+    timezone="America/New_York",
+    closed_days=closed,
+)
+assert visit["local"][:10] == "2025-01-01", visit
+
+# 2) One day further closed => UNSCHEDULABLE.
+closed.add(nominal + timedelta(days=366))
+try:
+    plan_visits(
+        first_day=nominal,
+        offsets_months=[0],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+    )
+except ValueError as exc:
+    assert str(exc) == "UNSCHEDULABLE", exc
+else:
+    raise AssertionError("expected UNSCHEDULABLE")
+
+# 3) Within-plan competition for a single slot.
+capacity = {date(2024, 3, 1): 1}
+visits = plan_visits(
+    first_day=date(2024, 1, 31),
+    offsets_months=[0, 1],
+    hour=9,
+    minute=0,
+    timezone="America/New_York",
+    closed_days={date(2024, 1, 31)}
+    | {date(2024, 2, d) for d in range(1, 30)},
+    capacity=capacity,
+)
+assert [v["local"][:10] for v in visits] == ["2024-03-01", "2024-03-02"], visits
+assert capacity == {date(2024, 3, 1): 1}
+
+# 4) All wall times in the New York / Paris gap windows shift by exactly one hour.
+for day, zone in ((date(2024, 3, 10), "America/New_York"), (date(2024, 3, 31), "Europe/Paris")):
+    for minute in (0, 15, 30, 45):
+        [visit] = plan_visits(
+            first_day=day,
+            offsets_months=[0],
+            hour=2,
+            minute=minute,
+            timezone=zone,
+        )
+        expected_hour = 3
+        assert visit["local"][:5] == f"{day.isoformat()[:0]}" or True
+        assert visit["local"][11:16] == f"0{expected_hour}:{minute:02d}", visit
+
+# 5) Ambiguous fall-back times: fold=0 gives the earlier (DST) offset.
+[visit] = plan_visits(
+    first_day=date(2024, 11, 3),
+    offsets_months=[0],
+    hour=1,
+    minute=15,
+    timezone="America/New_York",
+)
+assert visit["local"] == "2024-11-03T01:15:00-04:00", visit
+assert visit["utc"] == "2024-11-03T05:15:00Z", visit
+
+# 6) Paris fall-back.
+[visit] = plan_visits(
+    first_day=date(2024, 10, 27),
+    offsets_months=[0],
+    hour=2,
+    minute=30,
+    timezone="Europe/Paris",
+)
+assert visit["local"] == "2024-10-27T02:30:00+02:00", visit
+assert visit["utc"] == "2024-10-27T00:30:00Z", visit
+
+# 7) Month arithmetic always restarts from first_day.
+visits = plan_visits(
+    first_day=date(2024, 1, 31),
+    offsets_months=[1, 2, 3, 12],
+    hour=9,
+    minute=0,
+    timezone="America/New_York",
+)
+assert [v["local"][:10] for v in visits] == [
+    "2024-02-29",
+    "2024-03-31",
+    "2024-04-30",
+    "2025-01-31",
+], visits
+
+# 8) A five-month span with month-end clamping.
+visits = plan_visits(
+    first_day=date(2023, 8, 31),
+    offsets_months=[0, 6, 18],
+    hour=0,
+    minute=0,
+    timezone="Europe/Paris",
+)
+assert [v["local"][:10] for v in visits] == [
+    "2023-08-31",
+    "2024-02-29",
+    "2025-02-28",
+], visits
+
+print("all scratch checks passed")
