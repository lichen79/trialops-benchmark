diff -ruN -x __pycache__ -x .pytest_cache a/tests/test_booking.py b/tests/test_booking.py
--- a/tests/test_booking.py	1970-01-01 01:00:00
+++ b/tests/test_booking.py	2026-11-13 20:37:26
@@ -0,0 +1,132 @@
+import copy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import book_subject_visits
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3]},
+        "exclusions": ["PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-01-02"}],
+        "labs": {"A": 2},
+        "flags": [],
+    }
+
+
+def book(capacity, **overrides):
+    kwargs = dict(
+        on=date(2024, 1, 15),
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+    kwargs.update(overrides)
+    subject = kwargs.pop("subject", make_subject())
+    protocol = kwargs.pop("protocol", make_protocol())
+    return book_subject_visits(subject, protocol, **kwargs)
+
+
+def test_sequential_slot_contention_commits_between_calls():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 2}
+
+    first = book(capacity)
+    assert [v["local"][:10] for v in first] == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 1}
+
+    second = book(capacity)
+    assert [v["local"][:10] for v in second] == ["2024-02-01", "2024-02-29"]
+    # Unlisted dates are never inserted.
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+
+def test_within_plan_competition_for_one_slot():
+    capacity = {date(2024, 2, 29): 1}
+    visits = book(capacity, first_day=date(2024, 2, 29), offsets_months=[0, 12])
+    assert [v["local"][:10] for v in visits] == ["2024-02-29", "2025-02-28"]
+    assert capacity == {date(2024, 2, 29): 0}
+
+
+def test_later_visit_failure_rolls_back_all_reservations():
+    capacity = {date(2024, 1, 31): 1}
+    closed = {date(2024, 2, 29) + timedelta(days=d) for d in range(367)}
+    closed_copy = set(closed)
+
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(capacity, closed_days=closed)
+    assert capacity == {date(2024, 1, 31): 1}
+    assert closed == closed_copy
+
+
+def test_invalid_input_leaves_capacity_unchanged():
+    capacity = {date(2024, 1, 31): 1}
+    with pytest.raises(ValueError):
+        book(capacity, timezone="Not/A_Real_Zone")
+    assert capacity == {date(2024, 1, 31): 1}
+
+
+def test_ineligible_subject_raises_with_ordered_reasons():
+    capacity = {date(2024, 1, 31): 1}
+    subject = make_subject()
+    subject["flags"] = ["PRIOR"]
+    subject["labs"] = {"A": 5}
+    protocol = make_protocol()
+    subject_copy, protocol_copy = copy.deepcopy(subject), copy.deepcopy(protocol)
+
+    with pytest.raises(ValueError) as excinfo:
+        book(capacity, subject=subject, protocol=protocol)
+    message = str(excinfo.value)
+    assert message.startswith("INELIGIBLE:")
+    assert message.index("EXCLUSION_PRIOR") < message.index("LAB_A_HIGH")
+    assert capacity == {date(2024, 1, 31): 1}
+    assert subject == subject_copy and protocol == protocol_copy
+
+
+def test_dst_and_month_end_behaviour_preserved():
+    capacity = {date(2024, 3, 10): 1}
+    visits = book(
+        capacity,
+        first_day=date(2024, 1, 10),
+        offsets_months=[2],
+        hour=2,
+        minute=30,
+    )
+    assert visits == [
+        {
+            "offset_months": 2,
+            "local": "2024-03-10T03:30:00-04:00",
+            "utc": "2024-03-10T07:30:00Z",
+        }
+    ]
+    assert capacity == {date(2024, 3, 10): 0}
+
+    capacity = {}
+    paris = book(
+        capacity,
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1, 2],
+        timezone="Europe/Paris",
+        hour=2,
+        minute=30,
+    )
+    assert [v["local"] for v in paris] == [
+        "2024-01-31T02:30:00+01:00",
+        "2024-02-29T02:30:00+01:00",
+        "2024-03-31T03:30:00+02:00",
+    ]
+    assert capacity == {}
diff -ruN -x __pycache__ -x .pytest_cache a/trialops/scheduling.py b/trialops/scheduling.py
--- a/trialops/scheduling.py	2026-11-13 20:17:29
+++ b/trialops/scheduling.py	2026-11-13 20:37:11
@@ -147,3 +147,55 @@
     return visits
 
 
+def book_subject_visits(
+    subject: Mapping[str, object],
+    protocol: Mapping[str, object],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Check eligibility, plan visits, then commit reservations atomically.
+
+    ``capacity`` is caller-owned and only modified after a complete, successful
+    plan: each listed date used by a returned visit is decremented once per
+    visit. Unlisted dates are unconstrained and never inserted. Any failure
+    leaves ``capacity`` exactly unchanged.
+    """
+    from trialops.eligibility import evaluate_subject
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to slots")
+
+    result = evaluate_subject(subject, protocol, on)
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(result["reasons"]))
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Compute every new value before touching the caller's mapping.
+    updates: dict[date, int] = {}
+    for visit in visits:
+        visit_day = date.fromisoformat(str(visit["local"])[:10])
+        if visit_day in capacity:
+            current = updates.get(visit_day, capacity[visit_day])
+            if current <= 0:
+                raise ValueError("UNSCHEDULABLE")
+            updates[visit_day] = current - 1
+    capacity.update(updates)
+    return visits
+
+
