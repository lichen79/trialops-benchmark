+def book_subject_visits(
+    subject,
+    protocol,
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate eligibility, then atomically reserve a complete visit plan."""
+    eligibility = evaluate_subject(subject, protocol, on)
+    if not eligibility["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(eligibility["reasons"]))
+
+    # Planning uses a private capacity snapshot. Caller-owned reservations are
+    # changed only after every visit has been generated successfully.
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+    for visit in visits:
+        visit_day = date.fromisoformat(visit["local"][:10])
+        if visit_day in capacity:
+            capacity[visit_day] -= 1
     return visits
 
 
