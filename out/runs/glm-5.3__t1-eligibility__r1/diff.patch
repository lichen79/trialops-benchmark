+def test_leap_day_birthday_age_boundaries_in_non_leap_and_leap_years():
+    subject = make_subject()
+    subject.update(
+        birth_date="2000-02-29",
+        consents=[{"version": "v2", "signed_on": "2019-01-01"}],
+        labs={},
+    )
+
+    def protocol_at(age):
+        protocol = make_protocol()
+        protocol.update(
+            min_age=age,
+            max_age=age,
+            consent_valid_from="2019-01-01",
+            labs={},
+            exclusions=[],
+        )
+        return protocol
+
+    # In a non-leap year the anniversary is 03-01, so 02-28 is still 22.
+    assert evaluate_subject(subject, protocol_at(23), date(2023, 2, 28))[
+        "reasons"
+    ] == ["AGE_BELOW_MIN"]
+    assert evaluate_subject(subject, protocol_at(23), date(2023, 3, 1))["reasons"] == []
+    # In a leap year 02-29 is the anniversary, so 02-28 is still 23.
+    assert evaluate_subject(subject, protocol_at(24), date(2024, 2, 28))[
+        "reasons"
+    ] == ["AGE_BELOW_MIN"]
+    assert evaluate_subject(subject, protocol_at(24), date(2024, 2, 29))["reasons"] == []
+
+
+def test_age_is_exactly_computed_at_day_resolution():
+    protocol = make_protocol()
+    protocol.update(min_age=24, max_age=24, labs={}, exclusions=[])
+    subject = make_subject()
+    subject.update(
+        birth_date="2000-06-15",
+        consents=[{"version": "v2", "signed_on": "2024-01-01"}],
+        labs={},
+    )
+
+    day_before = evaluate_subject(subject, protocol, date(2024, 6, 14))
+    on_birthday = evaluate_subject(subject, protocol, date(2024, 6, 15))
+    day_after = evaluate_subject(subject, protocol, date(2024, 6, 16))
+
+    assert day_before["reasons"] == ["AGE_BELOW_MIN"]
+    assert on_birthday["reasons"] == []
+    assert day_after["reasons"] == []
+
+
+def test_consent_selected_is_latest_signed_on_or_before_on():
+    protocol = make_protocol()
+    subject = make_subject()
+    subject["consents"] = [
+        {"version": "v2", "signed_on": "2024-01-01"},
+        {"version": "v1", "signed_on": "2024-03-01"},
+    ]
+
+    # The older, correct consent is never used once a newer one exists.
+    result = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert result == {
+        "eligible": False,
+        "reasons": ["CONSENT_VERSION"],
+        "consent_version": "v1",
+    }
+
+
+def test_consent_signed_after_on_is_not_selected():
+    subject = make_subject()
+    subject["consents"] = [
+        {"version": "v2", "signed_on": "2024-06-16"},
+        {"version": "v1", "signed_on": "2024-06-15"},
+    ]
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["consent_version"] == "v1"
+    assert result["reasons"] == ["CONSENT_VERSION"]
+
