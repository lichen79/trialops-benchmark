--- a/trialops/audit.py	2026-11-13 20:17:29
+++ b/trialops/audit.py	2026-11-14 11:18:03
@@ -82,6 +82,50 @@
         self.records: list[dict[str, Any]] = []
         self._event_ids: set[str] = set()
 
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a chain from a persisted snapshot anchored by a trusted head/length.
+
+        Raises ValueError("INVALID_CHAIN:<sorted,codes>") if verification fails.
+        """
+
+        try:
+            materialized = list(records)
+        except Exception:
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+        try:
+            # Copy first and verify the copy, so the stored data is exactly
+            # what was verified and is independent of the caller's objects.
+            copied = deepcopy(materialized)
+        except Exception:
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                copied,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # verify() treats None as "not supplied"; restoring requires both anchors.
+        if expected_head is None:
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = copied
+        chain._event_ids = {record["event_id"] for record in copied}
+        chain.previous_hash = copied[-1]["hash"] if copied else GENESIS_HASH
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
