     assert result["reasons"] == ["CONSENT_VERSION"]
 
 
+def test_consent_signed_exactly_on_valid_from_is_accepted():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-01-01"}]
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 1, 1))
+
+    assert result == {"eligible": True, "reasons": [], "consent_version": "v2"}
+
+
+def test_consent_signed_after_evaluation_date_is_not_selected():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-06-16"}]
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result == {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": None,
+    }
+
+
+def test_wrong_version_alone_returns_the_selected_version():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v9", "signed_on": "2024-06-15"}]
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result == {
+        "eligible": False,
+        "reasons": ["CONSENT_VERSION"],
+        "consent_version": "v9",
+    }
+
+
+def test_age_boundaries_are_inclusive_one_day_outside_fails():
+    protocol = make_protocol()
+    protocol.update(min_age=24, max_age=24, labs={}, exclusions=[])
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-01-01"}]
+
+    at_min_and_max = evaluate_subject(subject, protocol, date(2024, 6, 15))
+    below_min = evaluate_subject(subject, protocol, date(2024, 6, 14))
+    above_max = evaluate_subject(subject, protocol, date(2025, 6, 16))
+
+    assert at_min_and_max == {"eligible": True, "reasons": [], "consent_version": "v2"}
+    assert below_min["reasons"] == ["AGE_BELOW_MIN"]
+    assert above_max["reasons"] == ["AGE_ABOVE_MAX"]
+
+
+def test_lab_boundaries_are_inclusive_and_reasons_sort_by_lab_name():
+    protocol = make_protocol()
+    subject = make_subject()
+    subject["labs"] = {"A": 3, "Z": 10}
+
+    at_low_and_high = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    subject["labs"] = {"A": 3.5, "Z": 9}
+    just_outside = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert at_low_and_high == {"eligible": True, "reasons": [], "consent_version": "v2"}
+    assert just_outside["reasons"] == ["LAB_A_HIGH", "LAB_Z_LOW"]
+
+
+def test_exclusions_match_by_exact_flag_name_only():
+    protocol = make_protocol()
+    protocol.update(labs={})
+    subject = make_subject()
+    subject.update(flags=["prior", "PRIOR ", "DO_NOT_ENROLLX"], labs={})
+
+    result = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert result == {"eligible": True, "reasons": [], "consent_version": "v2"}
+
+
