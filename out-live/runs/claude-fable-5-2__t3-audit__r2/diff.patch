+++ b/trialops/audit.py	2026-11-14 11:21:33
@@ -82,6 +82,53 @@
         self.records: list[dict[str, Any]] = []
         self._event_ids: set[str] = set()
 
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot that matches a trusted head and length.
+
+        Raises ``ValueError("INVALID_CHAIN:<codes>")`` with the sorted,
+        comma-joined verification error codes when the snapshot is rejected.
+        """
+
+        try:
+            snapshot = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                snapshot,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # ``verify`` treats None as "anchor not supplied"; a restore always
+        # needs both anchors, so None must never skip a check here.
+        if expected_head is None:
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        try:
+            restored = deepcopy(snapshot)
+        except RecursionError:
+            # Serializable but too deeply nested to copy; ``append`` rejects
+            # such payloads as well.
+            raise ValueError("INVALID_CHAIN:BAD_PAYLOAD") from None
+
+        chain = cls()
+        chain.records = restored
+        chain._event_ids = {record["event_id"] for record in restored}
+        chain.previous_hash = restored[-1]["hash"] if restored else GENESIS_HASH
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
