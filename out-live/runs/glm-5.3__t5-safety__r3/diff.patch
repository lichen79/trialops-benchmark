+def test_overdue_boundary_is_strict_and_offset_aware():
+    events = [event("E1", onset="2024-01-01T00:00:00Z", seriousness="other")]
+    report_by = datetime(2024, 1, 31, tzinfo=timezone.utc)
+
+    assert triage_events(events, now=aware(2024, 1, 1))[0]["report_by"] == (
+        "2024-01-31T00:00:00Z"
+    )
+    # Equality is never overdue, in any timezone.
+    assert triage_events(events, now=report_by)[0]["overdue"] is False
+    assert triage_events(
+        events, now=datetime(2024, 1, 31, 5, tzinfo=timezone(timedelta(hours=5)))
+    )[0]["overdue"] is False
+    # One instant after the deadline is overdue, in any timezone.
+    assert (
+        triage_events(events, now=report_by + timedelta(microseconds=1))[0]["overdue"]
+        is True
+    )
+    assert triage_events(
+        events,
+        now=datetime(
+            2024, 1, 30, 19, 0, 0, 1, tzinfo=timezone(timedelta(hours=-5))
+        ),
+    )[0]["overdue"] is True
+
