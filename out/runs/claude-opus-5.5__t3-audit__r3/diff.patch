+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a chain from a persisted snapshot anchored by trusted values.
+
+        Raises ValueError("INVALID_CHAIN:<codes>") when verification fails.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+        try:
+            snapshot = deepcopy(materialized)
+        except Exception:
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                snapshot,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # The trusted anchors are mandatory; None (or other invalid values)
+        # would otherwise silently skip the trusted checks in verify().
+        if not _valid_hash(expected_head):
+            errors.add("HEAD_MISMATCH")
+        if type(expected_length) is not int or expected_length < 0:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = snapshot
+        chain._event_ids = {record["event_id"] for record in snapshot}
+        chain.previous_hash = snapshot[-1]["hash"] if snapshot else GENESIS_HASH
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
