+def _without(mapping, key):
+    return {name: value for name, value in mapping.items() if name != key}
+
+
+_EXACT_PLAN = request()["privacy_plan"]
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"privacy_plan": True},
+        {"privacy_plan": None},
+        {"privacy_plan": {**_EXACT_PLAN, "domain": "another purpose"}},
+        {"privacy_plan": {**_EXACT_PLAN, "fields": _EXACT_PLAN["fields"][::-1]}},
+        {"privacy_plan": {**_EXACT_PLAN, "fields": tuple(_EXACT_PLAN["fields"])}},
+        {"privacy_plan": {**_EXACT_PLAN, "fields": _EXACT_PLAN["fields"] + ["email"]}},
+        {"privacy_plan": {**_EXACT_PLAN, "salt": "extra"}},
+        {"privacy_plan": _without(_EXACT_PLAN, "domain")},
+    ],
+)
+def test_privacy_plan_must_match_exactly_for_approval_and_execution(changes):
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {}
+
+    # A legacy boolean never substitutes for the exact plan.
+    submitted = request("submitted", pseudonymized=True, **changes)
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(submitted, "approve", "bob", NOW)
+
+    approved = request(
+        "approved", pseudonymized=True, approval_expires_on="2025-02-01", **changes
+    )
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    assert calls == []
+
+
+def test_legacy_boolean_without_a_privacy_plan_is_not_enough():
+    submitted = _without(request("submitted", pseudonymized=True), "privacy_plan")
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(submitted, "approve", "bob", NOW)
+
+
+def test_execution_rechecks_metadata_and_retention_before_calling_executor():
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {}
+
+    not_representative = request("approved", approval_expires_on="2025-02-01")
+    not_representative["metadata"]["representative"] = False
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(not_representative, "execute", "alice", NOW, executor)
+
+    no_score = request("approved", approval_expires_on="2025-02-01")
+    del no_score["metadata"]["quality_score"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(no_score, "execute", "alice", NOW, executor)
+
+    retention_lapsed = request(
+        "approved", approval_expires_on="2025-02-01", retention_until="2024-12-31"
+    )
+    with pytest.raises(ValueError, match="RETENTION_EXPIRED"):
+        apply_reuse_action(retention_lapsed, "execute", "alice", NOW, executor)
+
+    assert calls == []
+
+
+def test_repeated_execution_is_invalid_state_without_another_executor_call():
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"receipt": len(calls)}
+
+    approved = request("approved", approval_expires_on="2025-02-01")
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    assert executed["execution_result"] == {"receipt": 1}
+    snapshot = deepcopy(executed)
+
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(
+            executed, "execute", "alice", NOW + timedelta(minutes=1), executor
+        )
+    assert len(calls) == 1
+    assert executed == snapshot
+
+
+def test_executor_gets_an_isolated_approved_copy_and_result_is_detached():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    seen = []
+    returned = {"rows": [1, 2, 3]}
+
+    def executor(approved_request):
+        seen.append(approved_request)
+        return returned
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+
+    assert seen[0] is not approved
+    assert seen[0] == approved
+    assert seen[0]["history"] == []
+    returned["rows"].append(4)
+    seen[0]["history"].append({"action": "fake"})
+    assert executed["execution_result"] == {"rows": [1, 2, 3]}
+    assert executed["history"] == [
+        {"action": "execute", "actor": "alice", "at": "2025-01-01T12:00:00Z"}
+    ]
+
