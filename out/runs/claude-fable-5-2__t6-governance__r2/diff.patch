+def test_separation_of_duties_holds_for_every_role_bound_action():
+    # A reviewer who is also the requester can never approve their own request,
+    # and nobody but the named reviewer/requester can act in that role.
+    self_review = request("submitted", reviewer="alice")
+    assert_rejected_atomically(self_review, "approve", "alice", "SELF_REVIEW")
+
+    for status, action, actor in [
+        ("draft", "submit", "bob"),
+        ("draft", "submit", "mallory"),
+        ("submitted", "approve", "alice"),
+        ("submitted", "approve", "mallory"),
+        ("submitted", "reject", "alice"),
+        ("approved", "execute", "bob"),
+        ("approved", "execute", "mallory"),
+    ]:
+        candidate = request(status, approval_expires_on="2025-02-01")
+        snapshot = deepcopy(candidate)
+        calls = []
+        with pytest.raises(PermissionError):
+            apply_reuse_action(
+                candidate, action, actor, NOW, recording_executor(calls)
+            )
+        assert calls == []
+        assert candidate == snapshot
+
