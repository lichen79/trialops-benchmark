+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request against its purpose-scoped export."""
+
+    def executor(approved_request: dict[str, Any]) -> dict[str, Any]:
+        # Governance validates the timestamp before invoking this executor.
+        on = now.astimezone(timezone.utc).date()
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=on,
+        )
+
+    return apply_reuse_action(
+        request,
+        "execute",
+        actor,
+        now,
+        executor=executor,
+    )
 
 
