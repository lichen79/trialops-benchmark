+def _utc_now(now: Any) -> datetime:
+    if not isinstance(now, datetime):
+        raise ValueError("INVALID_NOW")
+    try:
+        if now.tzinfo is None or now.utcoffset() is None:
+            raise ValueError("INVALID_NOW")
+        return now.astimezone(timezone.utc)
+    except (OverflowError, ValueError) as exc:
+        raise ValueError("INVALID_NOW") from exc
+
+
+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Run one governed, pseudonymized export of the approved reuse request.
+
+    Governance is the single gate: the subject records are only read once the
+    approved snapshot has passed every governance check, so rejected, expired,
+    or already executed requests never consume them.  Export failures surface
+    as the governance ``EXECUTION_FAILED`` error and leave the approved request
+    and its history untouched.
+    """
+
+    if not isinstance(request, dict):
+        raise TypeError("request must be a dict")
+    now_utc = _utc_now(now)
+    on = now_utc.date()
+
+    def _execute(approved: dict[str, object]) -> dict[str, Any]:
+        purpose = approved.get("purpose")
+        if not isinstance(purpose, str) or not purpose.strip():
+            raise ValueError("approved request must state a non-empty purpose")
+        try:
+            # Snapshot the caller's records so the export cannot observe or
+            # mutate them, and so a repeated execution never re-reads them.
+            snapshot = copy.deepcopy(list(subjects))
+        except Exception:
+            raise ValueError("INVALID_SUBJECTS") from None
+        return export_subjects(snapshot, purpose=purpose, secret=secret, on=on)
+
+    return apply_reuse_action(request, "execute", actor, now, executor=_execute)
