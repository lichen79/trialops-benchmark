+def test_execution_rechecks_separation_privacy_metadata_and_retention():
+    base = dict(approval_expires_on="2025-02-01")
+    calls = []
+
+    def executor(approved_request):
+        calls.append(1)
+        return {}
+
+    with pytest.raises(ValueError, match="SELF_REVIEW"):
+        apply_reuse_action(
+            request("approved", reviewer="alice", **base), "execute", "alice", NOW, executor
+        )
+
+    legacy = request("approved", **base)
+    del legacy["privacy_plan"]
+    legacy["pseudonymized"] = True
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(legacy, "execute", "alice", NOW, executor)
+
+    wrong_domain = request("approved", **base)
+    wrong_domain["privacy_plan"]["domain"] = "other purpose"
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(wrong_domain, "execute", "alice", NOW, executor)
+
+    extra_field = request("approved", **base)
+    extra_field["privacy_plan"]["fields"].append("email")
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(extra_field, "execute", "alice", NOW, executor)
+
+    missing_metadata = request("approved", **base)
+    del missing_metadata["metadata"]["representative"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(missing_metadata, "execute", "alice", NOW, executor)
+
+    no_metadata = request("approved", **base)
+    del no_metadata["metadata"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(no_metadata, "execute", "alice", NOW, executor)
+
+    retention = request("approved", retention_until="2024-12-31", **base)
+    with pytest.raises(ValueError, match="RETENTION_EXPIRED"):
+        apply_reuse_action(retention, "execute", "alice", NOW, executor)
+
+    assert calls == []
+
+
+def test_missing_metadata_and_boolean_pseudonymization_block_approval():
+    legacy = request("submitted")
+    del legacy["privacy_plan"]
+    legacy["pseudonymized"] = True
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(legacy, "approve", "bob", NOW)
+
+    for key in ("representative", "complete", "quality_score"):
+        candidate = request("submitted")
+        del candidate["metadata"][key]
+        snapshot = deepcopy(candidate)
+        with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+            apply_reuse_action(candidate, "approve", "bob", NOW)
+        assert candidate == snapshot
+
+    boolean_score = request("submitted")
+    boolean_score["metadata"]["quality_score"] = True
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(boolean_score, "approve", "bob", NOW)
+
+
+def test_repeated_execution_is_invalid_state_without_executor_call():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    calls = []
+
+    def executor(approved_request):
+        calls.append(1)
+        return {"ok": True}
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    snapshot = deepcopy(executed)
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(executed, "execute", "alice", NOW, executor)
+    assert calls == [1]
+    assert executed == snapshot
+    assert len(executed["history"]) == 1
+
+
+def test_non_dict_executor_result_fails_without_reporting_executed():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    snapshot = deepcopy(approved)
+    with pytest.raises(ValueError, match="EXECUTION_FAILED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, lambda r: ["rows"])
+    assert approved == snapshot
+    with pytest.raises(ValueError, match="EXECUTOR_REQUIRED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, "not callable")
+
+
+def test_execution_result_is_isolated_from_executor():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    payload = {"rows": [1, 2]}
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, lambda r: payload)
+    payload["rows"].append(3)
+    assert executed["execution_result"] == {"rows": [1, 2]}
+
+
+def test_failed_actions_are_atomic_and_role_checks_precede_state():
+    submitted = request("submitted", retention_until="2024-12-31")
+    snapshot = deepcopy(submitted)
+    with pytest.raises(ValueError, match="RETENTION_EXPIRED"):
+        apply_reuse_action(submitted, "approve", "bob", NOW)
+    assert submitted == snapshot
+    assert "approval_expires_on" not in submitted
+
+    with pytest.raises(PermissionError):
+        apply_reuse_action(request("submitted"), "submit", "mallory", NOW)
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(request("draft"), "approve", "bob", NOW)
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(request("draft"), "expire", "system", NOW)
+
+
+def test_rejection_and_history_chronology_with_offset_timezone():
+    plus_two = timezone(timedelta(hours=2))
+    first = datetime(2025, 1, 1, 9, 30, tzinfo=plus_two)
+    submitted = apply_reuse_action(request(), "submit", "alice", first)
+    rejected = apply_reuse_action(
+        submitted, "reject", "bob", first + timedelta(hours=1, seconds=5)
+    )
+    assert rejected["status"] == "rejected"
+    assert rejected["history"] == [
+        {"action": "submit", "actor": "alice", "at": "2025-01-01T07:30:00Z"},
+        {"action": "reject", "actor": "bob", "at": "2025-01-01T08:30:05Z"},
+    ]
+    assert submitted["history"] == rejected["history"][:1]
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(rejected, "approve", "bob", first)
+
