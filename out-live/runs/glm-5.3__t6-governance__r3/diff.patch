+def test_history_chronology_and_utc_normalisation_across_the_workflow():
+    current = request(
+        history=[{"action": "imported", "actor": "system", "at": "2024-12-31T23:00:00Z"}]
+    )
+    snapshots = []
+
+    steps = [
+        (
+            "submit",
+            "alice",
+            datetime(2025, 1, 1, 7, 0, tzinfo=timezone(timedelta(hours=-5))),
+            "2025-01-01T12:00:00Z",
+        ),
+        (
+            "approve",
+            "bob",
+            datetime(2025, 1, 2, 18, 30, tzinfo=timezone(timedelta(hours=5, minutes=30))),
+            "2025-01-02T13:00:00Z",
+        ),
+        (
+            "execute",
+            "alice",
+            datetime(2025, 1, 3, 0, 0, tzinfo=timezone.utc),
+            "2025-01-03T00:00:00Z",
+        ),
+    ]
+
+    for action, actor, at, expected_at in steps:
+        snapshots.append(deepcopy(current))
+        current = apply_reuse_action(current, action, actor, at, successful_executor)
+        entry = current["history"][-1]
+        assert entry == {"action": action, "actor": actor, "at": expected_at}
+        # Earlier snapshots are never retroactively mutated.
+        assert current["history"][:-1] == snapshots[-1]["history"]
+
+    timestamps = [entry["at"] for entry in current["history"]]
+    assert timestamps == sorted(timestamps)
+    assert all(timestamp.endswith("Z") for timestamp in timestamps)
+    assert [entry["action"] for entry in current["history"]] == [
+        "imported",
+        "submit",
+        "approve",
+        "execute",
+    ]
+    assert current["approval_expires_on"] == "2025-02-01"
+
+    # An executed request is terminal: it can no longer be approved or expired.
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(
+            current, "expire", "audit-bot", datetime(2025, 3, 1, tzinfo=timezone.utc)
+        )
+
+    # Expiration keeps the same chronology for any actor.
+    still_approved = apply_reuse_action(request(), "submit", "alice", NOW)
+    still_approved = apply_reuse_action(still_approved, "approve", "bob", NOW)
+    expired = apply_reuse_action(
+        still_approved, "expire", "audit-bot", datetime(2025, 2, 2, tzinfo=timezone.utc)
+    )
+    assert expired["status"] == "expired"
+    assert expired["history"][-1] == {
+        "action": "expire",
+        "actor": "audit-bot",
+        "at": "2025-02-02T00:00:00Z",
+    }
+    assert expired["history"][:-1] == still_approved["history"]
+    timestamps = [entry["at"] for entry in expired["history"]]
+    assert timestamps == sorted(timestamps)
+
