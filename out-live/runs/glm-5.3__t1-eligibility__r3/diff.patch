+def test_missing_or_malformed_fields_raise_value_errors_naming_the_field(
+    subject_overrides, protocol_overrides, match
+):
+    subject = make_subject()
+    subject.update(subject_overrides)
+    protocol = make_protocol()
+    protocol.update(protocol_overrides)
+
+    with pytest.raises(ValueError, match=match):
+        evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+
+def test_non_mapping_inputs_and_non_date_on_raise_value_errors():
+    with pytest.raises(ValueError, match="subject"):
+        evaluate_subject(["not-a-mapping"], make_protocol(), date(2024, 6, 15))
+    with pytest.raises(ValueError, match="protocol"):
+        evaluate_subject(make_subject(), "not-a-mapping", date(2024, 6, 15))
+    with pytest.raises(ValueError, match="on must be a date"):
+        evaluate_subject(make_subject(), make_protocol(), datetime(2024, 6, 15))
