+def test_restore_and_continue_with_deep_copy_independence():
+    original = AuditChain()
+    append_event(original, payload={"nested": {"value": 1}})
+    append_event(original, "event-2", AT + timedelta(seconds=1))
+    snapshot = deepcopy(original.records)
+
+    restored = AuditChain.from_records(
+        (record for record in snapshot),
+        expected_head=original.head(),
+        expected_length=2,
+    )
+
+    assert restored.records == snapshot
+    assert restored.records is not snapshot
+    assert restored.records[0] is not snapshot[0]
+    snapshot[0]["payload"]["nested"]["value"] = 99
+    assert restored.records[0]["payload"]["nested"]["value"] == 1
+
+    continued = append_event(
+        restored,
+        "event-3",
+        AT + timedelta(seconds=2),
+        payload={"nested": {"value": 3}},
+    )
+    assert continued["sequence"] == 3
+    assert continued["previous_hash"] == original.head()
+    assert restored.head() == continued["hash"]
+    assert restored.verify(restored.records) == []
+
+    # A restored duplicate index rejects replays without changing the chain.
+    with pytest.raises(ValueError, match="unique"):
+        append_event(restored, "event-1", AT + timedelta(seconds=3))
+    assert len(restored.records) == 3
+
+
+def test_restore_rejects_wrong_anchors_and_truncated_suffixes():
+    chain = AuditChain()
+    append_event(chain)
+    append_event(chain, "event-2", AT + timedelta(seconds=1))
+
+    with pytest.raises(
+        ValueError,
+        match=r"^INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH$",
+    ):
+        AuditChain.from_records(
+            chain.records[:1], expected_head=chain.head(), expected_length=2
+        )
+
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH$"):
+        AuditChain.from_records(
+            chain.records, expected_head=GENESIS_HASH, expected_length=2
+        )
+
+    empty = AuditChain.from_records(
+        [], expected_head=GENESIS_HASH, expected_length=0
+    )
+    assert empty.head() == GENESIS_HASH
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:LENGTH_MISMATCH$"):
+        AuditChain.from_records([], expected_head=GENESIS_HASH, expected_length=1)
+
+
+def test_restored_instances_are_independent():
+    chain = AuditChain()
+    append_event(chain)
+    first = AuditChain.from_records(
+        chain.records, expected_head=chain.head(), expected_length=1
+    )
+    second = AuditChain.from_records(
+        chain.records, expected_head=chain.head(), expected_length=1
+    )
+
+    first_record = append_event(first, "first-next", AT + timedelta(seconds=1))
+    second_record = append_event(second, "second-next", AT + timedelta(seconds=1))
+    assert first_record["hash"] != second_record["hash"]
+    assert len(chain.records) == 1
+    assert len(second.records) == 2
+    assert second.records[0] is not first.records[0]
+
+
+def test_nan_payloads_and_stored_timestamp_representations_are_rejected():
+    with pytest.raises(ValueError, match="payload"):
+        append_event(AuditChain(), payload={"value": float("nan")})
+
+    chain = AuditChain()
+    append_event(chain)
+    malformed = deepcopy(chain.records)
+    malformed[0]["at"] = "2024-06-15T14:00:00+02:00"
+    assert chain.verify(malformed) == ["BAD_HASH", "MALFORMED_TIMESTAMP"]
+
