+@pytest.mark.parametrize(
+    ("seriousness", "report_by"),
+    [
+        ("fatal", "2024-01-08T00:00:00Z"),
+        ("life_threatening", "2024-01-08T00:00:00Z"),
+        ("hospitalization", "2024-01-16T00:00:00Z"),
+        ("other", "2024-01-31T00:00:00Z"),
+    ],
+)
+def test_reporting_offsets_use_earliest_onset(seriousness, report_by):
+    events = [
+        event(
+            "follow-up",
+            follow_up_of="root",
+            onset="2024-01-01T00:00:00Z",
+            seriousness=seriousness,
+        ),
+        event("root", onset="2024-01-20T00:00:00Z"),
+    ]
+
+    case = triage_events(
+        events, now=datetime(2025, 1, 1, tzinfo=timezone.utc)
+    )[0]
+    assert case["onset"] == "2024-01-01T00:00:00Z"
+    assert case["seriousness"] == seriousness
+    assert case["report_by"] == report_by
+    assert case["overdue"] is True
+
+
+@pytest.mark.parametrize(
+    ("levels", "expected"),
+    [
+        (("other", "hospitalization"), "hospitalization"),
+        (("hospitalization", "life_threatening"), "life_threatening"),
+        (("life_threatening", "fatal"), "fatal"),
+    ],
+)
+def test_seriousness_precedence_across_followups(levels, expected):
+    events = [
+        event("root", seriousness=levels[0]),
+        event("follow-up", follow_up_of="root", seriousness=levels[1]),
+    ]
+
+    assert triage_events(
+        events, now=datetime(2024, 1, 1, tzinfo=timezone.utc)
+    )[0]["seriousness"] == expected
+
+
+def test_input_order_does_not_change_output():
+    events = [
+        event("root", source="site-c"),
+        event(
+            "middle",
+            follow_up_of="root",
+            onset="2024-01-09T00:00:00Z",
+            source="site-a",
+            uncertain=True,
+        ),
+        event(
+            "leaf",
+            follow_up_of="middle",
+            onset="2024-01-11T00:00:00Z",
+            seriousness="life_threatening",
+            source="site-b",
+        ),
+    ]
+    now = datetime(2024, 1, 16, tzinfo=timezone.utc)
+    expected = triage_events(events, now=now)
+
+    for ordering in permutations(events):
+        assert triage_events(ordering, now=now) == expected
+
+
