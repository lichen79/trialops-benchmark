+def build_chain(count=3):
+    chain = AuditChain()
+    for index in range(count):
+        append_event(
+            chain,
+            f"event-{index + 1}",
+            AT + timedelta(seconds=index),
+            payload={"index": index, "nested": {"value": index}},
+        )
+    return chain
+
+
+def test_from_records_requires_both_trusted_anchors():
+    chain = build_chain(1)
+
+    with pytest.raises(TypeError):
+        AuditChain.from_records(chain.records, expected_length=1)
+    with pytest.raises(TypeError):
+        AuditChain.from_records(chain.records, expected_head=chain.head())
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:LENGTH_MISMATCH$"):
+        AuditChain.from_records(
+            chain.records, expected_head=chain.head(), expected_length=None
+        )
+
+
+def test_restore_and_continue_from_snapshot():
+    original = build_chain(3)
+    snapshot = deepcopy(original.records)
+    trusted_head = original.head()
+
+    restored = AuditChain.from_records(
+        snapshot, expected_head=trusted_head, expected_length=3
+    )
+
+    assert restored.records == snapshot
+    assert restored.head() == trusted_head
+    assert restored.previous_hash == trusted_head
+
+    continued = append_event(
+        restored, "event-4", AT + timedelta(seconds=3), payload={"index": 3}
+    )
+    replayed = append_event(
+        original, "event-4", AT + timedelta(seconds=3), payload={"index": 3}
+    )
+
+    assert continued["sequence"] == 4
+    assert continued["previous_hash"] == trusted_head
+    assert continued["hash"] == replayed["hash"]
+    assert restored.head() == continued["hash"]
+    assert restored.verify(restored.records) == []
+    assert restored.verify(
+        restored.records, expected_head=restored.head(), expected_length=4
+    ) == []
+
+
+def test_from_records_accepts_iterators_and_materializes_once():
+    original = build_chain(2)
+
+    restored = AuditChain.from_records(
+        iter(deepcopy(original.records)),
+        expected_head=original.head(),
+        expected_length=2,
+    )
+
+    assert len(restored.records) == 2
+    assert restored.head() == original.head()
+
