+def test_verify_does_not_normalize_stored_timestamps():
+    chain = AuditChain()
+    append_event(chain, "event-1", AT)
+
+    # A UTC offset form is a malformed stored timestamp, not a rewrite target.
+    variants = [
+        "2024-06-15T14:00:00+02:00",
+        "2024-06-15T12:00:00+00:00",
+        "2024-06-15T12:00:00.000Z",
+        "2024-06-15 12:00:00Z",
+        "2024-06-15T12:00:00z",
+    ]
+    for at in variants:
+        variant = deepcopy(chain.records)
+        variant[0]["at"] = at
+        errors = chain.verify(variant)
+        assert "MALFORMED_TIMESTAMP" in errors
+        assert "BAD_HASH" in errors
+        assert "NON_INCREASING_TIMESTAMP" not in errors
+
+    # Verification keeps comparing strictly increasing instants.
+    increasing = AuditChain()
+    append_event(increasing, "event-1", AT)
+    append_event(increasing, "event-2", AT + timedelta(seconds=1))
+    assert increasing.verify(increasing.records) == []
+
