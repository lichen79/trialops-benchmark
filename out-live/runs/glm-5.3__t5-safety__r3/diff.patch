+def test_duplicate_root_ids_are_rejected_whichever_position_they_arrive_in():
+    events = [
+        event("E1"),
+        event("E2", follow_up_of="E1", onset="2024-01-02T00:00:00Z", source="site-a"),
+        event("E1", onset="2024-02-01T00:00:00Z", source="site-c"),
+    ]
+    now = aware(2024, 1, 1)
+
+    for order in (events, list(reversed(events)), [events[1], events[0], events[2]]):
+        with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+            triage_events(order, now=now)
