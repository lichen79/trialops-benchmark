+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request by exporting ``subjects``.
+
+    Governance decides whether execution may happen at all; the export only
+    runs inside the governance executor, so a rejected request never consumes
+    ``subjects``. An export failure surfaces as ``EXECUTION_FAILED`` and leaves
+    the approved request untouched.
+    """
+
+    def executor(approved_request: dict[str, Any]) -> dict[str, Any]:
+        # Governance has already validated ``now`` as timezone-aware and the
+        # snapshot's purpose as a non-blank string before calling the executor.
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
