+def test_executor_receives_an_isolated_copy_of_the_approved_request():
+    approved = approved_request(history=[{"action": "imported", "tags": ["a"]}])
+    snapshot = deepcopy(approved)
+    executor = RecordingExecutor()
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+
+    assert len(executor.calls) == 1
+    seen = executor.calls[0]
+    assert seen == snapshot
+    assert seen is not approved
+    assert seen["metadata"] is not approved["metadata"]
+    assert seen["privacy_plan"] is not approved["privacy_plan"]
+    assert seen["history"] is not approved["history"]
+    assert seen is not executed
+    assert seen["history"] is not executed["history"]
+    assert approved == snapshot
+    assert executed["execution_result"] == {"receipt": "synthetic-execution-001"}
+    assert executed["history"] == snapshot["history"] + [
+        {"action": "execute", "actor": "alice", "at": "2025-01-01T12:00:00Z"}
+    ]
+
