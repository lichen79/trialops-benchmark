+def test_from_records_rejects_edits_even_when_rehashed():
+    original = build_chain(3)
+
+    # An un-rehashed edit is caught by the internal hash checks.
+    unrehased = deepcopy(original.records)
+    unrehased[1]["payload"]["nested"]["value"] = 42
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:BAD_HASH$"):
+        AuditChain.from_records(
+            unrehased, expected_head=original.head(), expected_length=3
+        )
+
+    # Rehashing the record restores self-consistency but breaks the head anchor.
+    rehashed = deepcopy(original.records)
+    rehashed[1]["payload"]["nested"]["value"] = 42
+    rehash(rehashed[1])
+    with pytest.raises(ValueError, match="INVALID_CHAIN"):
+        AuditChain.from_records(
+            rehashed, expected_head=original.head(), expected_length=3
+        )
+
+    # A fully rehashed suffix with correct sequence and linkage is only caught
+    # by the trusted head and length anchors.
+    fully_rehashed = deepcopy(original.records)
+    fully_rehashed[1]["payload"]["nested"]["value"] = 42
+    rehash(fully_rehashed[1])
+    fully_rehashed[2]["previous_hash"] = fully_rehashed[1]["hash"]
+    rehash(fully_rehashed[2])
+    assert original.verify(fully_rehashed) == []
+    with pytest.raises(
+        ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH$"
+    ):
+        AuditChain.from_records(
