+def test_now_in_another_offset_is_compared_as_an_instant():
+    tokyo = timezone(timedelta(hours=9))
+    events = [event("E1", seriousness="fatal")]  # report_by 2024-01-17T08:00:00Z
+
+    [on_time] = triage_events(events, now=datetime(2024, 1, 17, 17, 0, tzinfo=tokyo))
+    [late] = triage_events(events, now=datetime(2024, 1, 17, 17, 0, 1, tzinfo=tokyo))
+
+    assert on_time["report_by"] == "2024-01-17T08:00:00Z"
+    assert on_time["overdue"] is False
+    assert late["overdue"] is True
+
