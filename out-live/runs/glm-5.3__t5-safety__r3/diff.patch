+def test_self_links_and_cycles_with_tails_are_rejected_in_any_order():
+    now = aware(2024, 1, 1)
+    self_link = [event("A", follow_up_of="A")]
+    two_node = [event("A", follow_up_of="B"), event("B", follow_up_of="A")]
+    tailed = [
+        event("A", follow_up_of="B"),
+        event("B", follow_up_of="C"),
+        event("C", follow_up_of="B"),
+    ]
+
+    for events in (self_link, two_node, tailed):
+        for order in permutations(events):
+            with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+                triage_events(list(order), now=now)
+
