+def test_manifest_digest_uses_the_specified_canonical_form():
+    # A non-ASCII value keeps the two escaping modes distinguishable.
+    subject = make_subject(
+        "canonical-check", country="Ω-land", visits=["2024-01-01", "2023-12-31"]
+    )
+    result = export_subjects([subject], purpose="research", secret="test-secret", on=ON)
+    expected_rows = [
+        {
+            "pseudonym": pseudonym("canonical-check"),
+            "country": "Ω-land",
+            "birth_year": 1990,
+            "visits": ["2023-12-31", "2024-01-01"],
+        }
+    ]
+
+    exact = hashlib.sha256(
+        json.dumps(
+            expected_rows,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+        ).encode("utf-8")
+    ).hexdigest()
+    spaced = hashlib.sha256(
+        json.dumps(expected_rows, sort_keys=True).encode("utf-8")
+    ).hexdigest()
+    ascii_escaped = hashlib.sha256(
+        json.dumps(
+            expected_rows, sort_keys=True, separators=(",", ":"), ensure_ascii=True
+        ).encode("utf-8")
+    ).hexdigest()
+    unsorted_keys = hashlib.sha256(
+        json.dumps(
+            [dict(reversed(list(expected_rows[0].items())))],
+            separators=(",", ":"),
+            ensure_ascii=False,
+        ).encode("utf-8")
+    ).hexdigest()
+
+    assert result["manifest"] == {"algorithm": "sha256", "count": 1, "sha256": exact}
+    # The digest is the canonical compact, key-sorted, unescaped form.
+    assert result["manifest"]["sha256"] != spaced
+    assert result["manifest"]["sha256"] != ascii_escaped
+    assert result["manifest"]["sha256"] != unsorted_keys
+
