+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate eligibility and atomically reserve all visits for a subject."""
+    eligibility = evaluate_subject(subject, protocol, on)
+    if not eligibility["eligible"]:
+        reasons = ", ".join(eligibility["reasons"])
+        raise ValueError(f"INELIGIBLE: {reasons}")
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a caller-owned dictionary")
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Commit only after plan_visits has successfully built the entire plan.
+    # Dates absent from capacity remain unconstrained and must not be inserted.
+    reservations: dict[date, int] = {}
+    for visit in visits:
+        visit_day = date.fromisoformat(str(visit["local"])[:10])
+        if visit_day in capacity:
+            reservations[visit_day] = reservations.get(visit_day, 0) + 1
+    for visit_day, count in reservations.items():
+        capacity[visit_day] -= count
     return visits
 
 
