+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request by exporting its purpose-scoped rows.
+
+    All authorization, state, approval and policy checks are owned by
+    ``apply_reuse_action``; ``subjects`` is only touched by the executor, which
+    governance invokes after those checks pass. Any export failure surfaces as
+    governance's ``EXECUTION_FAILED`` and leaves ``request`` untouched.
+    """
+
+    def executor(approved: dict[str, Any]) -> dict[str, Any]:
+        # Governance has already validated ``now`` as timezone-aware before
+        # calling the executor, so this conversion yields the true UTC date.
+        return export_subjects(
+            subjects,
+            purpose=approved["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
 
