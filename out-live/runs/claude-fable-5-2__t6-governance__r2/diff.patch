+def _not_representative(value):
+    value["metadata"]["representative"] = False
+
+
+def _missing_quality_score(value):
+    del value["metadata"]["quality_score"]
+
+
+def _no_metadata(value):
+    del value["metadata"]
+
+
+def _retention_passed(value):
+    value["retention_until"] = "2024-12-31"
