+def test_missing_top_level_fields_raise_field_naming_value_errors():
+    on = date(2024, 6, 15)
+
+    for field in ("birth_date", "consents", "labs", "flags"):
+        subject = make_subject()
+        del subject[field]
+        with pytest.raises(ValueError, match=f"subject.{field}"):
+            evaluate_subject(subject, make_protocol(), on)
+
+    for field in (
+        "min_age",
+        "max_age",
+        "required_consent_version",
+        "consent_valid_from",
+        "labs",
+        "exclusions",
+    ):
+        protocol = make_protocol()
+        del protocol[field]
