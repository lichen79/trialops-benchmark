+@pytest.mark.parametrize(
+    ("mutate", "code"),
+    [
+        (_not_representative, "METADATA_REQUIRED"),
+        (_missing_quality_score, "METADATA_REQUIRED"),
+        (_no_metadata, "METADATA_REQUIRED"),
+        (_retention_passed, "RETENTION_EXPIRED"),
+    ],
+    ids=lambda value: getattr(value, "__name__", value),
