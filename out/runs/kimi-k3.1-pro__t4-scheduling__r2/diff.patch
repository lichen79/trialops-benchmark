+def book_subject_visits(
+    subject,
+    protocol,
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate a subject, then commit a complete protocol visit plan.
+
+    ``plan_visits`` owns candidate generation and validation. Capacity is
+    caller-owned persistent state, so its values are decremented only after
+    the entire plan has been generated successfully.
+    """
+    result = evaluate_subject(subject, protocol, on)
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE: " + ", ".join(result["reasons"]))
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to slots")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    reservations: dict[date, int] = {}
+    for visit in visits:
+        local = visit["local"]
+        assert isinstance(local, str)
+        visit_day = date.fromisoformat(local[:10])
+        if visit_day in capacity:
+            reservations[visit_day] = reservations.get(visit_day, 0) + 1
+
+    # Apply the already validated aggregate deltas only after every visit is
+    # planned. Unlisted dates deliberately remain absent from the mapping.
+    for visit_day, count in reservations.items():
+        capacity[visit_day] -= count
 
     return visits
 
