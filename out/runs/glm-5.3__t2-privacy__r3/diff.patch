+def execute_reuse_export(
+    request: Any,
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: object,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute one approved reuse request as a pseudonymized export.
+
+    The reuse request drives the export: the approved snapshot's purpose, the
+    supplied secret, and the UTC calendar date of ``now`` select the exported
+    rows. This function never mutates its inputs, never records the secret or
+    any direct subject identifier in the request or history it returns, and
+    fails before touching ``subjects`` whenever governance rejects the action.
+    """
+
+    if not isinstance(request, dict):
+        raise ValueError("NOT_A_REQUEST")
+    if isinstance(subjects, (str, bytes, Mapping)) or not isinstance(
+        subjects, Iterable
+    ):
+        raise ValueError("subjects must be an iterable of records")
+
+    def executor(approved_snapshot: Mapping[str, Any]) -> dict[str, Any]:
+        """Export exactly once from an approved, caller-owned snapshot."""
+
+        purpose = approved_snapshot.get("purpose") if isinstance(
+            approved_snapshot, Mapping
+        ) else None
+        export_on = now.astimezone(timezone.utc).date()
+        return export_subjects(
+            subjects,
+            purpose=purpose,
+            secret=secret,
+            on=export_on,
+        )
+
+    return apply_reuse_action(  # type: ignore[return-value]
+        request, "execute", actor, now, executor=executor
+    )
 
 
