+def test_seriousness_precedence_and_offsets(levels, expected, report_by):
+    events = [event("E0", onset="2024-01-10T00:00:00Z", seriousness=levels[0])]
+    for index, level in enumerate(levels[1:], start=1):
+        events.append(
+            event(
+                f"E{index}",
+                follow_up_of=f"E{index - 1}",
+                onset="2024-01-20T00:00:00Z",
+                seriousness=level,
+            )
+        )
+    for ordering in (events, list(reversed(events))):
+        (case,) = triage_events(ordering, now=NOW)
+        assert case["seriousness"] == expected
+        assert case["onset"] == "2024-01-10T00:00:00Z"
+        assert case["report_by"] == report_by
+
+
+def test_deadline_uses_earliest_onset_even_if_on_followup():
+    events = [
+        event("A", onset="2024-01-10T00:00:00Z", seriousness="hospitalization"),
+        event("B", follow_up_of="A", onset="2024-01-05T00:00:00Z"),
+    ]
+    (case,) = triage_events(events, now=NOW)
+    assert case["onset"] == "2024-01-05T00:00:00Z"
+    assert case["report_by"] == "2024-01-20T00:00:00Z"
+
