+@pytest.mark.parametrize(
+    ("seriousness", "days"),
+    [("fatal", 7), ("life_threatening", 7), ("hospitalization", 15), ("other", 30)],
+)
+def test_overdue_is_strictly_after_the_deadline(seriousness, days):
+    events = [event("A", onset="2024-03-01T00:00:00Z", seriousness=seriousness)]
+    report_by = datetime(2024, 3, 1, tzinfo=timezone.utc) + timedelta(days=days)
+    tick = timedelta(microseconds=1)
+
+    def overdue(now):
+        [case] = triage_events(events, now=now)
+        return case["overdue"]
+
+    assert overdue(report_by - tick) is False
+    assert overdue(report_by) is False
+    assert overdue(report_by + tick) is True
+    # The same boundary instant expressed in another offset is still equality.
+    shifted = report_by.astimezone(timezone(timedelta(hours=5, minutes=30)))
+    assert overdue(shifted) is False
+    assert overdue(shifted + tick) is True
+
