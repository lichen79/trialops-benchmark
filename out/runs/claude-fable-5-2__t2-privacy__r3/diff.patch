+    subject["consents"][0]["signed_on"] = "2024-01-01"
+    assert exported([subject], on=date(2024, 6, 14)) == [pseudonym("retained")]
+    assert exported([subject], on=ON) == [pseudonym("retained")]
+    assert exported([subject], on=date(2024, 6, 16)) == []
+
+
+def test_only_a_consent_for_the_requested_purpose_counts():
+    other_purpose = make_subject("other-purpose")
+    other_purpose["consents"] = [{"purpose": "marketing", "signed_on": "2024-01-01"}]
+    no_consent = make_subject("no-consent", consents=[])
+    # A withdrawn consent does not cancel a separate, active one.
+    renewed = make_subject("renewed")
+    renewed["consents"] = [
