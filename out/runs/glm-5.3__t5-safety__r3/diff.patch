+def test_long_chain_and_branching_followups_merge_into_one_case():
+    events = [
+        event("G", follow_up_of="F", onset="2024-01-12T00:00:00Z", source="site-c"),
+        event("F", follow_up_of="R", onset="2024-01-11T00:00:00Z", source="site-c"),
+        event("B", follow_up_of="R", onset="2024-01-09T00:00:00Z", source="site-a"),
+        event("R", onset="2024-01-10T00:00:00Z", source="site-b"),
+    ]
+    now = datetime(2024, 2, 1, tzinfo=timezone.utc)
+
+    [case] = triage_events(events, now=now)
+
+    assert case["case_id"] == "R"
+    assert case["event_ids"] == ["B", "F", "G", "R"]
+    # Every source identifier survives the merge, de-duplicated and sorted.
+    assert case["sources"] == ["site-a", "site-b", "site-c"]
+    assert case["onset"] == "2024-01-09T00:00:00Z"
+
+
+def test_offset_normalization_uses_earliest_instant_in_utc():
+    events = [
+        event("R", onset="2024-01-01T03:00:00+02:00"),
+        event("F1", follow_up_of="R", onset="2024-01-01T02:00:00+02:00"),
+        # 2023-12-31T21:30:00-05:00 is 2024-01-01T02:30:00Z: the earliest
+        # instant, even though its local wall clock reads the latest date.
+        event("F2", follow_up_of="F1", onset="2023-12-31T21:30:00-05:00"),
+    ]
+    now = datetime(2024, 12, 1, tzinfo=timezone.utc)
+
+    [case] = triage_events(events, now=now)
+
+    assert case["onset"] == "2024-01-01T01:00:00Z"
+    assert case["event_ids"] == ["F1", "F2", "R"]
+    assert case["report_by"] == "2024-01-31T01:00:00Z"
+
+
+def test_deadline_uses_earliest_onset_not_followup_arrival_time():
+    events = [
+        event("R", onset="2024-01-01T00:00:00Z", seriousness="other"),
+        # A later follow-up escalates seriousness but must not restart the clock.
+        event(
+            "F1",
