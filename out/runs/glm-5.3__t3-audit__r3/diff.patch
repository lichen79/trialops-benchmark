+    # Appending to one restored chain does not leak into the other.
+    assert append_event(second, "event-3", AT + timedelta(seconds=5))[
+        "sequence"
+    ] == 3
+    with pytest.raises(ValueError, match="unique"):
+        append_event(second, "event-1")
