+def test_lab_boundaries_are_inclusive_on_both_ends():
+    protocol = make_protocol()
+    protocol["labs"] = {"A": [1.5, 3.5]}
+    subject = make_subject()
+    subject["labs"] = {"A": 1.5}
+
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15))["reasons"] == []
+
+    subject["labs"] = {"A": 3.5}
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15))["reasons"] == []
+
+    subject["labs"] = {"A": 1.49}
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15))["reasons"] == [
+        "LAB_A_LOW"
+    ]
+
+    subject["labs"] = {"A": 3.51}
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15))["reasons"] == [
+        "LAB_A_HIGH"
+    ]
+
