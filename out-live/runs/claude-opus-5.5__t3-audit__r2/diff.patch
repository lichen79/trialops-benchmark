diff -ruN -x __pycache__ -x .pytest_cache a/trialops/audit.py b/trialops/audit.py
--- a/trialops/audit.py	2026-11-13 20:17:29
+++ b/trialops/audit.py	2026-11-14 11:17:36
@@ -83,6 +83,47 @@
         self._event_ids: set[str] = set()
 
 
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a chain from a persisted snapshot anchored by trusted values.
+
+        Raises ValueError("INVALID_CHAIN:<sorted,codes>") when verification fails.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                materialized,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # Trusted anchors are mandatory; None must not silently skip checks.
+        if expected_head is None:
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = deepcopy(materialized)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = (
+            chain.records[-1]["hash"] if chain.records else GENESIS_HASH
+        )
+        return chain
+
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
 
