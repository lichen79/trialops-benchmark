+def test_uncertainty_from_any_event_is_preserved():
+    def uncertain(*flags):
+        events = [
+            event(
+                f"E{index}",
+                follow_up_of=f"E{index - 1}" if index else None,
+                **({} if flag is None else {"uncertain": flag}),
+            )
+            for index, flag in enumerate(flags)
+        ]
+        [case] = triage_events(events, now=NOW)
+        return case["uncertain"]
+
+    assert uncertain(None, None) is False
+    assert uncertain(False, False) is False
+    assert uncertain(True) is True
+    assert uncertain(True, False) is True
+    # A later "certain" follow-up does not erase earlier uncertainty.
+    assert uncertain(None, True, False) is True
+    assert uncertain(None, None, True) is True
