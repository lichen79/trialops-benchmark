+    assert case["seriousness"] == "hospitalization"
+    assert case["onset"] == "2024-01-01T00:00:00Z"
+    assert case["report_by"] == "2024-01-16T00:00:00Z"
+    assert case["overdue"] is False
+
+
+def test_duplicate_roots_are_rejected_regardless_of_role():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events([event("E1"), event("E1")], now=now)
+    # The same identifier claimed twice, once as a root and once as a follow-up.
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [
+                event("E1"),
+                event("E2", follow_up_of="E3"),
+                event("E1", follow_up_of="E2"),
+            ],
+            now=now,
+        )
+
+
+def test_cycle_shapes_are_rejected_in_any_input_order():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events([event("A", follow_up_of="A")], now=now)
+
+    three_cycle = [
+        event("A", follow_up_of="C"),
+        event("B", follow_up_of="A"),
+        event("C", follow_up_of="B"),
+    ]
+    for shuffled in ([three_cycle, list(reversed(three_cycle))]):
+        with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+            triage_events(shuffled, now=now)
+
+
+def test_chain_leading_into_a_cycle_is_rejected():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    events = [
+        event("Z", follow_up_of="Y"),
+        event("Y", follow_up_of="B"),
+        event("A", follow_up_of="B"),
+        event("B", follow_up_of="A"),
+    ]
+
+    for order in (events, list(reversed(events))):
+        with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+            triage_events(order, now=now)
+
+
+@pytest.mark.parametrize(
+    "changes",
+    [
+        {"event_code": "SYNTH-02"},
+        {"subject_pseudonym": "subject-002"},
