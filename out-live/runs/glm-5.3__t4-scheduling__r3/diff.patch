--- a/tests/test_booking.py	1970-01-01 01:00:00
+++ b/tests/test_booking.py	2026-11-14 12:03:58
@@ -0,0 +1,306 @@
+from datetime import date, timedelta
+from copy import deepcopy
+
+import pytest
+
+from trialops.scheduling import book_subject_visits, plan_visits
+
+
+ON = date(2024, 6, 15)
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3], "Z": [10, 20]},
+        "exclusions": ["DO_NOT_ENROLL", "PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+        "labs": {"A": 2, "Z": 15},
+        "flags": [],
+    }
+
+
+def book(subject=None, protocol=None, *, capacity, **overrides):
+    call = {
+        "on": ON,
+        "first_day": date(2024, 6, 30),
+        "offsets_months": [0, 1],
+        "hour": 9,
+        "minute": 0,
+        "timezone": "America/New_York",
+        "capacity": capacity,
+    }
+    call.update(overrides)
+    return book_subject_visits(
+        subject if subject is not None else make_subject(),
+        protocol if protocol is not None else make_protocol(),
+        **call,
+    )
+
+
+def test_eligible_booking_decrements_only_listed_days_and_preserves_inputs():
+    capacity = {date(2024, 6, 30): 2, date(2024, 7, 31): 1, date(2024, 8, 15): 5}
+    subject = make_subject()
+    protocol = make_protocol()
+    subject_snapshot = deepcopy(subject)
+    protocol_snapshot = deepcopy(protocol)
+
+    visits = book(capacity=capacity)
+
+    # Offsets derive from first_day (Jun 30) and clamp into the target month:
+    # Jul 30 for offset 1, so the unlisted Aug 15 entry is untouched.
+    assert [visit["offset_months"] for visit in visits] == [0, 1]
+    assert [visit["local"] for visit in visits] == [
+        "2024-06-30T09:00:00-04:00",
+        "2024-07-30T09:00:00-04:00",
+    ]
+    assert [visit["utc"] for visit in visits] == [
+        "2024-06-30T13:00:00Z",
+        "2024-07-30T13:00:00Z",
+    ]
+    assert capacity == {date(2024, 6, 30): 1, date(2024, 7, 31): 1, date(2024, 8, 15): 5}
+    assert subject == subject_snapshot
+    assert protocol == protocol_snapshot
+
+
+def test_unlisted_reserved_days_are_never_inserted_into_capacity():
+    capacity = {}
+
+    visits = book(capacity=capacity, first_day=date(2024, 6, 30))
+
+    assert len(visits) == 2
+    assert capacity == {}
+
+
+def test_sequential_slot_contention_moves_later_subjects_forward():
+    capacity = {date(2024, 6, 30): 1, date(2024, 7, 1): 1}
+
+    first = book(capacity=capacity, offsets_months=[0])
+    second = book(capacity=capacity, offsets_months=[0])
+
+    assert [visit["local"][:10] for visit in first] == ["2024-06-30"]
+    # The single Jun 30 slot is exhausted by the first booking, so the second
+    # subject moves to the next available day.
+    assert [visit["local"][:10] for visit in second] == ["2024-07-01"]
+    assert capacity == {date(2024, 6, 30): 0, date(2024, 7, 1): 0}
+
+
+def test_within_plan_multiple_visits_compete_for_one_slot():
+    capacity = {date(2024, 6, 30): 1, date(2024, 7, 30): 1}
+
+    visits = book(capacity=capacity, first_day=date(2024, 6, 30))
+
+    assert [visit["local"][:10] for visit in visits] == ["2024-06-30", "2024-07-30"]
+    assert capacity == {date(2024, 6, 30): 0, date(2024, 7, 30): 0}
+
+
+def test_later_visit_failure_rolls_back_the_whole_call():
+    # The second nominal day is closed for over a year, so it is
+    # UNSCHEDULABLE and the whole booking must be rolled back.
+    closed_start = date(2024, 8, 30)
+    closed_days = {closed_start + timedelta(days=days) for days in range(367)}
+    capacity = {date(2024, 6, 30): 3}
+
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(
+            capacity=capacity,
+            offsets_months=[0, 2],
+            closed_days=closed_days,
+        )
+    assert capacity == {date(2024, 6, 30): 3}
+
+
+def test_ineligible_subject_leaves_capacity_untouched_and_reports_reasons():
+    capacity = {date(2024, 6, 30): 2}
+    subject = make_subject()
+    subject.update(
+        birth_date="1970-01-01",
+        consents=[{"version": "v1", "signed_on": "2023-12-31"}],
+        flags=["PRIOR", "DO_NOT_ENROLL"],
+        labs={"A": 0, "Z": 21},
+    )
+    subject_snapshot = deepcopy(subject)
+
+    with pytest.raises(ValueError) as exc_info:
+        book(subject=subject, capacity=capacity)
+
+    assert str(exc_info.value) == (
+        "INELIGIBLE:CONSENT_MISSING,CONSENT_VERSION,AGE_ABOVE_MAX,"
+        "EXCLUSION_DO_NOT_ENROLL,EXCLUSION_PRIOR,LAB_A_LOW,LAB_Z_HIGH"
+    )
+    assert capacity == {date(2024, 6, 30): 2}
+    assert subject == subject_snapshot
+
+
+def test_ineligible_reasons_follow_protocol_order_not_input_order():
+    capacity = {date(2024, 6, 30): 1}
+    subject = make_subject()
+    subject["labs"] = {"A": 99, "Z": 5}
+
+    with pytest.raises(ValueError, match=r"INELIGIBLE:LAB_A_HIGH,LAB_Z_LOW"):
+        book(subject=subject, capacity=capacity)
+    assert capacity == {date(2024, 6, 30): 1}
+
+
+def test_earlier_successful_bookings_stay_committed_after_a_failure():
+    capacity = {date(2024, 6, 30): 1, date(2024, 7, 1): 1}
+
+    committed = book(capacity=capacity, offsets_months=[0])
+    assert capacity == {date(2024, 6, 30): 0, date(2024, 7, 1): 1}
+
+    # The second visit's nominal day and the 366 days after it are all closed.
+    closed_days = {
+        date(2024, 7, 30) + timedelta(days=days) for days in range(367)
+    }
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(
+            capacity=capacity,
+            offsets_months=[0, 1],
+            closed_days=closed_days,
+        )
+
+    assert committed[0]["local"][:10] == "2024-06-30"
+    assert capacity == {date(2024, 6, 30): 0, date(2024, 7, 1): 1}
+
+
+def test_dst_gap_and_month_end_are_preserved_when_booking():
+    capacity = {date(2024, 2, 29): 1}
+
+    visits = book(
+        capacity=capacity,
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+        closed_days={date(2024, 2, 28)},
+    )
+
+    # Jan 31 is open but 02:30 does not exist on that day (it falls in the gap
+    # only on the transition day, so it stays), and the offset-1 candidate is
+    # clamped from Jan 31 to Feb 29, which is capped at a single slot.
+    assert [visit["local"][:10] for visit in visits] == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 2, 29): 0}
+
+
+def test_dst_gap_moves_a_nonexistent_time_forward_when_booking():
+    capacity = {date(2024, 3, 10): 1}
+
+    visits = book(
+        capacity=capacity,
+        first_day=date(2024, 3, 10),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+    )
+
+    assert visits == [
+        {
+            "offset_months": 0,
+            "local": "2024-03-10T03:30:00-04:00",
+            "utc": "2024-03-10T07:30:00Z",
+        }
+    ]
+    assert capacity == {date(2024, 3, 10): 0}
+
+
+def test_paris_gap_is_handled_when_booking():
+    capacity = {}
+
+    visits = book(
+        capacity=capacity,
+        first_day=date(2024, 3, 31),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="Europe/Paris",
+    )
+
+    assert visits == [
+        {
+            "offset_months": 0,
+            "local": "2024-03-31T03:30:00+02:00",
+            "utc": "2024-03-31T01:30:00Z",
+        }
+    ]
+    assert capacity == {}
+
+
+def test_leap_year_month_end_offsets_clamp_from_the_original_day():
+    capacity = {date(2024, 2, 29): 1}
+
+    visits = book(
+        capacity=capacity,
+        first_day=date(2024, 1, 31),
+        offsets_months=[1, 2],
+        hour=10,
+        minute=0,
+        timezone="America/New_York",
+    )
+
+    assert [visit["local"][:10] for visit in visits] == ["2024-02-29", "2024-03-31"]
+    assert capacity == {date(2024, 2, 29): 0}
+
+
+def test_closed_days_are_never_mutated_and_capacity_stays_validated():
+    closed_days = {date(2024, 6, 30)}
+    snapshot = set(closed_days)
+    capacity = {date(2024, 7, 1): 1}
+
+    visits = book(capacity=capacity, closed_days=closed_days)
+
+    assert [visit["local"][:10] for visit in visits] == ["2024-07-01", "2024-07-01"]
+    assert capacity == {date(2024, 7, 1): 0}
+    assert closed_days == snapshot
+
+
+def test_booking_validates_inputs_through_plan_visits():
+    capacity = {date(2024, 6, 30): 1}
+
+    with pytest.raises(ValueError, match="INVALID_TIMEZONE"):
+        book(capacity=capacity, timezone="Not/A_Real_Zone")
+    with pytest.raises(ValueError, match="DUPLICATE_OFFSET"):
+        book(capacity=capacity, offsets_months=[0, 0])
+    with pytest.raises(ValueError, match="INVALID_HOUR"):
+        book(capacity=capacity, hour=24)
+    assert capacity == {date(2024, 6, 30): 1}
+
+
+def test_booking_requires_a_capacity_mapping():
+    with pytest.raises(TypeError):
+        book_subject_visits(
+            make_subject(),
+            make_protocol(),
+            on=ON,
+            first_day=date(2024, 6, 30),
+            offsets_months=[0],
+            hour=9,
+            minute=0,
+            timezone="America/New_York",
+            capacity=[date(2024, 6, 30)],
+        )
+
+
+def test_booking_result_matches_plan_visits_for_the_same_inputs():
+    capacity = {date(2024, 6, 30): 1}
+
+    visits = book(capacity=capacity)
+
+    assert visits == plan_visits(
+        first_day=date(2024, 6, 30),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity={date(2024, 6, 30): 1},
+    )
