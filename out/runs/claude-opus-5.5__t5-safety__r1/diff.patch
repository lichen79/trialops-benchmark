diff -ruN -x __pycache__ -x .pytest_cache a/tests/test_safety.py b/tests/test_safety.py
--- a/tests/test_safety.py	2026-11-13 14:53:37
+++ b/tests/test_safety.py	2026-11-13 20:38:25
@@ -90,6 +90,118 @@
         )
 
 
+NOW = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+
+@pytest.mark.parametrize(
+    "levels, expected, days",
+    [
+        (["other"], "other", 30),
+        (["other", "hospitalization"], "hospitalization", 15),
+        (["hospitalization", "life_threatening", "other"], "life_threatening", 7),
+        (["life_threatening", "fatal", "hospitalization"], "fatal", 7),
+    ],
+)
+def test_seriousness_precedence_and_reporting_windows(levels, expected, days):
+    events = [event("R", onset="2024-03-01T00:00:00Z", seriousness=levels[0])]
+    for index, level in enumerate(levels[1:], start=1):
+        events.append(
+            event(
+                f"F{index}",
+                follow_up_of="R" if index == 1 else f"F{index - 1}",
+                onset="2024-03-05T00:00:00Z",
+                seriousness=level,
+            )
+        )
+    (case,) = triage_events(events, now=NOW)
+    assert case["seriousness"] == expected
+    assert case["onset"] == "2024-03-01T00:00:00Z"
+    assert case["report_by"] == f"2024-03-{1 + days:02d}T00:00:00Z"
+
+
+def test_deadline_uses_earliest_onset_even_from_followup_with_offsets():
+    events = [
+        event("R", onset="2024-05-10T12:00:00+09:00", seriousness="hospitalization"),
+        # Earlier onset reported later via follow-up, in a negative offset.
+        event("F", follow_up_of="R", onset="2024-05-09T20:00:00-07:00"),
+    ]
+    (case,) = triage_events(events, now=NOW)
+    assert case["onset"] == "2024-05-10T03:00:00Z"
+    assert case["report_by"] == "2024-05-25T03:00:00Z"
+    assert case["case_id"] == "R"
+
+
+def test_input_order_does_not_affect_output():
+    events = [
+        event("A1", onset="2024-01-05T00:00:00Z", source="s2"),
+        event("A2", follow_up_of="A1", source="s1", uncertain=True),
+        event("A3", follow_up_of="A2", seriousness="life_threatening", source="s2"),
+        event("B1", subject_pseudonym="subject-002", onset="2024-01-04T00:00:00Z"),
+    ]
+    expected = triage_events(events, now=NOW)
+    for permutation in (events[::-1], [events[2], events[0], events[3], events[1]]):
+        assert triage_events(permutation, now=NOW) == expected
+    assert [c["case_id"] for c in expected] == ["B1", "A1"]
+    assert expected[1]["sources"] == ["s1", "s2"]
+    assert expected[1]["event_ids"] == ["A1", "A2", "A3"]
+    assert expected[1]["uncertain"] is True
+    assert expected[0]["uncertain"] is False
+
+
+def test_overdue_boundary_is_strict():
+    events = [event("A", onset="2024-01-01T00:00:00Z", seriousness="fatal")]
+    report_by = datetime(2024, 1, 8, tzinfo=timezone.utc)
+    assert triage_events(events, now=report_by)[0]["overdue"] is False
+    assert triage_events(events, now=report_by - report_by.resolution)[0]["overdue"] is False
+    assert triage_events(events, now=report_by + report_by.resolution)[0]["overdue"] is True
+
+
+def test_duplicate_root_ids_rejected_even_with_followups():
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [event("R"), event("F", follow_up_of="R"), event("R", source="site-z")],
+            now=NOW,
+        )
+
+
+def test_self_link_and_longer_cycle_rejected():
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events([event("A", follow_up_of="A")], now=NOW)
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events(
+            [
+                event("X", follow_up_of="C"),
+                event("A", follow_up_of="C"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B"),
+            ],
+            now=NOW,
+        )
+
+
+def test_mixed_subject_or_code_in_deep_chain_rejected():
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [
+                event("A"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B", subject_pseudonym="subject-999"),
+            ],
+            now=NOW,
+        )
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [event("C", follow_up_of="B", event_code="SYNTH-99"), event("B", follow_up_of="A"), event("A")],
+            now=NOW,
+        )
+
+
+@pytest.mark.parametrize("value", ["severe", "FATAL", None, 3])
+def test_unknown_seriousness_rejected(value):
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=value)], now=NOW)
+
+
 def test_naive_now_and_onset_are_rejected():
     with pytest.raises(ValueError, match="INVALID_NOW"):
         triage_events([], now=datetime(2024, 1, 1))
