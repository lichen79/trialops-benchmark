diff -ruN -x __pycache__ -x .pytest_cache a/scratch_safety_check.py b/scratch_safety_check.py
--- a/scratch_safety_check.py	1970-01-01 01:00:00
+++ b/scratch_safety_check.py	2026-11-13 21:05:42
@@ -0,0 +1,224 @@
+"""Scratch checks for safety triage edge cases (not part of the suite)."""
+
+from datetime import datetime, timedelta, timezone
+
+from trialops.safety import triage_events
+
+NOW = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+
+def expect_error(events, code):
+    try:
+        triage_events(events, now=NOW)
+    except ValueError as exc:
+        assert str(exc) == code, f"{code} != {str(exc)}"
+        return
+    raise AssertionError(f"expected {code}, no error raised")
+
+
+def base(event_id, **changes):
+    value = {
+        "event_id": event_id,
+        "subject_pseudonym": "subject-001",
+        "event_code": "SYNTH-01",
+        "onset": "2024-01-10T10:00:00+02:00",
+        "seriousness": "other",
+        "source": "site-b",
+    }
+    value.update(changes)
+    return value
+
+
+# Self-link and longer cycle, both orders.
+expect_error([base("A", follow_up_of="A")], "FOLLOW_UP_CYCLE")
+expect_error(
+    [base("A", follow_up_of="C"), base("B", follow_up_of="A"), base("C", follow_up_of="B")],
+    "FOLLOW_UP_CYCLE",
+)
+
+# Cycle through a shared root: A -> B, C -> B, B -> A.
+expect_error(
+    [
+        base("A"),
+        base("B", follow_up_of="A"),
+        base("C", follow_up_of="B"),
+        base("D", follow_up_of="C"),
+    ],
+    "MIXED_CASE",
+)
+
+# Missing root beats nothing: dangling link present regardless of order.
+expect_error([base("A", follow_up_of="gone")], "MISSING_ROOT")
+
+# Mixed subject / mixed code deep in a chain.
+expect_error(
+    [
+        base("A"),
+        base("B", follow_up_of="A"),
+        base("C", follow_up_of="B", subject_pseudonym="subject-002"),
+    ],
+    "MIXED_CASE",
+)
+expect_error(
+    [
+        base("A"),
+        base("B", follow_up_of="A"),
+        base("C", follow_up_of="B", event_code="OTHER"),
+    ],
+    "MIXED_CASE",
+)
+
+# Duplicate ID among follow-ups only.
+expect_error(
+    [base("A"), base("B", follow_up_of="A"), base("B", follow_up_of="A")],
+    "DUPLICATE_EVENT_ID",
+)
+
+# Naive now and naive onset.
+try:
+    triage_events([], now=datetime(2024, 1, 1))
+except ValueError as exc:
+    assert str(exc) == "INVALID_NOW"
+else:
+    raise AssertionError("naive now should raise")
+expect_error([base("A", onset="2024-01-10T00:00:00")], "INVALID_ONSET")
+expect_error([base("A", onset="not-a-date")], "INVALID_ONSET")
+expect_error([base("A", onset=20240110)], "INVALID_ONSET")
+
+# Unknown seriousness / bad uncertain / bad link.
+expect_error([base("A", seriousness="severe")], "INVALID_SERIOUSNESS")
+expect_error([base("A", seriousness=None)], "INVALID_SERIOUSNESS")
+expect_error([base("A", uncertain="yes")], "INVALID_UNCERTAIN")
+expect_error([base("A", uncertain=1)], "INVALID_UNCERTAIN")
+expect_error([base("A", follow_up_of="")], "INVALID_FOLLOW_UP_OF")
+expect_error([base("A", follow_up_of=5)], "INVALID_FOLLOW_UP_OF")
+
+# Required text fields.
+for field in ("event_id", "subject_pseudonym", "event_code", "source"):
+    bad = base("A")
+    bad.pop(field)
+    expect_error([bad], f"INVALID_{field.upper()}")
+    bad = base("A")
+    bad[field] = "   "
+    expect_error([bad], f"INVALID_{field.upper()}")
+
+# Non-mapping event.
+expect_error(["nope"], "INVALID_EVENT")
+
+# Event equality of onset with equal onsets but different IDs.
+cases = triage_events(
+    [
+        base("B", onset="2024-01-10T00:00:00Z"),
+        base("A", onset="2024-01-10T00:00:00Z"),
+    ],
+    now=NOW,
+)
+assert [case["case_id"] for case in cases] == ["A", "B"], cases
+
+# Order independence for chains of length 3 with several permutations.
+from itertools import permutations  # noqa: E402
+
+chain = [
+    base("A", onset="2024-01-10T00:00:00Z", seriousness="fatal"),
+    base("B", follow_up_of="A", onset="2024-01-09T00:00:00Z", seriousness="other"),
+    base("C", follow_up_of="B", onset="2024-01-11T00:00:00Z", source="site-a", uncertain=True),
+]
+baseline = triage_events(chain, now=NOW)
+for shuffled in permutations(chain):
+    assert triage_events(shuffled, now=NOW) == baseline, shuffled
+
+# Deadline uses earliest onset, not arrival.
+single = triage_events(
+    [
+        base("A", onset="2024-01-10T00:00:00Z", seriousness="fatal"),
+        base("B", follow_up_of="A", onset="2024-02-10T00:00:00Z", seriousness="other"),
+    ],
+    now=NOW,
+)[0]
+assert single["onset"] == "2024-01-10T00:00:00Z"
+assert single["seriousness"] == "fatal"
+assert single["report_by"] == "2024-01-17T00:00:00Z"
+assert single["event_ids"] == ["A", "B"]
+assert single["uncertain"] is False
+assert single["overdue"] is True
+
+# Non-UTC now is treated as an instant.
+deadline = datetime(2024, 1, 17, 0, 0, tzinfo=timezone.utc)
+at_deadline = triage_events(
+    [base("A", onset="2024-01-10T00:00:00Z", seriousness="fatal")],
+    now=deadline,
+)[0]
+assert at_deadline["overdue"] is False
+assert at_deadline["report_by"] == "2024-01-17T00:00:00Z"
+after = triage_events(
+    [base("A", onset="2024-01-10T00:00:00Z", seriousness="fatal")],
+    now=deadline + timedelta(microseconds=1),
+)[0]
+assert after["overdue"] is True
+offset_now = triage_events(
+    [base("A", onset="2024-01-10T00:00:00Z", seriousness="fatal")],
+    now=deadline.astimezone(timezone(timedelta(hours=5))),
+)[0]
+assert offset_now["overdue"] is False
+
+# Max date onset -> report_by overflow yields a stable code.
+expect_error(
+    [base("A", onset="9999-12-31T23:59:59Z", seriousness="fatal")],
+    "REPORT_BY_OUT_OF_RANGE",
+)
+
+# Fractional-second and microseconds round-trip through UTC.
+with_us = triage_events(
+    [base("A", onset="2024-01-10T00:00:00.123456+00:00")], now=NOW
+)[0]
+assert with_us["onset"] == "2024-01-10T00:00:00.123456Z"
+assert with_us["report_by"] == "2024-02-09T00:00:00.123456Z"
+
+# Duplicate sources collapse; duplicate IDs never appear twice.
+merged = triage_events(
+    [
+        base("A", source="site-a"),
+        base("B", follow_up_of="A", source="site-a"),
+        base("C", follow_up_of="A", source="site-c"),
+    ],
+    now=NOW,
+)[0]
+assert merged["sources"] == ["site-a", "site-c"]
+assert merged["event_ids"] == ["A", "B", "C"]
+
+# Uncertainty is preserved from any member.
+assert triage_events(
+    [base("A"), base("B", follow_up_of="A", uncertain=True)], now=NOW
+)[0]["uncertain"] is True
+assert triage_events(
+    [base("A", uncertain=True), base("B", follow_up_of="A")], now=NOW
+)[0]["uncertain"] is True
+
+# Case ID equals root ID, not the first input event.
+root_last = triage_events(
+    [
+        base("B", follow_up_of="A"),
+        base("A"),
+    ],
+    now=NOW,
+)[0]
+assert root_last["case_id"] == "A"
+
+# Real datetimes are accepted for onset (aware) but not naive.
+aware_dt = datetime(2024, 1, 10, 5, 0, tzinfo=timezone.utc)
+try:
+    case = triage_events([base("A", onset=aware_dt)], now=NOW)
+except ValueError as exc:
+    raise AssertionError(f"aware datetime should work: {exc}")
+else:
+    assert case[0]["onset"] == "2024-01-10T05:00:00Z"
+
+# Bad generator-like inputs.
+try:
+    triage_events({"a": 1}, now=NOW)
+except TypeError:
+    pass
+else:
+    raise AssertionError("non-iterable mapping should raise TypeError")
+
+print("all scratch checks passed")
