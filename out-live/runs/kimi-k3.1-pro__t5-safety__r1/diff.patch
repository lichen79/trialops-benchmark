+@pytest.mark.parametrize(
+    ("seriousness", "days"),
+    [
+        ("fatal", 7),
+        ("life_threatening", 7),
+        ("hospitalization", 15),
+        ("other", 30),
+    ],
+)
+def test_reporting_offsets_start_at_earliest_onset(seriousness, days):
+    onset = datetime(2024, 1, 10, 8, 0, tzinfo=timezone.utc)
+    case = triage_events(
+        [event("ROOT", onset="2024-01-10T10:00:00+02:00", seriousness=seriousness)],
+        now=onset,
+    )[0]
+
+    expected_deadline = onset + timedelta(days=days)
+    assert case["onset"] == "2024-01-10T08:00:00Z"
+    assert case["seriousness"] == seriousness
+    assert case["report_by"] == expected_deadline.isoformat().replace("+00:00", "Z")
+
+
+def test_input_order_does_not_change_output():
+    events = [
+        event("C", follow_up_of="B", onset="2024-01-12T08:00:00Z"),
+        event("A", onset="2024-02-01T08:00:00Z"),
+        event(
+            "B",
+            follow_up_of="A",
+            onset="2024-01-01T08:00:00Z",
+            source="site-a",
+            uncertain=True,
+        ),
+    ]
+    now = datetime(2024, 3, 1, tzinfo=timezone.utc)
+    expected = triage_events(events, now=now)
+
+    assert all(triage_events(order, now=now) == expected for order in permutations(events))
+
+
+@pytest.mark.parametrize("seriousness", ["unknown", "", "FATAL", None])
+def test_unknown_seriousness_is_rejected(seriousness):
+    with pytest.raises(ValueError, match="^INVALID_SERIOUSNESS$"):
+        triage_events(
+            [event("A", seriousness=seriousness)],
+            now=datetime(2024, 1, 1, tzinfo=timezone.utc),
+        )
+
+
+def test_invalid_event_links_are_rejected():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    for link in ("", " ", 1):
+        with pytest.raises(ValueError, match="^INVALID_FOLLOW_UP_OF$"):
+            triage_events([event("A", follow_up_of=link)], now=now)
+
+    with pytest.raises(ValueError, match="^FOLLOW_UP_CYCLE$"):
+        triage_events([event("A", follow_up_of="A")], now=now)
+
+
+@pytest.mark.parametrize("microseconds", [0, 1])
+def test_overdue_boundary_is_strict(microseconds):
+    deadline = datetime(2024, 1, 17, 8, 0, tzinfo=timezone.utc)
+    record = event(
+        "A",
+        onset="2024-01-10T08:00:00Z",
+        seriousness="fatal",
+    )
+
+    case = triage_events(
+        [record], now=deadline + timedelta(microseconds=microseconds)
+    )[0]
+    assert case["overdue"] is (microseconds == 1)
