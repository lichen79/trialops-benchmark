+from typing import Any
 from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
 
+from trialops.eligibility import evaluate_subject
+
 _ONE_DAY = timedelta(days=1)
 _ZERO_DELTA = timedelta(0)
 
@@ -147,3 +150,53 @@
     return visits
 
 
+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Plan visits for an eligible subject and reserve their capacity slots.
+
+    ``capacity`` is updated only after the whole plan succeeds; any failure
+    leaves it exactly as it was. Dates that are not listed stay unconstrained
+    and are never inserted.
+    """
+    evaluation = evaluate_subject(subject, protocol, on)
+    if not evaluation["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(evaluation["reasons"]))
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to slots")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Work out every new count before touching the caller's dict, so the
+    # commit below cannot stop half-way.
+    updates: dict[date, int] = {}
+    for visit in visits:
+        visit_day = datetime.fromisoformat(str(visit["local"])).date()
+        if visit_day not in capacity:
+            continue
+        slots_left = updates.get(visit_day, capacity[visit_day]) - 1
+        if slots_left < 0:
+            raise ValueError("UNSCHEDULABLE")
+        updates[visit_day] = slots_left
+
+    capacity.update(updates)
+    return visits
