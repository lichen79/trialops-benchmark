+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request by exporting its pseudonymized rows.
+
+    Every guardrail (actor, state, approval, policy, clock) is enforced by the
+    governance workflow before the executor runs, so ``subjects`` is not
+    touched unless the request may be executed. Export failures surface as the
+    workflow's ``EXECUTION_FAILED`` and leave ``request`` unchanged.
+    """
+
+    def executor(approved_request: dict[str, Any]) -> dict[str, Any]:
+        # Governance has already validated ``now`` as timezone-aware.
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
 
