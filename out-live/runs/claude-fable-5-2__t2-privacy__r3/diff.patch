+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request by exporting its purpose-scoped rows.
+
+    Every guardrail (role, state, approval, policy, ``now``) is enforced by the
+    governance workflow before the executor runs, so ``subjects`` is only
+    consumed for a request that may actually be executed.  Export failures
+    surface as ``EXECUTION_FAILED`` and leave the caller's request untouched.
+    """
+
+    def executor(approved_request: dict[str, object]) -> dict[str, Any]:
+        # Governance has already validated ``now`` as timezone-aware here.
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
