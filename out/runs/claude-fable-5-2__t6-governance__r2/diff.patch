+def test_history_is_chronological_and_offsets_are_normalized_to_utc():
+    prior = [{"action": "imported", "actor": "system", "at": "2024-12-31T00:00:00Z"}]
+    draft = request(history=deepcopy(prior))
+
+    submitted = apply_reuse_action(
+        draft,
+        "submit",
+        "alice",
+        datetime(2025, 1, 1, 14, 0, tzinfo=timezone(timedelta(hours=2))),
+    )
+    late_evening_new_york = datetime(
+        2025, 1, 1, 23, 30, tzinfo=timezone(timedelta(hours=-5))
+    )
+    approved = apply_reuse_action(submitted, "approve", "bob", late_evening_new_york)
+    rejected = apply_reuse_action(submitted, "reject", "bob", late_evening_new_york)
+
+    # The approval window is anchored on the UTC calendar day of ``now``.
+    assert approved["approval_expires_on"] == "2025-02-01"
+    assert rejected["status"] == "rejected"
+    assert rejected["history"] == prior + [
+        {"action": "submit", "actor": "alice", "at": "2025-01-01T12:00:00Z"},
+        {"action": "reject", "actor": "bob", "at": "2025-01-02T04:30:00Z"},
+    ]
+    timestamps = [entry["at"] for entry in approved["history"]]
+    assert timestamps == sorted(timestamps)
+    assert [entry["action"] for entry in approved["history"]] == [
+        "imported",
+        "submit",
+        "approve",
+    ]
+    # Earlier snapshots keep their own, shorter histories.
+    assert draft["history"] == prior
+    assert len(submitted["history"]) == 2
+
