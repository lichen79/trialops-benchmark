@@ -0,0 +1,151 @@
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import plan_visits
+
+
+def _days(visits):
+    return [visit["local"][:10] for visit in visits]
+
+
+def test_non_leap_month_ends_always_derive_from_first_day():
+    visits = plan_visits(
+        first_day=date(2023, 1, 31),
+        offsets_months=[1, 2, 3, 0],
+        hour=9,
+        minute=0,
+        timezone="Europe/Paris",
+    )
+
+    # Protocol order is kept, and March is the 31st rather than the clamped 28th.
+    assert [visit["offset_months"] for visit in visits] == [1, 2, 3, 0]
+    assert _days(visits) == ["2023-02-28", "2023-03-31", "2023-04-30", "2023-01-31"]
+
+
+def test_leap_day_start_clamps_only_in_non_leap_years():
+    visits = plan_visits(
+        first_day=date(2024, 2, 29),
+        offsets_months=[12, 48],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+    )
+
+    assert _days(visits) == ["2025-02-28", "2028-02-29"]
+
+
+def test_rescheduled_visit_does_not_shift_later_candidates():
+    visits = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[1, 2],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=[date(2024, 2, 29), date(2024, 3, 1)],
+    )
+
+    assert _days(visits) == ["2024-03-02", "2024-03-31"]
+
+
+def test_paris_fall_back_uses_fold_zero():
+    [visit] = plan_visits(
+        first_day=date(2024, 10, 27),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="Europe/Paris",
+    )
+
+    assert visit["local"] == "2024-10-27T02:30:00+02:00"
+    assert visit["utc"] == "2024-10-27T00:30:00Z"
+
+
+def test_moved_visits_keep_the_original_wall_time_around_a_gap():
+    common = dict(
+        first_day=date(2024, 3, 9),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+    )
+
+    [onto_gap_day] = plan_visits(closed_days=[date(2024, 3, 9)], **common)
+    [past_gap_day] = plan_visits(
+        closed_days=[date(2024, 3, 9), date(2024, 3, 10)], **common
+    )
+
+    assert onto_gap_day["local"] == "2024-03-10T03:30:00-04:00"
+    assert onto_gap_day["utc"] == "2024-03-10T07:30:00Z"
+    # The shifted 03:30 is not carried over: 02:30 exists again on the 11th.
+    assert past_gap_day["local"] == "2024-03-11T02:30:00-04:00"
+    assert past_gap_day["utc"] == "2024-03-11T06:30:00Z"
+
+
+def test_capacity_boundaries_are_inclusive():
+    day = date(2024, 5, 15)
+    common = dict(
+        first_day=day, offsets_months=[0], hour=9, minute=0, timezone="Europe/Paris"
+    )
+
+    assert _days(plan_visits(capacity={day: 1}, **common)) == ["2024-05-15"]
+    assert _days(plan_visits(capacity={day: 0}, **common)) == ["2024-05-16"]
+
+
+def test_visits_compete_for_shared_slots_in_protocol_order():
+    closed = {date(2024, 1, 31) + timedelta(days=n) for n in range(30)}  # to Feb 29
+    capacity = {date(2024, 3, 1): 2, date(2024, 3, 2): 0}
+
+    visits = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[1, 0, 2],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+        capacity=capacity,
+    )
+
+    assert _days(visits) == ["2024-03-01", "2024-03-01", "2024-03-31"]
+    assert capacity == {date(2024, 3, 1): 2, date(2024, 3, 2): 0}
+
+    capacity[date(2024, 3, 1)] = 1
+    visits = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[1, 0],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+        capacity=capacity,
+    )
+    assert _days(visits) == ["2024-03-01", "2024-03-03"]
+
+
+def test_last_day_of_the_search_window_is_still_schedulable():
+    nominal = date(2024, 1, 1)
+    closed = {nominal + timedelta(days=n) for n in range(366)}
+
+    [visit] = plan_visits(
+        first_day=nominal,
+        offsets_months=[0],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+    )
+
+    assert visit["local"][:10] == (nominal + timedelta(days=366)).isoformat()
+
+
+@pytest.mark.parametrize("slots", [-1, True, 1.0])
+def test_invalid_capacity_values_are_rejected(slots):
+    with pytest.raises(ValueError, match="INVALID_CAPACITY"):
+        plan_visits(
+            first_day=date(2024, 1, 1),
+            offsets_months=[0],
+            hour=9,
+            minute=0,
+            timezone="America/New_York",
+            capacity={date(2024, 1, 1): slots},
+        )
