+def test_leap_day_birthday_in_non_leap_and_leap_years():
+    protocol = make_protocol()
+    protocol.update(
+        min_age=23,
+        max_age=23,
+        consent_valid_from="2023-01-01",
+        labs={},
+        exclusions=[],
+    )
+    subject = make_subject()
+    subject.update(
+        birth_date="2000-02-29",
+        consents=[{"version": "v2", "signed_on": "2023-01-01"}],
+        labs={},
+    )
+
+    assert evaluate_subject(subject, protocol, date(2023, 2, 28))["reasons"] == [
+        "AGE_BELOW_MIN"
+    ]
+    assert evaluate_subject(subject, protocol, date(2023, 3, 1))["eligible"] is True
+    assert evaluate_subject(subject, protocol, date(2024, 2, 28))["eligible"] is True
+    assert evaluate_subject(subject, protocol, date(2024, 2, 29))["reasons"] == [
+        "AGE_ABOVE_MAX"
+    ]
+
+
+def test_age_changes_exactly_on_the_birthday():
+    protocol = make_protocol()
+    protocol["min_age"] = protocol["max_age"] = 24
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-01-01"}]
+
+    assert evaluate_subject(subject, protocol, date(2024, 6, 14))["reasons"] == [
+        "AGE_BELOW_MIN"
+    ]
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15))["eligible"] is True
+    assert evaluate_subject(subject, protocol, date(2025, 6, 14))["eligible"] is True
+    assert evaluate_subject(subject, protocol, date(2025, 6, 15))["reasons"] == [
+        "AGE_ABOVE_MAX"
+    ]
+
+
+def test_lab_values_just_outside_inclusive_bounds_fail():
+    subject = make_subject()
+    subject["labs"] = {"A": 0.999, "Z": 20.001}
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["eligible"] is False
+    assert result["reasons"] == ["LAB_A_LOW", "LAB_Z_HIGH"]
+
+
+def test_retired_consent_with_required_version_and_absent_consent():
+    protocol = make_protocol()
+    on = date(2024, 6, 15)
+
+    retired = make_subject()
+    retired["consents"] = [{"version": "v2", "signed_on": "2023-12-31"}]
+    assert evaluate_subject(retired, protocol, on) == {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": "v2",
+    }
+
+    signed_on_valid_from = make_subject()
+    signed_on_valid_from["consents"] = [{"version": "v2", "signed_on": "2024-01-01"}]
+    assert evaluate_subject(signed_on_valid_from, protocol, on)["eligible"] is True
+
+    for consents in ([], [{"version": "v2", "signed_on": "2024-06-16"}]):
+        subject = make_subject()
+        subject["consents"] = consents
+        assert evaluate_subject(subject, protocol, on) == {
+            "eligible": False,
+            "reasons": ["CONSENT_MISSING"],
+            "consent_version": None,
+        }
+
+
+def test_missing_required_fields_raise_value_error_not_key_error():
+    on = date(2024, 6, 15)
+
+    subject = make_subject()
+    del subject["birth_date"]
+    with pytest.raises(ValueError, match="birth_date"):
+        evaluate_subject(subject, make_protocol(), on)
+
+    protocol = make_protocol()
+    del protocol["min_age"]
+    with pytest.raises(ValueError, match="min_age"):
+        evaluate_subject(make_subject(), protocol, on)
+
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2"}]
+    with pytest.raises(ValueError, match="signed_on"):
+        evaluate_subject(subject, make_protocol(), on)
+
+    protocol = make_protocol()
+    protocol["consent_valid_from"] = "2024-13-01"
+    with pytest.raises(ValueError, match="consent_valid_from"):
+        evaluate_subject(make_subject(), protocol, on)
+
+
