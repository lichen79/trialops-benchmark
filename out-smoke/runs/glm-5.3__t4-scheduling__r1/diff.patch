+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: Mapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Eligibility-gated booking whose reservations commit only on full success.
+
+    Eligibility is evaluated first: an ineligible subject raises
+    ``ValueError("INELIGIBLE:<reasons>")`` with the protocol-ordered reason
+    codes and never reaches planning. All candidate generation, closure, DST
+    handling, validation, and within-plan slot allocation is delegated to the
+    same engine as :func:`plan_visits`, which works on a private copy of
+    ``capacity``. That keeps every failure path -- including a late
+    ``UNSCHEDULABLE`` visit -- from consuming slots. Only after a complete
+    plan is produced are the booked days subtracted, and only for dates the
+    caller already listed: unlisted dates stay unconstrained and are never
+    inserted.
+    """
+
+    if not isinstance(capacity, Mapping):
+        raise TypeError("capacity must be a mapping of dates to slots")
+
+    result = evaluate_subject(subject, protocol, on)
+
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(result["reasons"]))
+
+    # Any raise here leaves the caller's capacity exactly as it was, because
+    # allocation happens against a private copy of the mapping.
+    planned = _plan(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    for visit_day, _visit in planned:
+        if visit_day in capacity:
+            capacity[visit_day] -= 1
+
+    return [visit for _, visit in planned]
 
 
