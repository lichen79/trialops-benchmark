@@ -0,0 +1,199 @@
+"""Ad-hoc probes for triage_events edge cases (deleted before finishing)."""
+
+from datetime import datetime, timedelta, timezone
+from itertools import permutations
+from random import Random
+
+from trialops.safety import triage_events
+
+NOW = datetime(2024, 6, 1, tzinfo=timezone.utc)
+
+
+def ev(event_id, **changes):
+    value = {
+        "event_id": event_id,
+        "subject_pseudonym": "subject-001",
+        "event_code": "SYNTH-01",
+        "onset": "2024-01-10T10:00:00+02:00",
+        "seriousness": "other",
+        "source": "site-b",
+    }
+    value.update(changes)
+    return value
+
+
+def show(label, fn):
+    try:
+        print(f"{label}: {fn()!r}")
+    except Exception as exc:  # noqa: BLE001
+        print(f"{label}: {type(exc).__name__}: {exc}")
+
+
+# 1. order independence across permutations of a multi-case fixture
+fixture = [
+    ev("R1", onset="2024-01-01T00:00:00Z"),
+    ev("F1", follow_up_of="R1", onset="2023-12-31T23:00:00-02:00", seriousness="fatal"),
+    ev("R2", subject_pseudonym="subject-002", event_code="SYNTH-02",
+       onset="2024-01-01T00:00:00Z"),
+    ev("F2", subject_pseudonym="subject-002", event_code="SYNTH-02",
+       follow_up_of="R2", uncertain=True, source="site-a"),
+]
+def canon(cases):
+    import json
+    return json.dumps(cases, sort_keys=True, separators=(",", ":"))
+
+
+outputs = set()
+for order in permutations(fixture):
+    outputs.add(canon(triage_events(list(order), now=NOW)))
+print("1. order-independent outputs:", len(outputs) == 1)
+for case in triage_events(fixture, now=NOW):
+    print("   ", case)
+
+# 2. branching: two children of one root
+show("2. branch merge", lambda: triage_events(
+    [
+        ev("A"),
+        ev("B", follow_up_of="A", source="site-a"),
+        ev("C", follow_up_of="A", source="site-c", uncertain=True),
+    ],
+    now=NOW,
+))
+
+# 3. cycles of various shapes and orders
+cyclic = [
+    ev("A", follow_up_of="C", onset="2024-01-01T00:00:00Z"),
+    ev("B", follow_up_of="A"),
+    ev("C", follow_up_of="B"),
+]
+codes = set()
+for order in permutations(cyclic):
+    try:
+        triage_events(list(order), now=NOW)
+        codes.add("NO-ERROR")
+    except ValueError as exc:
+        codes.add(str(exc))
+print("3. 3-cycle codes:", codes)
+show("3b. self cycle", lambda: triage_events(
+    [ev("A", follow_up_of="A")], now=NOW
+))
+show("3c. chain into cycle", lambda: triage_events(
+    [ev("Z", follow_up_of="A"), ev("A", follow_up_of="B"), ev("B", follow_up_of="A")],
+    now=NOW,
+))
+
+# 4. mixed subject vs mixed code, deep chain
+show("4a. mixed subject", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A", subject_pseudonym="subject-002")], now=NOW
+))
+show("4b. mixed code", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A", event_code="SYNTH-02"),
+     ev("C", follow_up_of="B", event_code="SYNTH-03")],
+    now=NOW,
+))
+
+# 5. seriousness precedence and deadlines
+for level in ("other", "hospitalization", "life_threatening", "fatal"):
+    case = triage_events(
+        [ev("A", seriousness=level, onset="2024-01-01T00:00:00Z")], now=NOW
+    )[0]
+    print(f"5. {level}: report_by={case['report_by']} overdue={case['overdue']}")
+
+show("5b. precedence across chain", lambda: triage_events(
+    [
+        ev("A", seriousness="hospitalization", onset="2024-01-01T00:00:00Z"),
+        ev("B", follow_up_of="A", seriousness="other", onset="2024-01-05T00:00:00Z"),
+        ev("C", follow_up_of="B", seriousness="life_threatening",
+           onset="2024-01-03T00:00:00Z"),
+    ],
+    now=NOW,
+))
+
+# 6. overdue boundaries: exactly at, one microsecond past, before
+base = [ev("A", seriousness="hospitalization", onset="2024-01-01T00:00:00Z")]
+report_by = datetime(2024, 1, 16, tzinfo=timezone.utc)
+for label, now in (
+    ("at", report_by),
+    ("after", report_by + timedelta(microseconds=1)),
+    ("before", report_by - timedelta(microseconds=1)),
+    ("zone-offset equal", datetime(2024, 1, 16, 2, 0, tzinfo=timezone(timedelta(hours=2)))),
+):
+    print(f"6. overdue {label}:", triage_events(base, now=now)[0]["overdue"])
+
+# 7. unknown seriousness variants
+for bad in ("severe", "FATAL", None, 3, "", " fatal "):
+    show(f"7. seriousness={bad!r}", lambda bad=bad: triage_events(
+        [ev("A", seriousness=bad)], now=NOW
+    ))
+
+# 8. invalid links / timestamps
+show("8a. empty parent", lambda: triage_events(
+    [ev("A", follow_up_of="")], now=NOW
+))
+show("8b. int parent", lambda: triage_events(
+    [ev("A", follow_up_of=7)], now=NOW
+))
+show("8c. deep missing root", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A"), ev("C", follow_up_of="nope")], now=NOW
+))
+show("8d. naive onset", lambda: triage_events(
+    [ev("A", onset="2024-01-01T00:00:00")], now=NOW
+))
+show("8e. bad onset", lambda: triage_events(
+    [ev("A", onset="not-a-date")], now=NOW
+))
+show("8f. datetime onset aware", lambda: triage_events(
+    [ev("A", onset=datetime(2024, 1, 1, tzinfo=timezone.utc))], now=NOW
+))
+show("8g. naive now", lambda: triage_events([ev("A")], now=datetime(2024, 1, 1)))
+show("8h. non-iterable events", lambda: triage_events(42, now=NOW))
+show("8i. non-mapping event", lambda: triage_events(["oops"], now=NOW))
+
+# 9. uncertainty handling
+show("9a. uncertain None", lambda: triage_events(
+    [ev("A", uncertain=None)], now=NOW
+))
+show("9b. uncertain 1", lambda: triage_events(
+    [ev("A", uncertain=1)], now=NOW
+))
+show("9c. uncertain yes", lambda: triage_events(
+    [ev("A", uncertain="yes")], now=NOW
+))
+show("9d. uncertain spread", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A", uncertain=True)], now=NOW
+))
+
+# 10. overflow near datetime max
+show("10a. report_by overflow", lambda: triage_events(
+    [ev("A", onset="9999-12-31T23:59:59+00:00", seriousness="fatal")], now=NOW
+))
+show("10b. onset overflow date", lambda: triage_events(
+    [ev("A", onset="10000-01-01T00:00:00Z")], now=NOW
+))
+
+# 11. microseconds preserved, offsets normalized
+show("11. micros", lambda: triage_events(
+    [ev("A", onset="2024-01-01T00:00:00.500000+05:30")], now=NOW
+))
+
+# 12. duplicate id where the second copy is malformed
+show("12a. dup then malformed", lambda: triage_events(
+    [ev("A"), ev("A", seriousness="nope")], now=NOW
+))
+show("12b. malformed then dup", lambda: triage_events(
+    [ev("A", seriousness="nope"), ev("A")], now=NOW
+))
+
+# 13. empty input
+show("13. empty", lambda: triage_events([], now=NOW))
+
+# 14. long chain + random shuffle stability
+long_chain = [ev(f"E{i}", follow_up_of=f"E{i-1}" if i else None,
+                 onset=f"2024-01-{10 - i:02d}T00:00:00Z") for i in range(9)]
+first = triage_events(long_chain, now=NOW)
+rng = Random(7)
+stable = all(
+    triage_events(rng.sample(long_chain, len(long_chain)), now=NOW) == first
+    for _ in range(20)
+)
+print("14. long chain shuffle stable:", stable, first[0]["event_ids"], first[0]["onset"])
