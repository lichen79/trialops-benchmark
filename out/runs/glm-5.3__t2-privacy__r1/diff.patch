+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Run one governed, pseudonymized export of fictional subject records.
+
+    The approved snapshot's purpose, the supplied secret, and the UTC date of
+    ``now`` are handed to :func:`export_subjects` exactly once, through the
+    governance executor callback. Governance failures surface before any
+    subject is consumed; export failures become ``EXECUTION_FAILED`` and leave
+    the approved request and its history untouched.
+    """
+
+    calls = {"count": 0}
+
+    def executor(approved_snapshot: Any) -> dict[str, Any]:
+        # Governance guarantees an approved snapshot here; the allowlist check
+        # is defensive so a governance regression cannot export under a purpose
+        # that was never approved.
+        purpose = (
+            approved_snapshot.get("purpose")
+            if isinstance(approved_snapshot, Mapping)
+            else None
+        )
+        if not isinstance(purpose, str) or not purpose:
+            raise ValueError("approved request has no purpose")
+        if calls["count"]:
+            raise ValueError("export already executed")
+        calls["count"] += 1
+        return export_subjects(
+            subjects,
+            purpose=purpose,
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    executed = apply_reuse_action(request, "execute", actor, now, executor=executor)
+
+    if not isinstance(executed, dict) or calls["count"] != 1:
+        raise ValueError("EXECUTION_FAILED")
+
+    export = executed.get("execution_result")
+    if not isinstance(export, dict) or set(export) != {"rows", "manifest"}:
+        raise ValueError("EXECUTION_FAILED")
+
+    return executed
 
 
