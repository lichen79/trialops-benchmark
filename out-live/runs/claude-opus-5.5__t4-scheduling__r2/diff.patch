+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: MutableMapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Check eligibility, plan visits, then atomically reserve capacity.
+
+    ``capacity`` is caller-owned and persists across calls. It is modified
+    only after eligibility and the whole plan succeed; only dates already
+    present are decremented and no new dates are ever inserted.
+    """
+    if not isinstance(capacity, MutableMapping):
+        raise TypeError("capacity must be a mutable mapping of dates to slots")
+
+    result = evaluate_subject(subject, protocol, on)
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(result["reasons"]))
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Stage every new value before touching the caller's mapping so the commit
+    # cannot leave a partial reservation behind. The local ISO date is the
+    # allocated visit day (fixture-zone DST gaps never cross midnight).
+    updates: dict[date, int] = {}
+    for visit in visits:
+        day = date.fromisoformat(str(visit["local"])[:10])
+        if day in capacity:
+            updates[day] = updates.get(day, capacity[day]) - 1
+    if any(value < 0 for value in updates.values()):
+        raise ValueError("UNSCHEDULABLE")  # defensive: plan_visits forbids this
+    for day, value in updates.items():
+        capacity[day] = value
+    return visits
