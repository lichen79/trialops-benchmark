+def _visit_day(local_iso: str) -> date:
+    """Recover the scheduled local calendar day from an ISO local string."""
+    return date.fromisoformat(local_iso[:10])
+
+
+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: Mapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate eligibility, then atomically reserve slots for a full plan.
+
+    ``capacity`` stays caller-owned: it is only read while planning and is
+    decremented after ``plan_visits`` returned a complete plan. Any failure
+    therefore leaves it exactly as it was, while slots taken by earlier
+    successful calls remain committed.
+    """
+
+    # Eligibility is decided first, so an ineligible subject never reaches the
+    # planner and never touches the caller's capacity mapping.
+    from trialops.eligibility import evaluate_subject
+
+    evaluation = evaluate_subject(subject, protocol, on)
+
+    if not evaluation.get("eligible"):
+        reasons = evaluation.get("reasons") or []
+        raise ValueError("INELIGIBLE:" + ",".join(str(reason) for reason in reasons))
+
+    if not isinstance(capacity, Mapping):
+        raise TypeError("capacity must be a mapping of dates to slots")
+
+    # Candidate generation, closures, DST handling, argument validation, and
+    # allocation between the visits of this plan all belong to the planner,
+    # which never mutates the capacity mapping it is given.
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Commit only now that the whole plan exists. Dates that the caller did
+    # not list stay unconstrained and are never added to the mapping.
+    for visit in visits:
+        visit_day = _visit_day(cast(str, visit["local"]))
+        if visit_day in capacity:
+            capacity[visit_day] = capacity[visit_day] - 1
 
     return visits
 
