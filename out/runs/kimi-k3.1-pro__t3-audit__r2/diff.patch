+def test_restore_and_continue_with_duplicate_index_and_deep_copy():
+    original = AuditChain()
+    append_event(original)
+    append_event(original, "event-2", AT + timedelta(seconds=1))
+    snapshot = deepcopy(original.records)
+    trusted_head = original.head()
+
+    restored = AuditChain.from_records(
+        snapshot, expected_head=trusted_head, expected_length=2
+    )
+
+    assert restored.records == snapshot
+    assert restored.records is not snapshot
+    assert restored.records[0] is not snapshot[0]
+    assert restored.records[0]["payload"] is not snapshot[0]["payload"]
+    snapshot[0]["payload"]["value"] = 99
+    assert restored.records[0]["payload"]["value"] == 1
+    assert restored.head() == trusted_head
+
+    with pytest.raises(ValueError, match="unique"):
+        append_event(restored, "event-1", AT + timedelta(seconds=2))
+
+    continued = append_event(restored, "event-3", AT + timedelta(seconds=2))
+    assert continued["sequence"] == 3
+    assert continued["previous_hash"] == trusted_head
+    assert restored.head() == continued["hash"]
+    assert restored.verify(restored.records) == []
+    assert len(original.records) == 2
+
+
+def test_restore_empty_snapshot_requires_genesis_anchors():
+    restored = AuditChain.from_records(
+        [], expected_head=GENESIS_HASH, expected_length=0
+    )
+    assert restored.records == []
+    assert restored.head() == GENESIS_HASH
+    assert append_event(restored)["sequence"] == 1
+
+    with pytest.raises(
+        ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH$"
+    ):
+        AuditChain.from_records(
+            [], expected_head="f" * 64, expected_length=1
+        )
+
+
+def test_restore_rejects_wrong_anchors_and_truncated_suffix():
+    chain = AuditChain()
+    append_event(chain)
+    append_event(chain, "event-2", AT + timedelta(seconds=1))
+    trusted_head = chain.head()
+
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH$"):
+        AuditChain.from_records(
+            chain.records, expected_head=GENESIS_HASH, expected_length=2
+        )
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:LENGTH_MISMATCH$"):
+        AuditChain.from_records(
+            chain.records, expected_head=trusted_head, expected_length=1
+        )
+    with pytest.raises(
+        ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH$"
+    ):
+        AuditChain.from_records(
+            chain.records[:1], expected_head=trusted_head, expected_length=2
+        )
+
+
+def test_restore_rejects_rehashed_edit_against_trusted_head():
+    chain = AuditChain()
+    append_event(chain)
+    trusted_head = chain.head()
+    edited = deepcopy(chain.records)
+    edited[0]["payload"]["value"] = 99
+    rehash(edited[0])
+
+    assert chain.verify(edited) == []
+    with pytest.raises(ValueError, match=r"^INVALID_CHAIN:HEAD_MISMATCH$"):
+        AuditChain.from_records(
+            edited, expected_head=trusted_head, expected_length=1
+        )
+
+
+def test_restored_instances_are_independent():
+    chain = AuditChain()
+    append_event(chain)
+    snapshot = deepcopy(chain.records)
+    anchors = {"expected_head": chain.head(), "expected_length": 1}
+    first = AuditChain.from_records(snapshot, **anchors)
+    second = AuditChain.from_records(snapshot, **anchors)
+
+    first_record = append_event(first, "event-2", AT + timedelta(seconds=1))
+    second_record = append_event(second, "event-2", AT + timedelta(seconds=1))
+
+    assert first_record["hash"] == second_record["hash"]
+    first.records[0]["payload"]["value"] = 99
+    assert second.records[0]["payload"]["value"] == 1
+    assert snapshot[0]["payload"]["value"] == 1
+
