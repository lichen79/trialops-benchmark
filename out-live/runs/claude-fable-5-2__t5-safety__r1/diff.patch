+# --- overdue boundaries -----------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("seriousness", "report_by"),
+    [
+        ("fatal", "2024-01-17T08:00:00Z"),
+        ("life_threatening", "2024-01-17T08:00:00Z"),
+        ("hospitalization", "2024-01-25T08:00:00Z"),
+        ("other", "2024-02-09T08:00:00Z"),
+    ],
+)
+def test_reporting_window_and_strict_overdue_boundary(seriousness, report_by):
+    events = [event("E1", seriousness=seriousness)]  # onset 2024-01-10T08:00:00Z
+    deadline = datetime.fromisoformat(report_by.replace("Z", "+00:00"))
+    tick = timedelta(microseconds=1)
+
+    [before] = triage_events(events, now=deadline - tick)
+    [at] = triage_events(events, now=deadline)
+    [after] = triage_events(events, now=deadline + tick)
+
+    assert before["report_by"] == at["report_by"] == after["report_by"] == report_by
+    assert before["overdue"] is False
+    assert at["overdue"] is False
+    assert after["overdue"] is True
+
+
+def test_overdue_is_decided_per_case():
+    events = [
+        event("LATE", seriousness="fatal"),
+        event("OPEN", subject_pseudonym="subject-002"),
+    ]
+
+    cases = triage_events(events, now=datetime(2024, 1, 20, tzinfo=timezone.utc))
+
+    assert [(case["case_id"], case["overdue"]) for case in cases] == [
+        ("LATE", True),
+        ("OPEN", False),
+    ]
+
