+def test_exclusions_match_by_exact_flag_name_in_protocol_order():
+    protocol = make_protocol()
+    protocol["exclusions"] = ["ZUL", "ALPHA", "MIDDLE"]
+    subject = make_subject()
+    subject["flags"] = ["ALPHABET", "ZUL", "MIDDLE"]
+
+    result = evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert result["reasons"] == ["EXCLUSION_ZUL", "EXCLUSION_MIDDLE"]
+    assert result["eligible"] is False
