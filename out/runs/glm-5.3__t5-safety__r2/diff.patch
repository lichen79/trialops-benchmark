+
+
+AWARE_NOW = datetime(2024, 6, 1, 12, 0, tzinfo=timezone.utc)
+
+
+def test_seriousness_precedence_escalates_whole_chain():
+    events = [
+        event("A1", seriousness="other", onset="2024-03-01T00:00:00Z"),
+        event(
+            "A2",
+            follow_up_of="A1",
+            seriousness="hospitalization",
+            onset="2024-03-04T00:00:00Z",
+        ),
+        event(
+            "A3",
+            follow_up_of="A2",
+            seriousness="life_threatening",
+            onset="2024-03-02T00:00:00Z",
+            source="site-a",
+            uncertain=True,
+        ),
+    ]
+
+    assert triage_events(events, now=datetime(2024, 3, 1, tzinfo=timezone.utc)) == [
+        {
+            "case_id": "A1",
+            "subject_pseudonym": "subject-001",
+            "event_code": "SYNTH-01",
+            "onset": "2024-03-01T00:00:00Z",
+            "seriousness": "life_threatening",
+            "report_by": "2024-03-08T00:00:00Z",
+            "sources": ["site-a", "site-b"],
+            "event_ids": ["A1", "A2", "A3"],
+            "uncertain": True,
+            "overdue": False,
+        }
+    ]
+
+
+def test_fatal_outranks_every_other_level():
+    events = [
+        event("B1", seriousness="fatal", onset="2024-03-01T00:00:00Z"),
+        event(
+            "B2",
+            follow_up_of="B1",
+            seriousness="life_threatening",
+            onset="2024-02-15T00:00:00Z",
+        ),
+    ]
+
+    case = triage_events(events, now=datetime(2024, 2, 15, tzinfo=timezone.utc))[0]
+    assert case["seriousness"] == "fatal"
+    assert case["onset"] == "2024-02-15T00:00:00Z"
+    assert case["report_by"] == "2024-02-22T00:00:00Z"
+
+
+@pytest.mark.parametrize(
+    ("seriousness", "report_by"),
+    [
+        ("fatal", "2024-03-08T00:00:00Z"),
+        ("life_threatening", "2024-03-08T00:00:00Z"),
+        ("hospitalization", "2024-03-16T00:00:00Z"),
+        ("other", "2024-03-31T00:00:00Z"),
+    ],
+)
+def test_reporting_window_follows_highest_seriousness(seriousness, report_by):
+    events = [
+        event("R1", seriousness="other", onset="2024-03-01T00:00:00Z"),
+        event(
+            "R2",
+            follow_up_of="R1",
+            seriousness=seriousness,
+            onset="2024-03-05T00:00:00Z",
+        ),
+    ]
+
+    case = triage_events(events, now=datetime(2024, 3, 1, tzinfo=timezone.utc))[0]
+    assert case["seriousness"] == seriousness
+    assert case["report_by"] == report_by
+
+
+def test_overdue_boundary_is_strict():
+    events = [event("A", seriousness="fatal", onset="2024-01-10T00:00:00Z")]
+    report_by = datetime(2024, 1, 17, tzinfo=timezone.utc)
+
+    def overdue(now):
+        return triage_events(events, now=now)[0]["overdue"]
+
+    assert overdue(report_by) is False
+    assert overdue(report_by - timedelta(microseconds=1)) is False
+    assert overdue(report_by + timedelta(microseconds=1)) is True
+    # An equivalent instant expressed in another zone is still not overdue.
+    assert overdue(datetime(2024, 1, 17, 5, tzinfo=timezone(timedelta(hours=5)))) is False
+    assert overdue(datetime(2024, 1, 16, 19, tzinfo=timezone(timedelta(hours=-5)))) is False
+
+
+def test_offsets_normalize_to_earliest_utc_onset():
+    events = [
+        event("F1", onset="2024-01-10T10:00:00+02:00"),
+        event("F2", follow_up_of="F1", onset="2024-01-10T02:00:00-05:00"),
+    ]
+
+    case = triage_events(events, now=datetime(2024, 1, 1, tzinfo=timezone.utc))[0]
+    assert case["onset"] == "2024-01-10T07:00:00Z"
+    assert case["report_by"] == "2024-02-09T07:00:00Z"
+
+
+def test_deadline_clock_starts_at_earliest_onset():
+    events = [
+        event("F1", seriousness="hospitalization", onset="2024-01-12T00:00:00Z"),
+        event("F2", follow_up_of="F1", seriousness="other", onset="2024-01-10T00:00:00Z"),
+    ]
+
+    case = triage_events(events, now=datetime(2024, 1, 25, tzinfo=timezone.utc))[0]
+    assert case["onset"] == "2024-01-10T00:00:00Z"
+    assert case["report_by"] == "2024-01-25T00:00:00Z"
+    assert case["overdue"] is False
+    later = triage_events(
+        events, now=datetime(2024, 1, 25, 0, 0, 0, 1, tzinfo=timezone.utc)
+    )[0]
+    assert later["overdue"] is True
+
+
+def test_input_order_does_not_change_results():
+    events = [
+        event("A1", onset="2024-02-01T00:00:00Z", uncertain=True),
+        event(
+            "A2",
+            follow_up_of="A1",
+            onset="2024-02-03T00:00:00Z",
+            seriousness="hospitalization",
+            source="site-a",
+        ),
+        event("B1", subject_pseudonym="subject-002", onset="2024-01-15T00:00:00Z", source="site-c"),
+        event(
+            "B2",
+            subject_pseudonym="subject-002",
+            follow_up_of="B1",
+            onset="2024-01-14T00:00:00Z",
+            seriousness="fatal",
+            source="site-a",
+        ),
+    ]
+    now = datetime(2024, 3, 1, tzinfo=timezone.utc)
+    reference = triage_events(events, now=now)
+
+    assert [case["case_id"] for case in reference] == ["B1", "A1"]
+    for permutation in permutations(events):
+        assert triage_events(permutation, now=now) == reference
+
+
+def test_sibling_followups_merge_into_one_case():
+    events = [
+        event("A1"),
+        event("A2", follow_up_of="A1", source="site-a"),
+        event("A3", follow_up_of="A1", source="site-c", uncertain=True),
+    ]
+
+    case = triage_events(events, now=AWARE_NOW)[0]
+    assert case["case_id"] == "A1"
+    assert case["event_ids"] == ["A1", "A2", "A3"]
+    assert case["sources"] == ["site-a", "site-b", "site-c"]
+    assert case["uncertain"] is True
+
+
+def test_duplicate_root_ids_are_rejected():
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [event("A1"), event("A2", follow_up_of="A1"), event("A1", source="site-a")],
+            now=AWARE_NOW,
+        )
+
+
+def test_mixed_subject_pseudonym_is_rejected():
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [event("A"), event("B", follow_up_of="A", subject_pseudonym="subject-002")],
+            now=AWARE_NOW,
+        )
+
+
+def test_self_link_and_longer_cycles_are_rejected():
+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events(
+            [event("A", follow_up_of="A")],
+            now=AWARE_NOW,
