+def test_signed_and_purge_boundaries_are_inclusive():
+    future = make_subject("future")
+    future["consents"][0]["signed_on"] = "2024-06-16"
+    other_purpose = make_subject("other")
+    other_purpose["consents"][0]["purpose"] = "marketing"
+    edge = make_subject("edge", purge_after="2024-06-15")
+    result = export_subjects(
+        [future, other_purpose, edge], purpose="research", secret="test-secret", on=ON
+    )
+    assert [row["pseudonym"] for row in result["rows"]] == [pseudonym("edge")]
+
+
+def test_output_is_deterministic_and_order_independent():
+    subjects = [make_subject(f"s{i}") for i in range(5)]
+    first = export_subjects(subjects, purpose="research", secret="test-secret", on=ON)
+    second = export_subjects(
+        list(reversed(deepcopy(subjects))), purpose="research", secret="test-secret", on=ON
+    )
+    assert first == second
+    assert canonical(first) == canonical(second)
+    other = export_subjects(subjects, purpose="research", secret="other-secret", on=ON)
+    assert other["rows"][0]["pseudonym"] not in {r["pseudonym"] for r in first["rows"]}
+
+
+def test_canonical_hash_uses_utf8_without_ascii_escaping():
+    result = export_subjects(
+        [make_subject("s1", country="Åland")],
+        purpose="research",
+        secret="test-secret",
+        on=ON,
+    )
+    expected = hashlib.sha256(canonical(result["rows"]).encode("utf-8")).hexdigest()
+    assert "Åland" in canonical(result["rows"])
+    assert result["manifest"]["sha256"] == expected
+
+
