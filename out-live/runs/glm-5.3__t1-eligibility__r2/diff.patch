+from datetime import date, datetime
+
+from trialops.eligibility import evaluate_subject
+
+protocol = {
+    "min_age": 18,
+    "max_age": 30,
+    "required_consent_version": "v2",
+    "consent_valid_from": "2024-01-01",
+    "labs": {"A": [1, 3]},
+    "exclusions": ["DO_NOT_ENROLL"],
+}
+
+subject = {
+    "birth_date": "2000-06-15",
+    "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+    "labs": {"A": 2},
+    "flags": [],
+}
+
+print("py date.fromisoformat('2024-06-15T00:00:00') ->", end=" ")
+try:
+    print(repr(date.fromisoformat("2024-06-15T00:00:00")))
+except Exception as exc:
+    print(type(exc).__name__, exc)
+print("py date.fromisoformat('20240615') ->", repr(date.fromisoformat("20240615")))
+
+
+def probe(label, fn):
+    try:
+        print(label, "->", fn())
+    except Exception as exc:
+        print(label, "->", type(exc).__name__, exc)
+
+
+probe("on datetime", lambda: evaluate_subject(subject, protocol, datetime(2024, 6, 15)))
+probe(
+    "birth_date with time",
+    lambda: evaluate_subject({**subject, "birth_date": "2000-06-15T00:00:00"}, protocol, date(2024, 6, 15)),
+)
+probe(
+    "min_age float",
+    lambda: evaluate_subject(subject, {**protocol, "min_age": 18.0}, date(2024, 6, 15)),
+)
+probe(
+    "protocol labs tuple bounds",
+    lambda: evaluate_subject(subject, {**protocol, "labs": {"A": (1, 3)}}, date(2024, 6, 15)),
+)
+probe(
+    "protocol labs unknown-name",
+    lambda: evaluate_subject(subject, {"min_age": 18, "max_age": 30, "required_consent_version": "v2", "consent_valid_from": "2024-01-01", "labs": {}, "exclusions": []}, date(2024, 6, 15)),
+)
+probe("no consents", lambda: evaluate_subject({**subject, "consents": []}, protocol, date(2024, 6, 15)))
+probe(
+    "consent signed after on",
+    lambda: evaluate_subject({**subject, "consents": [{"version": "v2", "signed_on": "2025-01-01"}]}, protocol, date(2024, 6, 15)),
+)
+probe(
+    "consent tie same date",
+    lambda: evaluate_subject(
+        {**subject, "consents": [{"version": "v2", "signed_on": "2024-06-15"}, {"version": "v1", "signed_on": "2024-06-15"}]},
+        protocol,
+        date(2024, 6, 15),
+    ),
+)
+probe(
+    "subject not mapping",
+    lambda: evaluate_subject("nope", protocol, date(2024, 6, 15)),
+)
+probe("protocol missing labs", lambda: evaluate_subject(subject, {k: v for k, v in protocol.items() if k != "labs"}, date(2024, 6, 15)))
+probe("protocol missing exclusions", lambda: evaluate_subject(subject, {k: v for k, v in protocol.items() if k != "exclusions"}, date(2024, 6, 15)))
+probe("subject missing flags", lambda: evaluate_subject({k: v for k, v in subject.items() if k != "flags"}, protocol, date(2024, 6, 15)))
+probe(
+    "subject labs str value",
+    lambda: evaluate_subject({**subject, "labs": {"A": "2"}}, protocol, date(2024, 6, 15)),
+)
+probe(
+    "future birth date",
+    lambda: evaluate_subject({**subject, "birth_date": "2030-01-01"}, protocol, date(2024, 6, 15)),
+)
