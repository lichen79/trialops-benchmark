+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request with its purpose-scoped export."""
+
+    def executor(approved: Mapping[str, Any]) -> dict[str, Any]:
+        purpose = approved.get("purpose")
+        if not isinstance(purpose, str):
+            # Governance normally rejects this first; keep failures generic if
+            # the integration is ever supplied a different implementation.
+            raise ValueError("INVALID_PURPOSE")
+        # apply_reuse_action validates now before invoking this callback.
+        on = now.astimezone(timezone.utc).date()
+        return export_subjects(subjects, purpose=purpose, secret=secret, on=on)
+
+    return apply_reuse_action(
+        request, "execute", actor, now, executor=executor
+    )
 
