+def test_stale_approval_never_reaches_the_executor_and_can_only_expire():
+    approved = apply_reuse_action(request("submitted"), "approve", "bob", NOW)
+    assert approved["approval_expires_on"] == "2025-01-31"
+    stale_now = NOW + timedelta(days=31)
+
+    assert_rejected_atomically(
+        approved, "execute", "alice", "APPROVAL_EXPIRED", now=stale_now
+    )
+
+    expired = apply_reuse_action(approved, "expire", "system", stale_now)
+    assert expired["status"] == "expired"
+    assert_rejected_atomically(
+        expired, "execute", "alice", "INVALID_STATE", now=stale_now
+    )
+    assert [entry["action"] for entry in expired["history"]] == ["approve", "expire"]
+
