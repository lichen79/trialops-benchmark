+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request by exporting its pseudonymized rows.
+
+    Authorization, state, approval and policy checks belong to the governance
+    workflow and all run before the executor, so ``subjects`` is only consumed
+    for a request that may be executed. Any export failure surfaces as the
+    governance ``EXECUTION_FAILED`` error and leaves ``request`` untouched.
+    """
+
+    def executor(approved_request: dict[str, object]) -> dict[str, Any]:
+        # Governance has already validated ``now`` as timezone-aware here.
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
