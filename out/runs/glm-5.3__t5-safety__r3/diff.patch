+"""More probes: extreme offsets, unicode, and error-message stability."""
+
+from datetime import datetime, timedelta, timezone
+
+from trialops.safety import triage_events
+
+NOW = datetime(2024, 6, 1, tzinfo=timezone.utc)
+
+
+def ev(event_id, **changes):
+    value = {
+        "event_id": event_id,
+        "subject_pseudonym": "subject-001",
+        "event_code": "SYNTH-01",
+        "onset": "2024-01-10T10:00:00+02:00",
+        "seriousness": "other",
+        "source": "site-b",
+    }
+    value.update(changes)
+    return value
+
+
+def show(label, fn):
+    try:
+        print(f"{label}: {fn()!r}")
+    except Exception as exc:  # noqa: BLE001
+        print(f"{label}: {type(exc).__name__}: {exc}")
+
+
+# extreme offsets near datetime bounds
+show("a. near-max offset overflow", lambda: triage_events(
+    [ev("A", onset="9999-12-31T23:59:59-05:00")], now=NOW
+))
+show("b. near-min offset overflow", lambda: triage_events(
+    [ev("A", onset="0001-01-01T00:00:00+05:00")], now=NOW
+))
+show("c. min onset ok", lambda: triage_events(
+    [ev("A", onset="0001-01-01T00:00:00+00:00")], now=NOW
+))
+# lowercase z / space separator / fractional seconds
+show("d. lowercase z", lambda: triage_events(
+    [ev("A", onset="2024-01-10T10:00:00z")], now=NOW
+))
+show("e. space separator", lambda: triage_events(
+    [ev("A", onset="2024-01-10 10:00:00+02:00")], now=NOW
+))
+# unicode identifiers and sources
+show("f. unicode ids", lambda: triage_events(
+    [ev("É-2", follow_up_of="É-1"), ev("É-1", source="sïte-ünïcode")], now=NOW
+))
+# error messages must not leak identifiers
+show("g. missing root message", lambda: triage_events(
+    [ev("secret-id-1", follow_up_of="secret-id-2")], now=NOW
+))
+# now with unusual tzinfo
+show("h. now in +05:45", lambda: triage_events(
+    [ev("A", onset="2024-01-01T00:00:00Z", seriousness="fatal")],
+    now=datetime(2024, 1, 8, 5, 45, tzinfo=timezone(timedelta(hours=5, minutes=45))),
+))
+show("i. now exactly onset+7 in non-utc zone", lambda: triage_events(
+    [ev("A", onset="2024-01-01T00:00:00Z", seriousness="fatal")],
+    now=datetime(2024, 1, 8, 6, 0, tzinfo=timezone(timedelta(hours=6))),
+)[0]["overdue"])
+# generator input and tuple input
+show("j. generator input", lambda: triage_events(
+    (ev("A") for _ in range(1)), now=NOW
+))
+show("k. tuple of events", lambda: triage_events(
+    (ev("A"), ev("B", follow_up_of="A")), now=NOW
+))
+# duplicate root id appearing in two separate chains
+show("l. same id in two chains", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A"), ev("A", source="site-z")], now=NOW
+))
+# mixed-case where root itself differs but grandchildren match root
+show("m. mixed mid-chain", lambda: triage_events(
+    [ev("A"), ev("B", follow_up_of="A", subject_pseudonym="subject-002"),
+     ev("C", follow_up_of="B", subject_pseudonym="subject-001")], now=NOW
+))
