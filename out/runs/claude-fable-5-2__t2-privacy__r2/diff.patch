+def make_request(status="approved", **changes):
+    purpose = changes.get("purpose", "research")
+    value = {
+        "id": "reuse-001",
+        "requester": "alice",
+        "reviewer": "bob",
+        "purpose": purpose,
+        "status": status,
+        "retention_until": "2024-12-31",
+        "approval_expires_on": "2024-06-30",
+        "privacy_plan": {
+            "algorithm": "hmac-sha256",
+            "domain": purpose,
+            "fields": ["pseudonym", "country", "birth_year", "visits"],
+        },
+        "metadata": {
+            "representative": True,
+            "complete": True,
+            "quality_score": 0.99,
+        },
+        "history": [],
+    }
+    value.update(changes)
+    return value
+
+
+def exception_chain_messages(error):
+    """Messages of an exception and everything chained behind it."""
+    messages = []
+    pending = [error]
+    seen = set()
+    while pending:
+        current = pending.pop()
+        if current is None or id(current) in seen:
+            continue
+        seen.add(id(current))
+        messages.append(str(current))
+        pending.extend([current.__cause__, current.__context__])
+    return messages
+
+
