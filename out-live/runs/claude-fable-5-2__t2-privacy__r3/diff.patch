+def make_request(status="approved", **changes):
+    purpose = changes.get("purpose", REUSE_PURPOSE)
+    value = {
+        "id": "reuse-001",
+        "requester": "alice",
+        "reviewer": "bob",
+        "purpose": purpose,
+        "status": status,
+        "retention_until": "2025-06-30",
+        "privacy_plan": {
+            "algorithm": "hmac-sha256",
+            "domain": purpose,
+            "fields": ["pseudonym", "country", "birth_year", "visits"],
+        },
+        "metadata": {
+            "representative": True,
+            "complete": True,
+            "quality_score": 0.95,
+        },
+        "history": [],
+    }
+    if status == "approved":
+        value["approval_expires_on"] = "2025-02-01"
+    value.update(changes)
+    return value
+
+
+def make_reuse_subject(subject_id, **changes):
+    return make_subject(
+        subject_id,
+        **{
+            "consents": [{"purpose": REUSE_PURPOSE, "signed_on": "2024-11-20"}],
+            "purge_after": "2031-03-09",
+            **changes,
+        },
+    )
+
+
+def make_reuse_subjects():
+    return [
+        make_reuse_subject("reuse-subject-b"),
+        make_reuse_subject("reuse-subject-a", country="AU"),
+        make_reuse_subject(
+            "reuse-subject-c",
+            consents=[{"purpose": "another purpose", "signed_on": "2024-11-20"}],
+        ),
+    ]
