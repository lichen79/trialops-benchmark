+def test_stale_approvals_are_checked_before_the_executor_runs():
+    stale = request("approved", approval_expires_on="2024-12-31")
+    snapshot = deepcopy(stale)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(ValueError, match="APPROVAL_EXPIRED"):
+        apply_reuse_action(stale, "execute", "alice", NOW, executor)
+    assert calls == []
+    assert stale == snapshot
+
+    retention_passed = request(
+        "approved", approval_expires_on="2025-02-01", retention_until="2024-12-31"
+    )
+    with pytest.raises(ValueError, match="RETENTION_EXPIRED"):
+        apply_reuse_action(retention_passed, "execute", "alice", NOW, executor)
+    assert calls == []
+    assert retention_passed["status"] == "approved"
+
+    # Same-day deadlines are still valid: expiry is strictly in the future.
+    boundary = request("approved", approval_expires_on="2025-01-01")
+    assert apply_reuse_action(
+        boundary, "execute", "alice", NOW, executor
+    )["status"] == "executed"
+    assert len(calls) == 1
+
