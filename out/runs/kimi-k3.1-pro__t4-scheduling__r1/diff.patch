+def book_subject_visits(
+    subject,
+    protocol,
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate a subject and atomically reserve all returned visit days.
+
+    Planning uses a private capacity snapshot. The caller-owned dictionary is
+    updated only after eligibility and the complete plan have succeeded.
+    """
+    evaluation = evaluate_subject(subject, protocol, on)
+    if not evaluation["eligible"]:
+        raise ValueError("INELIGIBLE: " + ", ".join(evaluation["reasons"]))
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to slots")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    used_slots: dict[date, int] = {}
+    for visit in visits:
+        visit_day = date.fromisoformat(visit["local"][:10])
+        if visit_day in capacity:
+            used_slots[visit_day] = used_slots.get(visit_day, 0) + 1
+
+    updated_slots = [
+        (visit_day, capacity[visit_day] - used)
+        for visit_day, used in used_slots.items()
+    ]
+    for visit_day, slots in updated_slots:
+        capacity[visit_day] = slots
 
     return visits
 
