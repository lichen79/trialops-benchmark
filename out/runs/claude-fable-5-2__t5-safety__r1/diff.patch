+@pytest.mark.parametrize(
+    ("levels", "expected", "days"),
+    [
+        (["other"], "other", 30),
+        (["hospitalization"], "hospitalization", 15),
+        (["life_threatening"], "life_threatening", 7),
+        (["fatal"], "fatal", 7),
+        (["other", "hospitalization"], "hospitalization", 15),
+        (["hospitalization", "life_threatening", "other"], "life_threatening", 7),
+        (["life_threatening", "fatal", "hospitalization", "other"], "fatal", 7),
+    ],
+)
+def test_seriousness_precedence_sets_deadline_with_strict_overdue_boundary(
+    levels, expected, days
+):
+    onset = datetime(2024, 3, 1, 12, 0, tzinfo=timezone.utc)
+    # Follow-ups carry later onsets: the clock must stay on the earliest one.
+    events = [event("E0", onset="2024-03-01T12:00:00Z", seriousness=levels[0])]
+    events += [
+        event(
+            f"E{index}",
+            follow_up_of=f"E{index - 1}",
+            onset="2024-03-05T12:00:00Z",
+            seriousness=level,
+        )
+        for index, level in enumerate(levels[1:], start=1)
+    ]
+    report_by = onset + timedelta(days=days)
+    tick = timedelta(microseconds=1)
+
+    for ordering in (events, events[::-1]):
+        [case] = triage_events(ordering, now=report_by)
+        assert case["seriousness"] == expected
+        assert case["onset"] == "2024-03-01T12:00:00Z"
+        assert case["report_by"] == report_by.isoformat().replace("+00:00", "Z")
+        assert case["overdue"] is False
+
+    assert triage_events(events, now=report_by - tick)[0]["overdue"] is False
+    assert triage_events(events, now=report_by + tick)[0]["overdue"] is True
+
