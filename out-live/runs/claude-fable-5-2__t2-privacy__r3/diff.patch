+def test_end_to_end_reuse_workflow_executes_the_pseudonymized_export():
+    subjects = make_reuse_subjects()
+    original_subjects = deepcopy(subjects)
+    draft = make_request("draft")
+
+    submitted = apply_reuse_action(draft, "submit", "alice", NOW)
+    approved = apply_reuse_action(submitted, "approve", "bob", NOW + timedelta(hours=1))
+    approved_snapshot = deepcopy(approved)
+    executed_at = NOW + timedelta(days=2)
+
+    executed = execute_reuse_export(
+        approved, subjects, actor="alice", secret=REUSE_SECRET, now=executed_at
+    )
+
+    expected_export = export_subjects(
+        subjects, purpose=REUSE_PURPOSE, secret=REUSE_SECRET, on=date(2025, 1, 3)
+    )
+    assert expected_export["manifest"]["count"] == 2
+    assert executed["execution_result"] == expected_export
+    assert [row["pseudonym"] for row in executed["execution_result"]["rows"]] == sorted(
+        pseudonym(subject_id, purpose=REUSE_PURPOSE, secret=REUSE_SECRET)
+        for subject_id in ("reuse-subject-a", "reuse-subject-b")
+    )
+
+    # The complete executed request is returned, not just the export.
+    assert executed == {
+        **approved_snapshot,
+        "status": "executed",
+        "execution_result": expected_export,
+        "history": approved_snapshot["history"]
+        + [{"action": "execute", "actor": "alice", "at": "2025-01-03T12:00:00Z"}],
+    }
+    assert [entry["action"] for entry in executed["history"]] == [
+        "submit",
+        "approve",
+        "execute",
+    ]
+
+    # Inputs are untouched and nothing sensitive reaches the request or history.
+    assert approved == approved_snapshot
+    assert subjects == original_subjects
+    serialized = canonical(executed)
+    for identifier in DIRECT_IDENTIFIERS:
+        assert identifier not in serialized
+    for row in executed["execution_result"]["rows"]:
+        assert set(row) == {"pseudonym", "country", "birth_year", "visits"}
