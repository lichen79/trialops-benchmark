+def test_failed_actions_are_atomic(status, action, actor, error, code):
+    candidate = request(
+        status,
+        approval_expires_on="2025-02-01",
+        history=[{"action": "imported", "actor": "system", "at": "2024-12-01T00:00:00Z"}],
+    )
+    snapshot = deepcopy(candidate)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(error) as caught:
+        apply_reuse_action(candidate, action, actor, NOW, executor)
+    if code is not None:
+        assert str(caught.value) == code
+    assert calls == []
+    assert candidate == snapshot
+
