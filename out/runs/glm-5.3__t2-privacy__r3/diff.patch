+def test_fromisoformat_behaviour():
+    print(sys.version)
+    candidates = [
+        "2024-06-15",
+        "20240615",
+        "2024-W24-1",
+        "2024-06-15T00:00:00",
+        "2024-06-15T00:00:00Z",
+        "2024-6-15",
+        "2024-06-15 ",
+        " 2024-06-15",
+        "2024-06-15\n",
+        "0001-01-01",
+        "9999-12-31",
+        "10000-01-01",
+    ]
+    for value in candidates:
+        try:
+            parsed = date.fromisoformat(value)
+        except (ValueError, TypeError) as exc:
+            parsed = f"REJECT ({type(exc).__name__})"
+        print(repr(value), "->", repr(parsed))
+
+
+def test_regex_fullmatch():
+    pattern = re.compile(r"[A-Za-z0-9_-]+\Z")
+    for value in ["abc", "abc\n", "AZaz09_-", "unicode-é", "a b", ""]:
+        print(repr(value), pattern.fullmatch(value))
