+UTC_NOW = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+
+def test_input_order_does_not_affect_output():
+    from itertools import permutations
+
+    base = [
+        event("R", onset="2024-03-01T12:00:00+05:00"),
+        event("F1", follow_up_of="R", onset="2024-03-05T00:00:00Z", source="site-c"),
+        event(
+            "F2",
+            follow_up_of="F1",
+            onset="2024-03-06T00:00:00Z",
+            seriousness="life_threatening",
+            uncertain=True,
+        ),
+        event("S", subject_pseudonym="subject-002", onset="2024-02-01T00:00:00Z"),
+    ]
+    expected = triage_events(base, now=UTC_NOW)
+    for ordering in permutations(base):
+        assert triage_events(list(ordering), now=UTC_NOW) == expected
+    assert [case["case_id"] for case in expected] == ["S", "R"]
+    merged = expected[1]
+    assert merged["event_ids"] == ["F1", "F2", "R"]
+    assert merged["sources"] == ["site-b", "site-c"]
+    assert merged["uncertain"] is True
+    assert merged["seriousness"] == "life_threatening"
+
+
+def test_deadline_uses_earliest_onset_not_followup_arrival():
+    # The follow-up is reported later and upgrades seriousness; the clock still
+    # runs from the root's (earlier) onset.
+    cases = triage_events(
+        [
+            event("R", onset="2024-05-01T00:00:00Z"),
+            event(
+                "F",
+                follow_up_of="R",
+                onset="2024-05-20T00:00:00Z",
+                seriousness="hospitalization",
+            ),
+        ],
+        now=UTC_NOW,
+    )
+    assert cases[0]["onset"] == "2024-05-01T00:00:00Z"
+    assert cases[0]["report_by"] == "2024-05-16T00:00:00Z"
+
+
+@pytest.mark.parametrize(
+    "levels, expected, days",
+    [
+        (["other"], "other", 30),
+        (["other", "hospitalization"], "hospitalization", 15),
+        (["hospitalization", "life_threatening", "other"], "life_threatening", 7),
+        (["life_threatening", "fatal", "hospitalization"], "fatal", 7),
+        (["fatal", "other"], "fatal", 7),
+    ],
+)
+def test_seriousness_precedence_and_windows(levels, expected, days):
+    events = [event("E0", seriousness=levels[0], onset="2024-01-01T00:00:00Z")]
+    for index, level in enumerate(levels[1:], start=1):
+        events.append(event(f"E{index}", follow_up_of=f"E{index - 1}", seriousness=level))
+    [case] = triage_events(events, now=UTC_NOW)
+    assert case["seriousness"] == expected
+    assert case["report_by"] == f"2024-01-{1 + days:02d}T00:00:00Z"
+
+
+def test_overdue_boundary_is_strict():
+    events = [event("A", onset="2024-01-01T00:00:00Z", seriousness="fatal")]
+    report_by = datetime(2024, 1, 8, tzinfo=timezone.utc)
+    assert triage_events(events, now=report_by)[0]["overdue"] is False
+    assert triage_events(events, now=report_by - report_by.resolution)[0]["overdue"] is False
+    assert triage_events(events, now=report_by + report_by.resolution)[0]["overdue"] is True
+    # The same instant in another offset is still equality, not overdue.
+    from datetime import timedelta
+
+    shifted = report_by.astimezone(timezone(timedelta(hours=-5)))
+    assert triage_events(events, now=shifted)[0]["overdue"] is False
+
+
+def test_duplicate_root_ids_rejected_regardless_of_order():
+    events = [
+        event("R"),
+        event("F", follow_up_of="R"),
+        event("R", source="site-z"),
+    ]
+    for ordering in (events, list(reversed(events))):
+        with pytest.raises(ValueError, match="^DUPLICATE_EVENT_ID$"):
+            triage_events(ordering, now=UTC_NOW)
+
+
+def test_self_link_and_longer_cycles_are_rejected():
+    with pytest.raises(ValueError, match="^FOLLOW_UP_CYCLE$"):
+        triage_events([event("A", follow_up_of="A")], now=UTC_NOW)
+    with pytest.raises(ValueError, match="^FOLLOW_UP_CYCLE$"):
+        triage_events(
+            [
+                event("Root"),
+                event("A", follow_up_of="C"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B"),
+                event("D", follow_up_of="C"),
+            ],
+            now=UTC_NOW,
+        )
+
+
+def test_mixed_subject_or_code_deeper_in_chain_is_rejected():
+    with pytest.raises(ValueError, match="^MIXED_CASE$"):
+        triage_events(
+            [
+                event("C", follow_up_of="B", subject_pseudonym="subject-999"),
+                event("B", follow_up_of="A"),
+                event("A"),
+            ],
+            now=UTC_NOW,
+        )
+    with pytest.raises(ValueError, match="^MIXED_CASE$"):
+        triage_events(
+            [event("A"), event("B", follow_up_of="A"), event("C", follow_up_of="B", event_code="X")],
+            now=UTC_NOW,
+        )
+
+
+def test_unknown_seriousness_and_bad_fields_are_rejected():
+    with pytest.raises(ValueError, match="^INVALID_SERIOUSNESS$"):
+        triage_events([event("A", seriousness="severe")], now=UTC_NOW)
+    with pytest.raises(ValueError, match="^INVALID_SERIOUSNESS$"):
+        triage_events([event("A", seriousness="FATAL")], now=UTC_NOW)
+    with pytest.raises(ValueError, match="^INVALID_UNCERTAIN$"):
+        triage_events([event("A", uncertain="yes")], now=UTC_NOW)
+    with pytest.raises(ValueError, match="^INVALID_NOW$"):
+        triage_events([], now="2024-01-01T00:00:00Z")
+
+
+def test_error_code_is_independent_of_order():
+    bad = [
+        event("A", seriousness="severe"),
+        event("B", onset="2024-01-01T00:00:00"),
+        event("B"),
+        event("B"),
+    ]
+    codes = set()
+    for ordering in (bad, list(reversed(bad)), bad[1:] + bad[:1]):
+        with pytest.raises(ValueError) as info:
+            triage_events(ordering, now=UTC_NOW)
+        codes.add(str(info.value))
+    assert len(codes) == 1
+
+
+def test_output_carries_no_diagnosis_fields():
+    [case] = triage_events([event("A", diagnosis="ignored")], now=UTC_NOW)
+    assert set(case) == {
+        "case_id",
+        "subject_pseudonym",
+        "event_code",
+        "onset",
+        "seriousness",
+        "report_by",
+        "sources",
+        "event_ids",
+        "uncertain",
+        "overdue",
+    }
+    assert case["uncertain"] is False
+
+
 def test_naive_now_and_onset_are_rejected():
     with pytest.raises(ValueError, match="INVALID_NOW"):
         triage_events([], now=datetime(2024, 1, 1))
