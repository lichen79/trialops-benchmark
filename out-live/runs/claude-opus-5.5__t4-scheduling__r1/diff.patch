+def test_multi_visit_capacity_inclusive_boundary_and_wall_time_preserved():
+    capacity = {date(2024, 3, 10): 1, date(2024, 3, 11): 0}
+    visits = plan_visits(
+        first_day=date(2024, 2, 10),
+        offsets_months=[1, 2, 0],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+    assert [v["offset_months"] for v in visits] == [1, 2, 0]
+    assert [v["local"] for v in visits] == [
+        "2024-03-10T03:30:00-04:00",
+        "2024-04-10T02:30:00-04:00",
+        "2024-02-10T02:30:00-05:00",
+    ]
+    assert capacity == {date(2024, 3, 10): 1, date(2024, 3, 11): 0}
+
+    # Second visit competing for the same exhausted day moves past the
+    # zero-capacity day, keeping the original wall time.
+    visits = plan_visits(
+        first_day=date(2024, 3, 10),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+        capacity={date(2024, 3, 10): 0, date(2024, 3, 11): 0},
+    )
+    assert visits[0]["local"] == "2024-03-12T02:30:00-04:00"
+
+
