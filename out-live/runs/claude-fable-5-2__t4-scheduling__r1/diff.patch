+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Plan visits for an eligible subject and reserve their capacity slots.
+
+    ``capacity`` is only modified after eligibility and planning have both
+    succeeded; any failure leaves it exactly as it was. Only dates already
+    present are decremented, so unlisted dates stay unconstrained.
+    """
+    evaluation = evaluate_subject(subject, protocol, on)
+    if not evaluation["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(evaluation["reasons"]))
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to slots")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Work out every new value before writing any of them, so the commit
+    # below cannot stop halfway through.
+    updated: dict[date, int] = {}
+    for visit in visits:
+        visit_day = date.fromisoformat(str(visit["local"])[:10])
+        if visit_day in capacity:
+            slots = updated.get(visit_day, capacity[visit_day]) - 1
+            if slots < 0:
+                raise ValueError("UNSCHEDULABLE")
+            updated[visit_day] = slots
+
+    capacity.update(updated)
+    return visits
