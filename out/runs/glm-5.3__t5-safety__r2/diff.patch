+    with pytest.raises(ValueError, match="FOLLOW_UP_CYCLE"):
+        triage_events(
+            [
+                event("A", follow_up_of="C"),
+                event("B", follow_up_of="A"),
+                event("C", follow_up_of="B"),
+            ],
+            now=AWARE_NOW,
+        )
+
+
+@pytest.mark.parametrize("seriousness", ["unknown", "UNKNOWN", "", None, 3, ["fatal"]])
+def test_unknown_seriousness_is_rejected(seriousness):
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=seriousness)], now=AWARE_NOW)
+
+
+def test_invalid_now_values_are_rejected():
+    for invalid_now in ("2024-01-01T00:00:00Z", None, 20240101):
+        with pytest.raises(ValueError, match="INVALID_NOW"):
+            triage_events([], now=invalid_now)
+
+
+def test_naive_onset_objects_are_rejected():
+    with pytest.raises(ValueError, match="INVALID_ONSET"):
+        triage_events(
+            [event("A", onset=datetime(2024, 1, 1))],
+            now=AWARE_NOW,
+        )
+
+
+@pytest.mark.parametrize(
+    ("field", "value"),
+    [
+        ("event_id", ""),
+        ("event_id", "   "),
+        ("event_id", 7),
+        ("event_id", None),
+        ("subject_pseudonym", ""),
+        ("event_code", ""),
+        ("source", ""),
+        ("source", None),
+    ],
+)
+def test_required_text_fields_are_validated(field, value):
+    record = event("A")
+    record[field] = value
+
+    with pytest.raises(ValueError, match=f"INVALID_{field.upper()}"):
+        triage_events([record], now=AWARE_NOW)
+
+
+def test_uncertain_must_be_a_boolean():
+    for invalid_uncertain in (None, 1, "yes", []):
+        with pytest.raises(ValueError, match="INVALID_UNCERTAIN"):
+            triage_events([event("A", uncertain=invalid_uncertain)], now=AWARE_NOW)
+
+
+def test_invalid_follow_up_links_are_rejected():
+    for invalid_link in ("", "   ", 12, {"id": "A"}):
+        with pytest.raises(ValueError, match="INVALID_FOLLOW_UP_OF"):
+            triage_events([event("A", follow_up_of=invalid_link)], now=AWARE_NOW)
