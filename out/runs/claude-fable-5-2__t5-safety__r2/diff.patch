+def test_input_order_does_not_affect_output():
+    events = [
+        event("E1"),
+        event("E2", follow_up_of="E1", seriousness="hospitalization", source="site-a"),
+        event("E3", follow_up_of="E2", uncertain=True),
+        event("R1", subject_pseudonym="subject-002", onset="2024-01-09T00:00:00Z"),
+        event(
+            "R2",
+            follow_up_of="R1",
+            subject_pseudonym="subject-002",
+            onset="2024-01-12T00:00:00Z",
+            source="site-c",
+        ),
+    ]
+    baseline = triage_events(events, now=NOW)
+
+    assert [case["case_id"] for case in baseline] == ["R1", "E1"]
+    assert baseline[0]["event_ids"] == ["R1", "R2"]
+    assert baseline[0]["sources"] == ["site-b", "site-c"]
+    assert baseline[0]["uncertain"] is False
+    assert baseline[1]["event_ids"] == ["E1", "E2", "E3"]
+    assert baseline[1]["seriousness"] == "hospitalization"
+    assert baseline[1]["uncertain"] is True
+    for ordering in permutations(events):
+        assert triage_events(list(ordering), now=NOW) == baseline
+
