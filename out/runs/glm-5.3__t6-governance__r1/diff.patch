+def test_missing_metadata_is_rejected_atomically_for_approve_and_execute():
+    no_metadata = request("submitted")
+    del no_metadata["metadata"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(no_metadata, "approve", "bob", NOW)
+    assert no_metadata["status"] == "submitted"
+    assert no_metadata["history"] == []
+    assert "approval_expires_on" not in no_metadata
+
+    approved = request("approved", approval_expires_on="2025-02-01")
+    del approved["metadata"]
+    calls = []
+
+    def tracking_executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(approved, "execute", "alice", NOW, tracking_executor)
+    assert calls == []
+    assert approved["status"] == "approved"
+    assert approved["history"] == []
+
+
+def test_executor_input_and_execution_result_are_isolated_copies():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    result = {"rows": 3, "nested": {"values": [1]}}
+    seen = []
+
+    def executor(approved_request):
+        seen.append(approved_request)
+        return result
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+
+    assert seen[0] is not approved
+    assert seen[0] == approved
+    assert seen[0]["history"] == []
+
+    executed["execution_result"]["rows"] = 99
+    executed["execution_result"]["nested"]["values"].append(2)
+    assert result == {"rows": 3, "nested": {"values": [1]}}
+
+    again = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    assert again["execution_result"] == {"rows": 3, "nested": {"values": [1]}}
+    assert approved["status"] == "approved"
+    assert "execution_result" not in approved
+
