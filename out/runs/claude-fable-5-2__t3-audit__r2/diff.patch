+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot anchored to a trusted head and length.
+
+        Raises ``ValueError("INVALID_CHAIN:<codes>")`` when the snapshot does
+        not verify against both trusted values.
+        """
+
+        errors: set[str] = set()
+        # Both anchors are mandatory here: ``verify`` treats ``None`` as "not
+        # supplied", which must never let an unanchored snapshot be restored.
+        if expected_head is None:
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+
+        try:
+            snapshot = list(records)
+        except (TypeError, ValueError):
+            snapshot = []
+            errors.add("MALFORMED_RECORD")
+        else:
+            errors.update(
+                cls.verify(
+                    snapshot,
+                    expected_head=expected_head,
+                    expected_length=expected_length,
+                )
+            )
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        if chain.records:
+            chain.previous_hash = chain.records[-1]["hash"]
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
