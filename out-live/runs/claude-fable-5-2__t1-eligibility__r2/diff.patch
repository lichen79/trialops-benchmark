     with pytest.raises(ValueError, match="on"):
         evaluate_subject(make_subject(), make_protocol(), "2024-06-15")
+
+
+@pytest.mark.parametrize(
+    ("on", "expected_reasons"),
+    [
+        # Non-leap year: the birthday has not happened on 28 Feb, has on 1 Mar.
+        (date(2023, 2, 28), ["AGE_BELOW_MIN"]),
+        (date(2023, 3, 1), []),
+        (date(2024, 2, 28), []),
+        # Leap year: the birthday falls on 29 Feb itself.
+        (date(2024, 2, 29), ["AGE_ABOVE_MAX"]),
+    ],
+)
+def test_leap_day_birthday_in_leap_and_non_leap_years(on, expected_reasons):
+    protocol = make_protocol()
+    protocol.update(
+        min_age=19, max_age=19, labs={}, exclusions=[], consent_valid_from="2023-01-01"
+    )
+    subject = make_subject()
+    subject.update(
+        birth_date="2004-02-29",
+        consents=[{"version": "v2", "signed_on": "2023-01-01"}],
+        labs={},
+    )
+
+    assert evaluate_subject(subject, protocol, on)["reasons"] == expected_reasons
+
+
+@pytest.mark.parametrize(
+    ("birth_date", "expected_reasons"),
+    [
+        ("2006-06-16", ["AGE_BELOW_MIN"]),  # turns 18 tomorrow
+        ("2006-06-15", []),  # turns 18 today
+        ("1993-06-16", []),  # still 30 today
+        ("1993-06-15", ["AGE_ABOVE_MAX"]),  # turns 31 today
+    ],
+)
+def test_age_limits_change_exactly_on_the_birthday(birth_date, expected_reasons):
+    subject = make_subject()
+    subject["birth_date"] = birth_date
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["reasons"] == expected_reasons
+
+
+@pytest.mark.parametrize(
+    ("labs", "expected_reasons"),
+    [
+        ({"A": 1, "Z": 10}, []),
+        ({"A": 3, "Z": 20}, []),
+        ({"A": 0.999, "Z": 10}, ["LAB_A_LOW"]),
+        ({"A": 3.001, "Z": 20}, ["LAB_A_HIGH"]),
+        ({"A": 1, "Z": 9.999}, ["LAB_Z_LOW"]),
+        ({"A": 3, "Z": 20.001}, ["LAB_Z_HIGH"]),
+    ],
+)
+def test_lab_limits_are_inclusive_and_fail_just_outside(labs, expected_reasons):
+    subject = make_subject()
+    subject["labs"] = labs
+
+    result = evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    assert result["reasons"] == expected_reasons
+
+
+def test_consent_signed_after_evaluation_date_or_absent_is_missing():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-06-16"}]
+    expected = {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": None,
+    }
+
+    assert evaluate_subject(subject, make_protocol(), date(2024, 6, 15)) == expected
+
+    subject["consents"] = []
+    assert evaluate_subject(subject, make_protocol(), date(2024, 6, 15)) == expected
+
+
+def test_consent_validity_window_starts_on_consent_valid_from():
+    subject = make_subject()
+
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-01-01"}]
+    assert evaluate_subject(subject, make_protocol(), date(2024, 6, 15)) == {
+        "eligible": True,
+        "reasons": [],
+        "consent_version": "v2",
+    }
+
+    # Right version, but signed the day before the window opened (retired).
+    subject["consents"] = [{"version": "v2", "signed_on": "2023-12-31"}]
+    assert evaluate_subject(subject, make_protocol(), date(2024, 6, 15)) == {
+        "eligible": False,
+        "reasons": ["CONSENT_MISSING"],
+        "consent_version": "v2",
+    }
+
+
+def test_reason_order_with_no_consent_and_underage_subject():
+    protocol = make_protocol()
+    protocol["exclusions"] = ["PRIOR", "DO_NOT_ENROLL"]
+    subject = make_subject()
+    subject.update(
+        birth_date="2010-01-01",
+        consents=[],
+        flags=["DO_NOT_ENROLL", "UNLISTED", "PRIOR"],
+        labs={"Z": 9, "A": 4},
+    )
+
+    assert evaluate_subject(subject, protocol, date(2024, 6, 15)) == {
+        "eligible": False,
+        "reasons": [
+            "CONSENT_MISSING",
+            "AGE_BELOW_MIN",
+            "EXCLUSION_PRIOR",
+            "EXCLUSION_DO_NOT_ENROLL",
+            "LAB_A_HIGH",
+            "LAB_Z_LOW",
+        ],
+        "consent_version": None,
+    }
+
+
+@pytest.mark.parametrize(
+    "field", ["birth_date", "consents", "labs", "flags"]
+)
+def test_missing_subject_field_raises_value_error_naming_it(field):
+    subject = make_subject()
+    del subject[field]
+
+    with pytest.raises(ValueError, match=field):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+
+@pytest.mark.parametrize(
+    "field",
+    [
+        "min_age",
+        "max_age",
+        "required_consent_version",
+        "consent_valid_from",
+        "labs",
+        "exclusions",
+    ],
+)
+def test_missing_protocol_field_raises_value_error_naming_it(field):
+    protocol = make_protocol()
+    del protocol[field]
+
+    with pytest.raises(ValueError, match=field):
+        evaluate_subject(make_subject(), protocol, date(2024, 6, 15))
+
+
+def test_malformed_dates_and_consent_records_raise_value_error_naming_field():
+    subject = make_subject()
+    subject["consents"] = [{"version": "v2", "signed_on": "2024-02-30"}]
+    with pytest.raises(ValueError, match="signed_on"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    subject["consents"] = [{"version": "v2"}]
+    with pytest.raises(ValueError, match="signed_on"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    subject["consents"] = [{"signed_on": "2024-06-15"}]
+    with pytest.raises(ValueError, match="version"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
+
+    protocol = make_protocol()
+    protocol["consent_valid_from"] = "01/01/2024"
+    with pytest.raises(ValueError, match="consent_valid_from"):
+        evaluate_subject(make_subject(), protocol, date(2024, 6, 15))
+
+    subject = make_subject()
+    subject["labs"]["A"] = "2"
+    with pytest.raises(ValueError, match="labs.A"):
+        evaluate_subject(subject, make_protocol(), date(2024, 6, 15))
