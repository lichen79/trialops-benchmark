+        event("T", follow_up_of="M"),
+    ]
+
+    for order in (events, list(reversed(events))):
+        with pytest.raises(ValueError, match="MIXED_CASE"):
+            triage_events(order, now=now)
+
+
+@pytest.mark.parametrize(
