--- a/tests/test_booking.py	1970-01-01 01:00:00
+++ b/tests/test_booking.py	2026-11-14 11:18:37
@@ -0,0 +1,143 @@
+import copy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import book_subject_visits, plan_visits
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3]},
+        "exclusions": ["PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-01-02"}],
+        "labs": {"A": 2},
+        "flags": [],
+    }
+
+
+def book(capacity, **overrides):
+    kwargs = dict(
+        on=date(2024, 1, 15),
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+    kwargs.update(overrides)
+    subject = kwargs.pop("subject", make_subject())
+    protocol = kwargs.pop("protocol", make_protocol())
+    return book_subject_visits(subject, protocol, **kwargs)
+
+
+def test_sequential_slot_contention_commits_between_calls():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 2}
+
+    first = book(capacity)
+    assert [v["local"][:10] for v in first] == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 1}
+
+    second = book(capacity)
+    assert [v["local"][:10] for v in second] == ["2024-02-01", "2024-02-29"]
+    # Unlisted dates are never inserted.
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+
+def test_within_plan_competition_uses_the_same_slot_once():
+    capacity = {date(2024, 3, 31): 1}
+    visits = book(
+        capacity,
+        first_day=date(2024, 3, 31),
+        offsets_months=[0],
+    )
+    assert visits[0]["local"][:10] == "2024-03-31"
+    assert capacity == {date(2024, 3, 31): 0}
+
+
+def test_later_visit_failure_rolls_back_everything():
+    capacity = {date(2024, 1, 31): 1}
+    committed = book(capacity, offsets_months=[0])
+    assert committed[0]["local"][:10] == "2024-01-31"
+    assert capacity == {date(2024, 1, 31): 0}
+
+    capacity[date(2024, 2, 1)] = 1
+    closed = {date(2024, 2, 29) + timedelta(days=d) for d in range(367)}
+    snapshot = dict(capacity)
+    closed_copy = set(closed)
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(capacity, closed_days=closed)
+    assert capacity == snapshot
+    assert closed == closed_copy
+
+
+def test_ineligible_subject_raises_with_ordered_reasons_and_keeps_capacity():
+    subject = make_subject()
+    subject["flags"] = ["PRIOR"]
+    subject["labs"] = {"A": 9}
+    original_subject = copy.deepcopy(subject)
+    protocol = make_protocol()
+    original_protocol = copy.deepcopy(protocol)
+    capacity = {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError) as excinfo:
+        book(capacity, subject=subject, protocol=protocol)
+    assert str(excinfo.value).startswith("INELIGIBLE:")
+    assert "EXCLUSION_PRIOR" in str(excinfo.value)
+    assert str(excinfo.value).index("EXCLUSION_PRIOR") < str(excinfo.value).index(
+        "LAB_A_HIGH"
+    )
+    assert capacity == {date(2024, 1, 31): 1}
+    assert subject == original_subject
+    assert protocol == original_protocol
+
+
+def test_invalid_timezone_leaves_capacity_unchanged():
+    capacity = {date(2024, 1, 31): 1}
+    with pytest.raises(ValueError):
+        book(capacity, timezone="Not/A_Real_Zone")
+    assert capacity == {date(2024, 1, 31): 1}
+
+
+def test_booking_preserves_dst_and_month_end_behavior():
+    capacity = {}
+    kwargs = dict(
+        first_day=date(2024, 3, 10),
+        offsets_months=[0, 8],
+        hour=2,
+        minute=30,
+        timezone="America/New_York",
+    )
+    booked = book(capacity, on=date(2024, 3, 1), **kwargs)
+    assert booked == plan_visits(**kwargs)
+    assert booked[0]["local"] == "2024-03-10T03:30:00-04:00"
+    assert capacity == {}
+
+    leap = book({}, first_day=date(2024, 1, 31), offsets_months=[1, 13])
+    assert [v["local"][:10] for v in leap] == ["2024-02-29", "2025-02-28"]
+
+
+def test_paris_booking_matches_plan():
+    capacity = {date(2024, 3, 31): 1}
+    booked = book(
+        capacity,
+        first_day=date(2024, 3, 31),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="Europe/Paris",
+    )
+    assert booked[0]["local"] == "2024-03-31T03:30:00+02:00"
+    assert booked[0]["utc"] == "2024-03-31T01:30:00Z"
+    assert capacity == {date(2024, 3, 31): 0}
