+def test_every_source_event_id_is_preserved_exactly_once():
+    events = [event("E1")] + [
+        event(f"E{index}", follow_up_of=f"E{index - 1}") for index in range(2, 8)
+    ]
+    events.append(event("Z9", subject_pseudonym="subject-002"))
+
+    cases = triage_events(reversed(events), now=NOW)
+
+    merged_ids = [event_id for case in cases for event_id in case["event_ids"]]
+    assert sorted(merged_ids) == sorted(item["event_id"] for item in events)
+    assert len(merged_ids) == len(set(merged_ids))
