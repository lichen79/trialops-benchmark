+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot trusted by an out-of-band anchor.
+
+        ``records`` is materialized exactly once, then validated with
+        :meth:`verify` using both trusted anchors. An empty snapshot is only
+        valid with ``expected_length == 0`` and ``expected_head == GENESIS_HASH``.
+        """
+
+        try:
+            snapshot = list(records)
+        except (TypeError, ValueError, OverflowError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = cls.verify(
+            snapshot,
+            expected_head=expected_head,
+            expected_length=expected_length,
+        )
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(errors))
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        chain.previous_hash = (
+            GENESIS_HASH if not chain.records else chain.records[-1]["hash"]
+        )
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        return chain
 
