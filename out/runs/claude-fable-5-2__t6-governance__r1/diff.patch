+def test_repeated_execution_is_invalid_state_without_another_executor_call():
+    executor = RecordingExecutor()
+    executed = apply_reuse_action(
+        approved_request(), "execute", "alice", NOW, executor
+    )
+    assert len(executor.calls) == 1
+
+    assert_fails_atomically(
+        executed,
+        "execute",
+        "alice",
+        NOW + timedelta(hours=1),
+        "INVALID_STATE",
+        executor,
+    )
+    assert len(executor.calls) == 1
+    assert executed["status"] == "executed"
+    assert [entry["action"] for entry in executed["history"]] == ["execute"]
+
