+def test_retention_and_approval_boundaries_are_inclusive():
+    on_retention_edge = request("submitted", retention_until="2025-01-01")
+    approved = apply_reuse_action(on_retention_edge, "approve", "bob", NOW)
+    assert approved["approval_expires_on"] == "2025-01-31"
+
+    on_approval_edge = request("approved", approval_expires_on="2025-01-01")
+    assert apply_reuse_action(
+        on_approval_edge, "execute", "alice", NOW, successful_executor
+    )["status"] == "executed"
+
+    approved_edge = request("approved", approval_expires_on="2025-01-01")
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(approved_edge, "expire", "system", NOW)
+    assert (
+        apply_reuse_action(
+            approved_edge, "expire", "system", NOW + timedelta(days=1)
+        )["status"]
+        == "expired"
+    )
+
+    submitted_edge = request("submitted", retention_until="2025-01-01")
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(submitted_edge, "expire", "system", NOW)
+    assert (
+        apply_reuse_action(
+            submitted_edge, "expire", "system", NOW + timedelta(days=1)
+        )["status"]
+        == "expired"
+    )
+
