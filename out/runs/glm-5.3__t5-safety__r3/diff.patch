+def test_uncertainty_is_preserved_from_any_member_of_a_chain():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    assert triage_events([event("A")], now=now)[0]["uncertain"] is False
+    assert triage_events(
+        [
+            event("A", uncertain=True),
+            event("B", follow_up_of="A"),
+            event("C", follow_up_of="B"),
+        ],
+        now=now,
+    )[0]["uncertain"] is True
+    assert triage_events(
+        [
+            event("A"),
+            event("B", follow_up_of="A", uncertain=False),
+            event("C", follow_up_of="B", uncertain=True),
+        ],
+        now=now,
+    )[0]["uncertain"] is True
+
