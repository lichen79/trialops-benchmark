+def test_spring_forward_reschedules_across_closed_day_and_keeps_wall_time():
+    visits = plan_visits(
+        first_day=date(2024, 3, 10),
+        offsets_months=[0, 1],
+        hour=2,
+        minute=15,
+        timezone="America/New_York",
+        closed_days={date(2024, 3, 10)},
+    )
+
+    # The nominal day is closed, so the visit moves to Mar 11 and keeps 02:15,
+    # which exists again outside the DST gap.
+    assert [visit["local"] for visit in visits] == [
+        "2024-03-11T02:15:00-04:00",
+        "2024-04-10T02:15:00-04:00",
+    ]
+    assert [visit["utc"] for visit in visits] == [
+        "2024-03-11T06:15:00Z",
+        "2024-04-10T06:15:00Z",
+    ]
+
+
+def test_capacity_boundary_is_inclusive_and_private_allocation_competes():
+    shared = date(2024, 5, 15)
+    first = plan_visits(
+        first_day=date(2024, 5, 1),
+        offsets_months=[0],
+        hour=8,
+        minute=0,
+        timezone="America/New_York",
+        capacity={shared: 2},
+    )
+    second = plan_visits(
+        first_day=date(2024, 5, 15),
+        offsets_months=[0],
+        hour=8,
+        minute=30,
+        timezone="America/New_York",
+        capacity={shared: 2},
+    )
+    third = plan_visits(
+        first_day=date(2024, 5, 15),
+        offsets_months=[0],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity={shared: 2},
+    )
+
+    # Capacity is checked independently for each plan, so each of the first two
+    # fits on the shared day; a caller must subtract slots between calls.
+    assert [visit["local"][:10] for visit in first] == ["2024-05-01"]
+    assert [visit["local"][:10] for visit in second] == ["2024-05-15"]
+    assert [visit["local"][:10] for visit in third] == ["2024-05-15"]
+
