+def test_signing_and_purge_boundaries_are_inclusive_and_purpose_scoped():
+    signed_today = make_subject("signed-today")
+    future_signed = make_subject("future-signed")
+    future_signed["consents"][0]["signed_on"] = "2024-06-16"
+    purge_today = make_subject("purge-today", purge_after="2024-06-15")
+    other_purpose = make_subject(
+        "other-purpose", consents=[{"purpose": "marketing", "signed_on": "2024-01-01"}]
+    )
+    result = export_subjects(
+        [signed_today, future_signed, purge_today, other_purpose],
+        purpose="research",
+        secret="test-secret",
+        on=ON,
+    )
+    assert sorted(row["pseudonym"] for row in result["rows"]) == sorted(
+        [pseudonym("signed-today"), pseudonym("purge-today")]
+    )
+
+
+def test_output_is_deterministic_and_order_independent():
+    subjects = [make_subject(f"s{i}") for i in range(5)]
+    first = export_subjects(subjects, purpose="research", secret="test-secret", on=ON)
+    second = export_subjects(
+        list(reversed(subjects)), purpose="research", secret="test-secret", on=ON
+    )
+    assert first == second
+    assert canonical(first) == canonical(second)
+    other_secret = export_subjects(subjects, purpose="research", secret="other", on=ON)
+    assert other_secret["rows"] != first["rows"]
+
+
+def test_invalid_dates_and_empty_secret_or_purpose_raise_without_leaks():
