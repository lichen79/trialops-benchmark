+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Plan visits for an eligible subject and reserve their capacity slots.
+
+    Eligibility is evaluated first; an ineligible subject raises
+    ``ValueError("INELIGIBLE:<reason>,<reason>...")``. Planning is delegated to
+    :func:`plan_visits`. ``capacity`` is only decremented once the whole plan
+    has succeeded, only for dates it already lists, and is left exactly as it
+    was on any failure.
+    """
+    evaluation = evaluate_subject(subject, protocol, on)
+    if not evaluation["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(evaluation["reasons"]))
+
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a dict of dates to remaining slots")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Work out every new balance before touching the caller's dict, so the
+    # commit below cannot stop half-way.
+    updated: dict[date, int] = {}
+    for visit in visits:
+        visit_day = datetime.fromisoformat(str(visit["local"])).date()
+        if visit_day not in capacity:
+            continue
+        left = updated.get(visit_day, capacity[visit_day]) - 1
+        if left < 0:
+            raise ValueError("UNSCHEDULABLE")
+        updated[visit_day] = left
+
+    for visit_day, left in updated.items():
+        capacity[visit_day] = left
+
+    return visits
 
