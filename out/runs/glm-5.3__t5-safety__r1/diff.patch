 import pytest
 
@@ -98,3 +99,258 @@
             [event("A", onset="2024-01-01T00:00:00")],
             now=datetime(2024, 1, 1, tzinfo=timezone.utc),
         )
+
+
+def test_unknown_seriousness_is_rejected():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness="severe")], now=now)
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        triage_events([event("A", seriousness=None)], now=now)
+    with pytest.raises(ValueError, match="INVALID_SERIOUSNESS"):
+        # Case matters: only the documented values are recognized.
+        triage_events([event("A", seriousness="FATAL")], now=now)
+
+
+def test_invalid_event_links_are_rejected():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+
+    def rejects(changes, code):
+        with pytest.raises(ValueError, match=code):
+            triage_events([event("A", **changes)], now=now)
+
+    rejects({"follow_up_of": ""}, "INVALID_FOLLOW_UP_OF")
+    rejects({"follow_up_of": " "}, "INVALID_FOLLOW_UP_OF")
+    rejects({"follow_up_of": 7}, "INVALID_FOLLOW_UP_OF")
+    # A self-link is a cycle, not a missing root.
+    rejects({"follow_up_of": "A"}, "FOLLOW_UP_CYCLE")
+    rejects({"follow_up_of": "absent"}, "MISSING_ROOT")
+
+
+def test_uncertain_values_must_be_boolean():
+    with pytest.raises(ValueError, match="INVALID_UNCERTAIN"):
+        triage_events(
+            [event("A", uncertain="yes")],
+            now=datetime(2024, 1, 1, tzinfo=timezone.utc),
+        )
+
+
+def test_duplicate_and_shared_roots_form_distinct_cases():
+    # Two roots with identical subject and event code stay separate cases.
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    events = [
+        event("A", onset="2024-03-01T00:00:00Z"),
+        event("A1", follow_up_of="A", onset="2024-03-03T00:00:00Z"),
+        event("A2", follow_up_of="A", onset="2024-03-02T00:00:00Z"),
+        event("B", onset="2024-03-01T00:00:00Z"),
+        event("B1", follow_up_of="B", onset="2024-03-02T00:00:00Z", uncertain=True),
+    ]
+
+    cases = triage_events(events, now=now)
+
+    assert [case["case_id"] for case in cases] == ["A", "B"]
+    assert cases[0]["event_ids"] == ["A", "A1", "A2"]
+    assert cases[1]["event_ids"] == ["B", "B1"]
+    assert cases[1]["uncertain"] is True
+    assert cases[0]["uncertain"] is False
+    # A repeated ID anywhere in the input is rejected, root or follow-up.
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            events + [event("A1", follow_up_of="A")], now=now
+        )
+
+
+def test_chained_followups_with_offsets_keep_earliest_utc_onset():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    # 2024-01-01T12:00+05:30 == 2024-01-01T06:30Z, earlier than the root below.
+    events = [
+        event("R", onset="2024-01-01T08:00:00Z", seriousness="other"),
+        # +05:30 puts this follow-up earlier in UTC than its root.
+        event("F1", follow_up_of="R", onset="2024-01-01T12:00:00+05:30"),
+        event("F2", follow_up_of="F1", onset="2024-01-01T13:00:00+05:30"),
+        event("F3", follow_up_of="F1", onset="2024-01-01T00:00:00-08:00"),
+    ]
+
+    cases = triage_events(events, now=now)
+
+    assert cases == [
+        {
+            "case_id": "R",
+            "subject_pseudonym": "subject-001",
+            "event_code": "SYNTH-01",
+            "onset": "2024-01-01T06:30:00Z",
+            "seriousness": "other",
+            "report_by": "2024-01-31T06:30:00Z",
+            "sources": ["site-b"],
+            "event_ids": ["F1", "F2", "F3", "R"],
+            "uncertain": False,
+            "overdue": False,
+        }
+    ]
+    # The root's own timestamp is not necessarily the earliest one in UTC.
+    assert triage_events(
+        [event("Sole", onset="2024-01-01T00:30:00+02:00")], now=now
+    )[0]["onset"] == "2023-12-31T22:30:00Z"
+
+
+def test_mixed_pseudonyms_and_codes_are_rejected_per_case():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    with pytest.raises(ValueError, match="MIXED_CASE"):
+        triage_events(
+            [event("A"), event("B", follow_up_of="A", subject_pseudonym="subject-002")],
+            now=now,
+        )
+    # Deep chains and different subjects/codes across separate cases are fine.
+    assert triage_events(
+        [
+            event("A", subject_pseudonym="subject-001"),
