+def test_probe_fromisoformat_behaviour():
+    cases = [
+        "1990-04-03T10:00:00",
+        "19900403",
+        "1990-W15-3",
+        "1990-04-03 ",
+        "1990-04",
+        "1990-13-01",
+    ]
+    for text in cases:
+        try:
+            value = date.fromisoformat(text)
+        except Exception as exc:  # noqa: BLE001
+            print(f"{text!r}: {type(exc).__name__}: {exc}")
+        else:
+            print(f"{text!r}: OK -> {value}")
+    assert True
