+def test_from_records_round_trip_persistence():
+    chain = AuditChain()
+    append_event(chain, "event-1", AT)
+
+    snapshot_one = deepcopy(chain.records)
+    restored = AuditChain.from_records(
+        snapshot_one, expected_head=chain.head(), expected_length=1
+    )
+    append_event(restored, "event-2", AT + timedelta(seconds=1))
+
+    # The persisted snapshot of the extended chain restores again with its own
+    # trusted anchors, and agrees with the chain it was copied from.
+    snapshot_two = deepcopy(restored.records)
+    reloaded = AuditChain.from_records(
+        snapshot_two, expected_head=restored.head(), expected_length=2
+    )
+    assert reloaded.records == restored.records
+    assert reloaded.head() == restored.head()
+    assert reloaded.verify(
+        reloaded.records, expected_head=reloaded.head(), expected_length=2
+    ) == []
+    assert append_event(
+        reloaded, "event-3", AT + timedelta(seconds=2)
+    )["previous_hash"] == restored.head()
+
+    # Anchoring a non-empty snapshot to the genesis hash is always wrong.
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            snapshot_two, expected_head=GENESIS_HASH, expected_length=2
+        )
+    assert str(excinfo.value) == "INVALID_CHAIN: HEAD_MISMATCH"
+
+
+def test_restored_instances_are_independent():
+    original = AuditChain()
+    append_event(original, "event-1", AT)
+
+    left = AuditChain.from_records(
+        deepcopy(original.records), expected_head=original.head(), expected_length=1
+    )
+    right = AuditChain.from_records(
+        deepcopy(original.records), expected_head=original.head(), expected_length=1
+    )
+
+    assert left.records == right.records
+    assert left is not right
+
+    # Extending one restore never affects the other.
+    second_left = append_event(left, "event-2", AT + timedelta(seconds=1))
+    assert len(right.records) == 1
+    assert right.head() == original.head()
+    assert left.records[1] is second_left
+
+    # Identical prefixes hash identically, so a parallel append agrees.
+    second_right = append_event(right, "event-2", AT + timedelta(seconds=1))
+    assert second_left["hash"] == second_right["hash"]
+    assert left.head() == right.head()
+    assert left.records is not right.records
+    assert left.records[0] is not right.records[0]
+
+    # Event IDs stay chain-local.
+    assert "event-1" in left._event_ids and "event-1" in right._event_ids
+    assert left._event_ids is not right._event_ids
