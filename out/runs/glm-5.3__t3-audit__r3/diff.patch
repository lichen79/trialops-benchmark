+def test_verification_does_not_normalize_stored_timestamps():
+    chain = build_chain(1)
+    equivalent = deepcopy(chain.records)
+    equivalent[0]["at"] = "2024-06-15T12:00:00+00:00"
+
+    assert "MALFORMED_TIMESTAMP" in AuditChain.verify(equivalent)
+
+    with pytest.raises(ValueError, match="MALFORMED_TIMESTAMP"):
+        AuditChain.from_records(
+            equivalent, expected_head=chain.head(), expected_length=1
+        )
+
+    naive = deepcopy(chain.records)
+    naive[0]["at"] = "2024-06-15 12:00:00"
+    assert "MALFORMED_TIMESTAMP" in AuditChain.verify(naive)
