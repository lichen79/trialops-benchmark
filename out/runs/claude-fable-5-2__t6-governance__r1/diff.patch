+def test_history_is_chronological_and_normalized_to_utc():
+    earlier = {"action": "imported", "actor": "system", "at": "2024-12-31T00:00:00Z"}
+    original = request(history=[deepcopy(earlier)])
+
+    # 23:30 at UTC-5 is already the next calendar day in UTC.
+    submit_at = datetime(2025, 1, 1, 23, 30, tzinfo=timezone(timedelta(hours=-5)))
+    approve_at = datetime(2025, 1, 2, 10, 0, tzinfo=timezone(timedelta(hours=2)))
+    execute_at = datetime(2025, 1, 3, 9, 15, 30, tzinfo=timezone.utc)
+
+    submitted = apply_reuse_action(original, "submit", "alice", submit_at)
+    approved = apply_reuse_action(submitted, "approve", "bob", approve_at)
+    executed = apply_reuse_action(
+        approved, "execute", "alice", execute_at, RecordingExecutor()
+    )
+
+    assert executed["history"] == [
+        earlier,
+        {"action": "submit", "actor": "alice", "at": "2025-01-02T04:30:00Z"},
+        {"action": "approve", "actor": "bob", "at": "2025-01-02T08:00:00Z"},
+        {"action": "execute", "actor": "alice", "at": "2025-01-03T09:15:30Z"},
+    ]
+    stamps = [entry["at"] for entry in executed["history"]]
+    assert stamps == sorted(stamps)
+    assert approved["approval_expires_on"] == "2025-02-01"
+
+    # Each step only ever extended its own copy.
+    assert original["history"] == [earlier]
+    assert len(submitted["history"]) == 2
+    assert len(approved["history"]) == 3
