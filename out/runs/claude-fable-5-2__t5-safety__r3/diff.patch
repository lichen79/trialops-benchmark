+    ]
+    # An aware, non-UTC ``now`` is accepted and compared by instant.
+    now = datetime(2024, 5, 1, tzinfo=timezone(timedelta(hours=-7)))
+
+    cases = triage_events(events, now=now)
+
+    # X and Y are the same instant written with different offsets, so the
+    # case_id breaks the tie; X's local calendar date rolls back a day in UTC.
+    assert [(case["case_id"], case["onset"], case["report_by"]) for case in cases] == [
+        ("W", "2024-04-30T18:59:59Z", "2024-05-30T18:59:59Z"),
+        ("X", "2024-04-30T19:00:00Z", "2024-05-30T19:00:00Z"),
+        ("Y", "2024-04-30T19:00:00Z", "2024-05-30T19:00:00Z"),
