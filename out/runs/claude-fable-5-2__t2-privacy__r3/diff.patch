+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request by exporting ``subjects``.
+
+    Governance decides whether the request may run. ``subjects`` and
+    ``secret`` are only touched by the executor, which governance invokes
+    after all of its own checks (actor, state, approval, policy, ``now``)
+    have passed. Any export failure is reported by governance as
+    ``EXECUTION_FAILED`` and leaves ``request`` untouched.
+    """
+
+    def executor(approved_request: dict[str, object]) -> dict[str, Any]:
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=now.astimezone(timezone.utc).date(),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
