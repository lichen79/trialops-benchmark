+def test_within_plan_capacity_allocation_is_inclusive_and_greedy():
+    # The first visit is pushed forward onto the second visit's nominal day;
+    # protocol order wins the single slot and the later visit moves on.
+    closed = {date(2024, 3, day) for day in range(31, 32)} | {
+        date(2024, 4, day) for day in range(1, 30)
+    }
+    capacity = {date(2024, 4, 30): 1}
+
+    visits = plan_visits(
+        first_day=date(2024, 3, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        closed_days=closed,
+        capacity=capacity,
+    )
+
+    assert [visit["offset_months"] for visit in visits] == [0, 1]
+    assert [visit["local"][:10] for visit in visits] == [
+        "2024-04-30",
+        "2024-05-01",
