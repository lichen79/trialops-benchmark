+def test_unlinked_roots_with_matching_fields_are_not_merged():
+    cases = triage_events(
+        [event("E2", source="site-a"), event("E1", uncertain=True)], now=NOW
+    )
+
+    assert [case["case_id"] for case in cases] == ["E1", "E2"]
+    assert [case["event_ids"] for case in cases] == [["E1"], ["E2"]]
+    assert [case["sources"] for case in cases] == [["site-b"], ["site-a"]]
+    assert [case["uncertain"] for case in cases] == [True, False]
