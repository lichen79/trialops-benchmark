+@pytest.mark.parametrize(
+    ("follow_up_seriousness", "expected_seriousness", "expected_report_by"),
+    [
+        ("other", "other", "2024-03-31T00:00:00Z"),
+        ("hospitalization", "hospitalization", "2024-03-16T00:00:00Z"),
+        ("life_threatening", "life_threatening", "2024-03-08T00:00:00Z"),
+        ("fatal", "fatal", "2024-03-08T00:00:00Z"),
+    ],
+)
+def test_seriousness_sets_the_reporting_window(
+    follow_up_seriousness, expected_seriousness, expected_report_by
+):
+    events = [
+        event("E1", onset="2024-03-01T00:00:00Z", seriousness="other"),
+        event(
+            "E2",
+            follow_up_of="E1",
+            onset="2024-03-02T00:00:00Z",
+            seriousness=follow_up_seriousness,
+            source="site-a",
+        ),
+    ]
+
+    case = triage_events(events, now=aware(2024, 3, 1))[0]
+
+    assert case["seriousness"] == expected_seriousness
+    assert case["report_by"] == expected_report_by
+
+
