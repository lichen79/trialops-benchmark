+def execute_reuse_export(
+    request: dict[str, object],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute one approved reuse request as a pseudonymized export.
+
+    The single delegation to :func:`trialops.governance.apply_reuse_action`
+    performs every governance check (actor, state, approval and retention
+    windows, privacy plan, metadata) before it invokes the executor, so an
+    unexecutable request never consumes the supplied subject records. The
+    executor runs :func:`export_subjects` exactly once, using the purpose of
+    the approved snapshot it receives, the caller's secret, and the UTC date
+    of ``now``. Any export failure is reported by governance as
+    ``EXECUTION_FAILED`` and leaves the approved request and its history
+    unchanged, because ``apply_reuse_action`` works on a deep copy.
+    """
+
+    def executor(approved_request: Mapping[str, Any]) -> dict[str, Any]:
+        # ``approved_request`` is governance's private deep copy of the
+        # approved snapshot; its purpose is the scope of this export.
+        purpose = approved_request.get("purpose")
+        # Reuse governance's own normalization so the exported "on" date is
+        # exactly the UTC date every governance check was evaluated against.
+        on = _aware_utc(now).date()
+        return export_subjects(
+            subjects,
+            purpose=purpose,  # type: ignore[arg-type]
+            secret=secret,
+            on=on,
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
