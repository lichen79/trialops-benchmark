+def _flag_only(value):
+    del value["privacy_plan"]
+    value["pseudonymized"] = True
+
+
+def _boolean_plan(value):
+    value["privacy_plan"] = True
+
+
+def _wrong_algorithm(value):
+    value["privacy_plan"]["algorithm"] = "sha256"
+
+
+def _domain_differs_from_purpose(value):
+    value["privacy_plan"]["domain"] = "another purpose"
+
+
+def _reordered_fields(value):
+    value["privacy_plan"]["fields"].reverse()
+
+
+def _extra_field(value):
+    value["privacy_plan"]["fields"].append("email")
+
+
+def _missing_field(value):
+    value["privacy_plan"]["fields"].pop()
+
+
+def _extra_key(value):
+    value["privacy_plan"]["salt"] = "synthetic"
+
+
+PLAN_MUTATIONS = [
+    _flag_only,
+    _boolean_plan,
+    _wrong_algorithm,
+    _domain_differs_from_purpose,
+    _reordered_fields,
+    _extra_field,
+    _missing_field,
+    _extra_key,
+]
+
