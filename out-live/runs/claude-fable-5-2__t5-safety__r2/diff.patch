+# --- overdue boundaries -----------------------------------------------------
+
+
+def test_overdue_is_strictly_after_the_deadline():
+    events = [event("A", onset="2024-01-01T00:00:00Z")]
+    deadline = datetime(2024, 1, 31, tzinfo=timezone.utc)
+    tick = timedelta(microseconds=1)
+
+    def overdue(now):
+        [case] = triage_events(events, now=now)
+        assert case["report_by"] == "2024-01-31T00:00:00Z"
+        return case["overdue"]
+
+    assert overdue(deadline - tick) is False
+    assert overdue(deadline) is False
+    assert overdue(deadline + tick) is True
+
+
+def test_overdue_compares_instants_when_now_has_a_non_utc_offset():
+    events = [event("A", onset="2024-01-01T00:00:00Z")]
+    zone = timezone(timedelta(hours=5, minutes=30))
+    at_deadline = datetime(2024, 1, 31, 5, 30, tzinfo=zone)
+
+    assert triage_events(events, now=at_deadline)[0]["overdue"] is False
+    assert (
+        triage_events(events, now=at_deadline + timedelta(microseconds=1))[0]["overdue"]
+        is True
+    )
