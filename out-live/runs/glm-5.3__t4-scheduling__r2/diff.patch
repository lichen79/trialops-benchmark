+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: Mapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Plan visits for one eligible subject, then commit the reservations.
+
+    Eligibility is evaluated first and short-circuits without touching the
+    caller-owned ``capacity`` mapping. Candidate generation, closure handling,
+    DST arithmetic, validation, and within-plan allocation are all delegated to
+    :func:`plan_visits`, so an ``UNSCHEDULABLE`` plan leaves ``capacity``
+    exactly as it was while earlier successful calls stay committed. Reservations
+    are only applied after the whole plan succeeds, and only for dates that are
+    already listed in ``capacity``; unlisted dates keep their unconstrained
+    behaviour and are never inserted.
+    """
+    if not isinstance(capacity, Mapping):
+        raise TypeError("capacity must be a mapping of dates to slots")
+
+    # Evaluate eligibility before any planning work. An ineligible subject must
+    # not change capacity, and protocol/subject are never mutated by the check.
+    result = evaluate_subject(subject, protocol, on)
+    if not result["eligible"]:
+        raise ValueError("INELIGIBLE:" + ",".join(result["reasons"]))
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Only reached on complete success, so the decrement is all-or-nothing with
+    # respect to this call. Earlier successful calls are already committed.
+    for visit in visits:
+        visit_day = date.fromisoformat(visit["local"][:10])
+        if visit_day in capacity:
+            capacity[visit_day] -= 1
 
     return visits
 
