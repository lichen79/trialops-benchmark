+        ({}, {"labs": {"A": [3, 1]}}, "labs.A"),
+        ({}, {"labs": {"A": [1, 2, 3]}}, "labs.A"),
+        ({"labs": {"Z": 15}}, {}, "subject.labs.A"),
+        ({"labs": None}, {}, "subject.labs"),
+        ({"flags": None}, {}, "subject.flags"),
+        ({"flags": ["", "X"]}, {}, "subject.flags"),
+        ({"consents": None}, {}, "subject.consents"),
+        ({"consents": [{"version": "v2"}]}, {}, "subject.consents"),
