+def test_duplicate_roots_are_rejected_and_distinct_roots_stay_separate():
+    with pytest.raises(ValueError, match="DUPLICATE_EVENT_ID"):
+        triage_events(
+            [
+                event("R"),
+                event("F", follow_up_of="R"),
+                event("R", source="site-a"),
+            ],
+            now=NOW,
+        )
+
+    cases = triage_events(
+        [
+            event("R", onset="2024-01-02T00:00:00Z", source="site-a"),
+            event("F", follow_up_of="R", onset="2024-01-01T00:00:00Z", source="site-b"),
+            event("S", onset="2024-01-01T00:00:00Z", source="site-a"),
+        ],
+        now=NOW,
+    )
+
+    # Distinct roots never merge, even when they share onset and source.
+    assert [case["case_id"] for case in cases] == ["S", "R"]
+    assert cases[0]["event_ids"] == ["S"]
+    assert cases[1]["event_ids"] == ["F", "R"]
+
