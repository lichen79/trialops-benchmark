+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot anchored by trusted head and length.
+
+        Both anchors are required: they are the only way to detect edits that
+        were rehashed or a truncated suffix.  The snapshot is materialized
+        exactly once so generators are safe to pass.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError, OverflowError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = cls.verify(
+            materialized, expected_head=expected_head, expected_length=expected_length
+        )
+        if expected_length is None:
+            # ``None`` means "not supplied" to ``verify``; both anchors are
+            # mandatory when restoring a snapshot.
+            errors = sorted(set(errors) | {"LENGTH_MISMATCH"})
+        if not _valid_hash(expected_head):
+            errors = sorted(set(errors) | {"HEAD_MISMATCH"})
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(errors))
+
+        chain = cls()
+        try:
+            chain.records = deepcopy(materialized)
+        except (TypeError, ValueError, OverflowError, RecursionError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = expected_head
