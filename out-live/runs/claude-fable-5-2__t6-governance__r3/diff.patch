+def test_repeated_execution_is_invalid_state_without_another_executor_call():
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request["status"])
+        return {"rows": 1}
+
+    approved = request("approved", approval_expires_on="2025-02-01")
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, executor)
+    snapshot = deepcopy(executed)
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(
+            executed, "execute", "alice", NOW + timedelta(hours=1), executor
+        )
+    assert str(caught.value) == "INVALID_STATE"
+    assert calls == ["approved"]
+    assert executed == snapshot
+    assert [entry["action"] for entry in executed["history"]] == ["execute"]
+
+
+def test_failed_execution_never_reports_executed_and_can_be_retried():
+    approved = request(
+        "approved",
+        approval_expires_on="2025-02-01",
+        history=[{"action": "approve", "actor": "bob", "at": "2024-12-31T12:00:00Z"}],
+    )
+    snapshot = deepcopy(approved)
+    calls = []
+
+    def non_dict_executor(approved_request):
+        calls.append("non-dict")
+        return ["not", "a", "dict"]
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(approved, "execute", "alice", NOW, non_dict_executor)
+    assert str(caught.value) == "EXECUTION_FAILED"
+    assert calls == ["non-dict"]
+    assert approved == snapshot
+    assert "execution_result" not in approved
+
+    returned = {"receipt": {"rows": 2}}
+    executed = apply_reuse_action(
+        approved, "execute", "alice", NOW, lambda approved_request: returned
+    )
+    assert executed["status"] == "executed"
+    assert executed["execution_result"] == {"receipt": {"rows": 2}}
+    assert [entry["action"] for entry in executed["history"]] == [
+        "approve",
+        "execute",
+    ]
+    returned["receipt"]["rows"] = 99
+    assert executed["execution_result"] == {"receipt": {"rows": 2}}
+    assert approved == snapshot
+
