+# --- chained follow-ups -----------------------------------------------------
+
+
+def test_empty_input_yields_no_cases():
+    assert triage_events([], now=NOW) == []
+
+
+def test_input_order_does_not_affect_output():
+    events = [
+        event("X1"),
+        event("X2", follow_up_of="X1", source="site-a", onset="2024-01-12T00:00:00Z"),
+        event("X3", follow_up_of="X2", seriousness="life_threatening", uncertain=True),
+        event("Y1", subject_pseudonym="subject-002", onset="2024-01-09T00:00:00Z"),
+        event("Y2", follow_up_of="Y1", subject_pseudonym="subject-002", source="site-c"),
+    ]
+    baseline = triage_events(events, now=NOW)
+
+    assert [case["case_id"] for case in baseline] == ["Y1", "X1"]
+    assert [case["event_ids"] for case in baseline] == [
+        ["Y1", "Y2"],
+        ["X1", "X2", "X3"],
+    ]
+    for ordering in permutations(events):
+        assert triage_events(ordering, now=NOW) == baseline
+
+
+def test_several_followups_of_one_root_merge_into_one_case():
+    cases = triage_events(
+        [
+            event("C", follow_up_of="A", source="site-a"),
+            event("A"),
+            event("B", follow_up_of="A"),
+        ],
+        now=NOW,
+    )
+
+    assert len(cases) == 1
+    assert cases[0]["case_id"] == "A"
+    assert cases[0]["event_ids"] == ["A", "B", "C"]
+    assert cases[0]["sources"] == ["site-a", "site-b"]
+
+
+def test_unlinked_events_are_never_merged_even_when_identical():
+    cases = triage_events([event("B"), event("A")], now=NOW)
+
+    assert [case["case_id"] for case in cases] == ["A", "B"]
+    assert [case["event_ids"] for case in cases] == [["A"], ["B"]]
+
+
+def test_uncertain_defaults_to_false_and_is_preserved_from_any_event():
+    assert triage_events([event("A")], now=NOW)[0]["uncertain"] is False
+    assert (
+        triage_events(
+            [event("A", uncertain=False), event("B", follow_up_of="A", uncertain=False)],
+            now=NOW,
