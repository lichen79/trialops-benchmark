+def plan_visits(
+    *,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    closed_days: Iterable[date] | None = None,
+    capacity: Mapping[date, int] | None = None,
+) -> list[dict[str, object]]:
+    """Plan visits in protocol order without modifying caller-owned mappings."""
+    return [
+        visit
+        for _, visit in _plan(
+            first_day=first_day,
+            offsets_months=offsets_months,
+            hour=hour,
+            minute=minute,
+            timezone=timezone,
+            closed_days=closed_days,
+            capacity=capacity,
+        )
+    ]
+
