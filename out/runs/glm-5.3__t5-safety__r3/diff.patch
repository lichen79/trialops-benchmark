+def test_report_by_overflow_raises_a_stable_code():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    with pytest.raises(ValueError, match="REPORT_BY_OUT_OF_RANGE"):
+        triage_events(
+            [event("A", onset="9999-12-31T23:59:59+00:00", seriousness="fatal")],
+            now=now,
+        )
