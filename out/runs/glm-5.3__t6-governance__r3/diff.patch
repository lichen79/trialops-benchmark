+def test_history_is_append_only_and_strictly_chronological():
+    steps = [
+        (
+            datetime(2025, 1, 1, 7, 0, tzinfo=timezone(timedelta(hours=-5))),
+            "submit",
+            "alice",
+            None,
+        ),
+        (
+            datetime(2025, 1, 2, 13, 0, tzinfo=timezone(timedelta(hours=1))),
+            "approve",
+            "bob",
+            None,
+        ),
+        (
+            datetime(2025, 1, 2, 19, 0, tzinfo=timezone(timedelta(hours=5, minutes=30))),
+            "execute",
+            "alice",
+            successful_executor,
+        ),
+    ]
+    expected_at = [
+        "2025-01-01T12:00:00Z",
+        "2025-01-02T12:00:00Z",
+        "2025-01-02T13:30:00Z",
+    ]
+    current = request(history=[{"action": "imported", "at": "2024-12-31T09:00:00Z"}])
+    imported = deepcopy(current["history"])
+
+    for (at, action, actor, executor), stamp in zip(steps, expected_at):
+        previous = deepcopy(current)
+        current = apply_reuse_action(current, action, actor, at, executor)
+        assert current["history"][: len(previous["history"])] == previous["history"]
+        assert current["history"][-1] == {"action": action, "actor": actor, "at": stamp}
+
+    assert current["status"] == "executed"
+    assert current["history"][0] == imported[0]
+    stamps = [entry["at"] for entry in current["history"]]
+    assert stamps[1:] == expected_at
+    assert stamps == sorted(stamps)
+    assert len(set(stamps)) == len(stamps)
+
+    # Expiry keeps the same invariant and can be triggered by any actor.
+    stale = apply_reuse_action(
+        request("submitted", retention_until="2024-12-31"),
+        "expire",
+        "retention-sweeper",
+        datetime(2025, 1, 4, 8, 0, tzinfo=timezone.utc),
+    )
+    assert stale["status"] == "expired"
+    assert stale["history"][-1] == {
+        "action": "expire",
+        "actor": "retention-sweeper",
+        "at": "2025-01-04T08:00:00Z",
+    }
+    stamps = [entry["at"] for entry in stale["history"]]
+    assert stamps == sorted(stamps)
+
+    # Any actor may expire an approved request whose approval window closed.
+    approved_request = apply_reuse_action(request("submitted"), "approve", "bob", NOW)
+    expired = apply_reuse_action(
+        approved_request, "expire", "retention-sweeper", NOW + timedelta(days=31)
+    )
+    assert expired["status"] == "expired"
+    assert [entry["action"] for entry in expired["history"]] == ["approve", "expire"]
+    stamps = [entry["at"] for entry in expired["history"]]
+    assert stamps == sorted(stamps)
