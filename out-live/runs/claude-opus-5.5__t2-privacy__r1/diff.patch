+def test_signed_on_boundary_and_purpose_scoping():
+    future = make_subject("future")
+    future["consents"][0]["signed_on"] = "2024-06-16"
+    other = make_subject("other")
+    other["consents"][0]["purpose"] = "marketing"
+    signed_today = make_subject("today")
+
+    result = export_subjects(
+        [future, other, signed_today], purpose="research", secret="test-secret", on=ON
+    )
+    assert [row["pseudonym"] for row in result["rows"]] == [pseudonym("today")]
+
+
+def test_output_is_deterministic_regardless_of_input_order():
+    subjects = [make_subject(f"subject-{index}") for index in range(5)]
+    first = export_subjects(subjects, purpose="research", secret="test-secret", on=ON)
+    second = export_subjects(
+        list(reversed(deepcopy(subjects))), purpose="research", secret="test-secret", on=ON
+    )
+    assert first == second
+    assert canonical(first) == canonical(second)
+    other_purpose = export_subjects(
+        [make_subject("subject-0", consents=[{"purpose": "qa", "signed_on": "2024-01-01"}])],
+        purpose="qa",
+        secret="test-secret",
+        on=ON,
+    )
+    assert other_purpose["rows"][0]["pseudonym"] == pseudonym("subject-0", purpose="qa")
+    assert other_purpose["rows"][0]["pseudonym"] != pseudonym("subject-0")
+
+
