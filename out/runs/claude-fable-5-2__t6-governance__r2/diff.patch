+    assert_rejected_atomically(
+        request(
+            "approved", approval_expires_on="2025-02-01", privacy_plan=privacy_plan
+        ),
+        "execute",
+        "alice",
+        "PSEUDONYMIZATION_REQUIRED",
+    )
