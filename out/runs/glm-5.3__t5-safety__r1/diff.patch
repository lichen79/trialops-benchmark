+
+def test_overdue_is_strict_and_follows_earliest_onset():
+    root = event("A", onset="2024-01-10T08:00:00Z", seriousness="hospitalization")
+    late_follow_up = event("B", follow_up_of="A", onset="2024-02-01T00:00:00Z")
+
+    # report_by depends on the earliest onset, not on the follow-up arrival.
+    case = triage_events(
+        [root, late_follow_up], now=datetime(2024, 2, 1, tzinfo=timezone.utc)
+    )
+    assert case[0]["report_by"] == "2024-01-25T08:00:00Z"
+    assert case[0]["overdue"] is True
+
+    one_second_before = datetime(2024, 1, 25, 7, 59, 59, tzinfo=timezone.utc)
