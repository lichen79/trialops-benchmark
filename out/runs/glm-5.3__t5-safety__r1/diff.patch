+            "sources": ["site-b"],
+            "event_ids": ["C", "D"],
+            "uncertain": False,
+            "overdue": False,
+        },
+    ]
+
+
+def test_seriousness_precedence_and_each_reporting_window():
+    now = datetime(2024, 1, 1, tzinfo=timezone.utc)
+    expected = {
+        "other": ("other", "2024-02-09T08:00:00Z"),
+        "hospitalization": ("hospitalization", "2024-01-25T08:00:00Z"),
+        "life_threatening": ("life_threatening", "2024-01-17T08:00:00Z"),
+        "fatal": ("fatal", "2024-01-17T08:00:00Z"),
+    }
+    for member in ("root_only", "follow_up_only", "both"):
+        for seriousness, (rank, report_by) in expected.items():
+            if member == "root_only":
+                events = [event("A", seriousness=seriousness)]
+            elif member == "follow_up_only":
+                events = [
+                    event("A", seriousness="other"),
+                    event("B", follow_up_of="A", seriousness=seriousness),
