--- a/trialops/audit.py	2026-11-13 20:17:29
+++ b/trialops/audit.py	2026-11-14 11:16:44
@@ -82,6 +82,32 @@
         self.records: list[dict[str, Any]] = []
         self._event_ids: set[str] = set()
 
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a verified snapshot without sharing its mutable records."""
+
+        snapshot = list(records)
+        errors = cls.verify(
+            snapshot,
+            expected_head=expected_head,
+            expected_length=expected_length,
+        )
+        if errors:
+            raise ValueError(f"INVALID_CHAIN:{','.join(sorted(errors))}")
+
+        chain = cls()
+        chain.records = deepcopy(snapshot)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = (
+            chain.records[-1]["hash"] if chain.records else GENESIS_HASH
+        )
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
