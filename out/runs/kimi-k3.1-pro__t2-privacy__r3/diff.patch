+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request and attach its privacy export."""
+
+    def executor(approved: Mapping[str, Any]) -> dict[str, Any]:
+        # Governance has already validated ``now`` before invoking the executor.
+        on = now.astimezone(timezone.utc).date()
+        return export_subjects(
+            subjects, purpose=approved.get("purpose"), secret=secret, on=on
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
