+def reuse_request(status="approved", **changes):
+    purpose = changes.get("purpose", "research")
+    value = {
+        "id": "reuse-001",
+        "requester": "alice",
+        "reviewer": "bob",
+        "purpose": purpose,
+        "status": status,
+        "retention_until": "2025-06-30",
+        "approval_expires_on": "2025-02-01",
+        "privacy_plan": {
+            "algorithm": "hmac-sha256",
+            "domain": purpose,
+            "fields": ["pseudonym", "country", "birth_year", "visits"],
+        },
+        "metadata": {
+            "representative": True,
+            "complete": True,
+            "quality_score": 0.95,
+        },
+        "history": [],
+    }
+    value.update(changes)
+    return value
+
