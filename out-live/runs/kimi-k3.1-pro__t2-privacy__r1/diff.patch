@@ -140,5 +140,39 @@
             "sha256": hashlib.sha256(canonical_rows).hexdigest(),
         },
     }
+
+
+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request without exposing its source records."""
+
+    # Keep the governance transition and its failure/rollback semantics in one
+    # place. In particular, governance checks run before this executor consumes
+    # a possibly one-shot iterable of subjects.
+    from trialops.governance import apply_reuse_action
+
+    def executor(approved_request: Mapping[str, Any]) -> dict[str, Any]:
+        # Governance has already validated that ``now`` is timezone-aware.
+        on = now.astimezone(timezone.utc).date()
+        return export_subjects(
+            subjects,
+            purpose=approved_request["purpose"],
+            secret=secret,
+            on=on,
+        )
+
+    return apply_reuse_action(
+        request,
+        "execute",
+        actor,
+        now,
+        executor=executor,
+    )
 
 
