+@pytest.mark.parametrize(
+    ("corrupt", "field"),
+    [
+        (lambda protocol: protocol.update(required_consent_version=""), "required_consent_version"),
+        (lambda protocol: protocol.update(consent_valid_from="yesterday"), "consent_valid_from"),
+        (lambda protocol: protocol.update(min_age=-1), "min_age"),
+        (lambda protocol: protocol.update(max_age="old"), "max_age"),
+        (lambda protocol: protocol.update(labs={"A": [3, 1]}), "labs.A"),
+        (lambda protocol: protocol.update(labs={"A": [1, 3, 5]}), "labs.A"),
+        (lambda protocol: protocol.update(exclusions="DO_NOT_ENROLL"), "exclusions"),
+        (lambda protocol: protocol.update(exclusions=[""]), "exclusions"),
+        (lambda protocol: protocol.update(labs={"A": "1"}), "labs.A"),
+    ],
+)
