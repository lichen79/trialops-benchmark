+def test_history_is_chronological_and_normalized_to_utc():
+    plus_two = timezone(timedelta(hours=2))
+    minus_five = timezone(timedelta(hours=-5))
+    earlier = [{"action": "imported", "actor": "system", "at": "2024-12-01T00:00:00Z"}]
+
+    submitted = apply_reuse_action(
+        request(history=earlier),
+        "submit",
+        "alice",
+        datetime(2025, 1, 1, 1, 30, tzinfo=plus_two),
+    )
+    approved = apply_reuse_action(
+        submitted, "approve", "bob", datetime(2025, 1, 1, 23, 30, tzinfo=minus_five)
+    )
+    executed = apply_reuse_action(
+        approved,
+        "execute",
+        "alice",
+        datetime(2025, 1, 3, 9, 0, tzinfo=timezone.utc),
+        successful_executor,
+    )
+
+    assert earlier == [
+        {"action": "imported", "actor": "system", "at": "2024-12-01T00:00:00Z"}
+    ]
+    assert len(submitted["history"]) == 2
+    assert len(approved["history"]) == 3
+    assert executed["history"] == [
+        {"action": "imported", "actor": "system", "at": "2024-12-01T00:00:00Z"},
+        {"action": "submit", "actor": "alice", "at": "2024-12-31T23:30:00Z"},
+        {"action": "approve", "actor": "bob", "at": "2025-01-02T04:30:00Z"},
+        {"action": "execute", "actor": "alice", "at": "2025-01-03T09:00:00Z"},
+    ]
+    stamps = [entry["at"] for entry in executed["history"]]
+    assert stamps == sorted(stamps)
+    # The approval window is counted from the UTC-normalized approval date.
+    assert approved["approval_expires_on"] == "2025-02-01"
+
