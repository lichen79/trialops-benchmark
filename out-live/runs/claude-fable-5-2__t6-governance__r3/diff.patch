+def test_approval_and_execution_require_the_exact_privacy_plan(
+    alter, status, action, actor
+):
+    candidate = request(status, approval_expires_on="2025-02-01")
+    alter(candidate)
+    snapshot = deepcopy(candidate)
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    with pytest.raises(ValueError) as caught:
+        apply_reuse_action(candidate, action, actor, NOW, executor)
+    assert str(caught.value) == "PSEUDONYMIZATION_REQUIRED"
+    assert calls == []
+    assert candidate == snapshot
+
+
+def test_execution_rechecks_metadata_and_retention_before_calling_executor():
+    calls = []
+
+    def executor(approved_request):
+        calls.append(approved_request)
+        return {"rows": 1}
+
+    def rejected(candidate, code):
+        snapshot = deepcopy(candidate)
+        with pytest.raises(ValueError) as caught:
+            apply_reuse_action(candidate, "execute", "alice", NOW, executor)
+        assert str(caught.value) == code
+        assert candidate == snapshot
+
+    no_metadata = request("approved", approval_expires_on="2025-02-01")
+    del no_metadata["metadata"]
+    rejected(no_metadata, "METADATA_REQUIRED")
+
+    for key in ("representative", "complete", "quality_score"):
+        missing_key = request("approved", approval_expires_on="2025-02-01")
+        del missing_key["metadata"][key]
+        rejected(missing_key, "METADATA_REQUIRED")
+
+    unrepresentative = request("approved", approval_expires_on="2025-02-01")
+    unrepresentative["metadata"]["representative"] = False
+    rejected(unrepresentative, "METADATA_REQUIRED")
+
+    low_quality = request("approved", approval_expires_on="2025-02-01")
+    low_quality["metadata"]["quality_score"] = 0.94
+    rejected(low_quality, "METADATA_REQUIRED")
+
+    rejected(
+        request("approved", approval_expires_on="2025-02-01", purpose=""),
+        "METADATA_REQUIRED",
+    )
+    rejected(
+        request(
+            "approved",
+            approval_expires_on="2025-02-01",
+            retention_until="2024-12-31",
+        ),
+        "RETENTION_EXPIRED",
+    )
+    rejected(request("approved"), "APPROVAL_EXPIRED")
+    assert calls == []
+
+    on_retention_date = request(
+        "approved", approval_expires_on="2025-02-01", retention_until="2025-01-01"
+    )
+    assert apply_reuse_action(
+        on_retention_date, "execute", "alice", NOW, executor
+    )["status"] == "executed"
+    assert len(calls) == 1
+
+
+def test_missing_metadata_blocks_approval():
+    no_metadata = request("submitted")
+    del no_metadata["metadata"]
+    with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+        apply_reuse_action(no_metadata, "approve", "bob", NOW)
+
+    for key in ("representative", "complete", "quality_score"):
+        missing_key = request("submitted")
+        del missing_key["metadata"][key]
+        with pytest.raises(ValueError, match="METADATA_REQUIRED"):
+            apply_reuse_action(missing_key, "approve", "bob", NOW)
+
+    on_retention_date = request("submitted", retention_until="2025-01-01")
+    assert apply_reuse_action(on_retention_date, "approve", "bob", NOW)[
+        "status"
+    ] == "approved"
+
