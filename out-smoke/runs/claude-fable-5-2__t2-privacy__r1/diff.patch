+def _utc_date(now: Any) -> date:
+    if (
+        not isinstance(now, datetime)
+        or now.tzinfo is None
+        or now.utcoffset() is None
+    ):
+        raise ValueError("now must be a timezone-aware datetime")
+    return now.astimezone(timezone.utc).date()
+
+
+def execute_reuse_export(
+    request: dict[str, Any],
+    subjects: Iterable[Mapping[str, Any]],
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, Any]:
+    """Execute an approved reuse request by exporting subjects for its purpose.
+
+    Governance decides whether the request may execute; subjects are only
+    consumed by the executor, which runs after every governance check passed.
+    Export failures surface as ``EXECUTION_FAILED`` and leave ``request`` as is.
+    """
+
+    def executor(approved: Mapping[str, Any]) -> dict[str, Any]:
+        return export_subjects(
+            subjects,
+            purpose=approved["purpose"],
+            secret=secret,
+            on=_utc_date(now),
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
 
 
