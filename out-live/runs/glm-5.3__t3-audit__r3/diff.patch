--- a/tests/test_audit.py	2026-11-13 14:56:35
+++ b/tests/test_audit.py	2026-11-14 11:44:26
@@ -156,3 +156,298 @@
     )
 
     assert record["hash"] == "92d5600f044f4bcd2134215e770f49cac60926e50670c3f58930eba13db528ba"
+
+
+def snapshot_of(chain):
+    """Simulate a persisted snapshot: plain dicts, JSON-safe values."""
+    return json.loads(json.dumps(deepcopy(chain.records)))
+
+
+def restore_error(records, *, expected_head, expected_length):
+    """Return the exact ValueError message raised by from_records."""
+    with pytest.raises(ValueError) as excinfo:
+        AuditChain.from_records(
+            records, expected_head=expected_head, expected_length=expected_length
+        )
+    return str(excinfo.value)
+
+
+def build_chain(count=2):
+    chain = AuditChain()
+    for index in range(count):
+        append_event(
+            chain,
+            event_id=f"event-{index + 1}",
+            at=AT + timedelta(seconds=index),
+            payload={"index": index, "nested": {"b": 2, "a": 1}},
+        )
+    return chain
+
+
+def test_restore_and_continue():
+    original = build_chain(2)
+    snapshot = snapshot_of(original)
+    trusted_head = original.head()
+
+    restored = AuditChain.from_records(
+        snapshot, expected_head=trusted_head, expected_length=2
+    )
+
+    assert restored.records == snapshot
+    assert restored.head() == trusted_head
+    assert restored.previous_hash == trusted_head
+    assert AuditChain.verify(restored.records) == []
+
+    continued = append_event(
+        restored, "event-3", AT + timedelta(seconds=5), payload={"value": 3}
+    )
+    assert continued["sequence"] == 3
+    assert continued["previous_hash"] == trusted_head
+    assert restored.head() == continued["hash"]
+    assert len(restored.records) == 3
+    assert AuditChain.verify(restored.records) == []
+
+
+def test_restore_generator_input_is_materialized_once():
+    original = build_chain(2)
+    snapshot = snapshot_of(original)
+
+    restored = AuditChain.from_records(
+        iter(snapshot), expected_head=original.head(), expected_length=2
+    )
+
+    assert restored.records == snapshot
+
+
+def test_restore_rejects_duplicate_event_ids_on_append():
+    original = build_chain(2)
+    restored = AuditChain.from_records(
+        snapshot_of(original), expected_head=original.head(), expected_length=2
+    )
+
+    with pytest.raises(ValueError, match="unique"):
+        append_event(restored, event_id="event-1", at=AT + timedelta(seconds=9))
+
+    assert len(restored.records) == 2
+    assert restored.head() == original.head()
+
+
+def test_restore_deep_copy_independence():
+    original = build_chain(2)
+    snapshot = snapshot_of(original)
+    restored = AuditChain.from_records(
+        snapshot, expected_head=original.head(), expected_length=2
+    )
+
+    assert restored.records is not snapshot
+    assert restored.records[0] is not snapshot[0]
+
+    # Mutating the persisted snapshot never affects the restored chain.
+    snapshot[0]["payload"]["nested"]["a"] = 999
+    snapshot[1]["actor"] = "someone-else"
+    snapshot.append({"bogus": True})
+    assert restored.records[0]["payload"]["nested"]["a"] == 1
+    assert restored.records[1]["actor"] == "actor-1"
+    assert len(restored.records) == 2
+    assert restored.head() == original.head()
+
+    # Mutating the restored chain never affects the snapshot either.
+    restored.records[0]["payload"]["index"] = -1
+    assert snapshot[0]["payload"]["index"] == 0
+
+
+def test_restored_instances_are_independent():
+    original = build_chain(2)
+    snapshot = snapshot_of(original)
+    head = original.head()
+
+    first = AuditChain.from_records(snapshot, expected_head=head, expected_length=2)
+    second = AuditChain.from_records(snapshot, expected_head=head, expected_length=2)
+
+    assert first is not second
+    assert first.records is not second.records
+
+    first_record = append_event(first, "event-3", AT + timedelta(seconds=3))
+    assert first_record["sequence"] == 3
+    assert len(second.records) == 2
+    assert second.head() == head
+    with pytest.raises(ValueError, match="unique"):
+        append_event(second, "event-1", AT + timedelta(seconds=4))
+    assert len(second.records) == 2
+
+
+def test_restore_with_wrong_anchors():
+    original = build_chain(2)
+    snapshot = snapshot_of(original)
+    head = original.head()
+
+    assert (
+        restore_error(snapshot, expected_head=GENESIS_HASH, expected_length=2)
+        == "INVALID_CHAIN:HEAD_MISMATCH"
+    )
+    assert (
+        restore_error(snapshot, expected_head=head, expected_length=3)
+        == "INVALID_CHAIN:LENGTH_MISMATCH"
+    )
+    assert (
+        restore_error(snapshot, expected_head=GENESIS_HASH, expected_length=0)
+        == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+    )
+
+
+def test_restore_rejects_truncated_suffix():
+    original = build_chain(3)
+    head = original.head()
+
+    # A suffix-truncated (and rehashed) prefix is internally valid on its own...
+    truncated = snapshot_of(original)[:2]
+    rehash(truncated[1])
+    assert AuditChain.verify(truncated) == []
+
+    # ...but the trusted anchors reject it.
+    assert (
+        restore_error(truncated, expected_head=head, expected_length=3)
+        == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH"
+    )
+
+    # Truncating to a prefix whose head matches a stale anchor is still wrong.
+    assert (
+        restore_error(
+            truncated, expected_head=truncated[-1]["hash"], expected_length=3
+        )
+        == "INVALID_CHAIN:LENGTH_MISMATCH"
+    )
+
+
+def test_restore_rejects_unrehashed_and_rehashed_edits():
+    original = build_chain(2)
+    head = original.head()
+
+    # Un-rehashed edit of an early record.
+    edited = snapshot_of(original)
+    edited[0]["payload"]["index"] = 42
+    assert (
+        restore_error(edited, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:BAD_HASH"
+    )
+
+    # Rehashed edit of the head record: internally consistent, but the head
+    # no longer matches the trusted anchor.
+    rehashed = snapshot_of(original)
+    rehashed[1]["payload"]["index"] = 42
+    rehash(rehashed[1])
+    assert (
+        restore_error(rehashed, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:HEAD_MISMATCH"
+    )
+
+    # Rehashed edit of an early record: the edit is rehashed but the following
+    # record still points at the old hash, so linkage breaks.
+    partially_relinked = snapshot_of(original)
+    partially_relinked[0]["payload"]["index"] = 42
+    rehash(partially_relinked[0])
+    assert (
+        restore_error(partially_relinked, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:BAD_PREVIOUS_HASH"
+    )
+
+    # A fully re-linked suffix is internally valid, so only the trusted head
+    # catches it.
+    fully_relinked = snapshot_of(original)
+    fully_relinked[0]["payload"]["index"] = 42
+    rehash(fully_relinked[0])
+    fully_relinked[1]["previous_hash"] = fully_relinked[0]["hash"]
+    rehash(fully_relinked[1])
+    assert AuditChain.verify(fully_relinked) == []
+    assert (
+        restore_error(fully_relinked, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:HEAD_MISMATCH"
+    )
+
+
+def test_restore_empty_snapshot():
+    chain = AuditChain()
+    assert chain.head() == GENESIS_HASH
+
+    restored = AuditChain.from_records(
+        [], expected_head=GENESIS_HASH, expected_length=0
+    )
+    assert restored.records == []
+    assert restored.head() == GENESIS_HASH
+    assert restored.previous_hash == GENESIS_HASH
+
+    record = append_event(restored)
+    assert record["sequence"] == 1
+    assert record["previous_hash"] == GENESIS_HASH
+    assert AuditChain.verify(restored.records) == []
+
+
+def test_restore_empty_snapshot_with_non_genesis_anchors():
+    assert (
+        restore_error([], expected_head="1" * 64, expected_length=0)
+        == "INVALID_CHAIN:HEAD_MISMATCH"
+    )
+    assert (
+        restore_error([], expected_head=GENESIS_HASH, expected_length=1)
+        == "INVALID_CHAIN:LENGTH_MISMATCH"
+    )
+
+
+def test_restore_requires_both_anchors():
+    original = build_chain(1)
+    snapshot = snapshot_of(original)
+
+    with pytest.raises(TypeError):
+        AuditChain.from_records(snapshot, expected_head=original.head())
+    with pytest.raises(TypeError):
+        AuditChain.from_records(snapshot, expected_length=1)
+    with pytest.raises(TypeError):
+        AuditChain.from_records(snapshot)
+
+
+def test_restore_rejects_malformed_snapshots():
+    original = build_chain(2)
+    head = original.head()
+
+    # Verification must not normalize the stored timestamp representation.
+    broken = snapshot_of(original)
+    broken[0]["at"] = "2024-06-15 12:00:00"
+    assert (
+        restore_error(broken, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:BAD_HASH,MALFORMED_TIMESTAMP"
+    )
+
+    # A timestamp that is equivalent-but-not-canonical must be rejected.
+    broken = snapshot_of(original)
+    broken[0]["at"] = "2024-06-15T12:00:00+00:00"
+    assert (
+        restore_error(broken, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:BAD_HASH,MALFORMED_TIMESTAMP"
+    )
+
+    duplicate = snapshot_of(build_chain(1))
+    assert (
+        restore_error(
+            [duplicate[0], deepcopy(duplicate[0])],
+            expected_head=head,
+            expected_length=2,
+        )
+        == "INVALID_CHAIN:BAD_PREVIOUS_HASH,BAD_SEQUENCE,DUPLICATE_EVENT_ID,HEAD_MISMATCH,NON_INCREASING_TIMESTAMP"
+    )
+
+    non_dict_payload = snapshot_of(original)
+    non_dict_payload[0]["payload"] = "not-a-dict"
+    assert (
+        restore_error(non_dict_payload, expected_head=head, expected_length=2)
+        == "INVALID_CHAIN:BAD_HASH,BAD_PAYLOAD"
+    )
+
+    assert (
+        restore_error(None, expected_head=head, expected_length=1)
+        == "INVALID_CHAIN:MALFORMED_RECORD"
+    )
+    # A string is iterable: each character is a malformed record.
+    assert (
+        restore_error("nope", expected_head=head, expected_length=1)
+        == "INVALID_CHAIN:HEAD_MISMATCH,LENGTH_MISMATCH,MALFORMED_RECORD"
+    )
