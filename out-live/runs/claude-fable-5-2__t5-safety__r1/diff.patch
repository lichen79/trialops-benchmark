+def test_branching_and_deep_followups_resolve_to_one_root():
+    events = [
+        event("E4", follow_up_of="E3", source="site-d"),
+        event("E2", follow_up_of="E1", source="site-a"),
+        event("E3", follow_up_of="E1", source="site-a"),
+        event("E1", source="site-c"),
+    ]
+
+    [case] = triage_events(events, now=NOW)
+
+    assert case["case_id"] == "E1"
+    assert case["event_ids"] == ["E1", "E2", "E3", "E4"]
+    assert case["sources"] == ["site-a", "site-c", "site-d"]
