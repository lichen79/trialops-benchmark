+def test_stale_approval_boundaries_after_a_real_approval():
+    submitted = request("submitted")
+    approved = apply_reuse_action(submitted, "approve", "bob", NOW)
+    assert approved["approval_expires_on"] == "2025-01-31"
+
+    last_valid_moment = datetime(2025, 1, 31, 23, 59, 59, tzinfo=timezone.utc)
+    first_stale_moment = datetime(2025, 2, 1, 0, 0, tzinfo=timezone.utc)
+
+    # Not yet stale: it cannot be expired, and it can still be executed.
+    assert_fails_atomically(
+        approved, "expire", "system", last_valid_moment, "INVALID_STATE"
+    )
+    executor = RecordingExecutor()
+    assert apply_reuse_action(
+        approved, "execute", "alice", last_valid_moment, executor
+    )["status"] == "executed"
+    assert len(executor.calls) == 1
+
+    # Stale: execution is refused without touching the executor.
+    stale_executor = RecordingExecutor()
+    assert_fails_atomically(
+        approved,
+        "execute",
+        "alice",
+        first_stale_moment,
+        "APPROVAL_EXPIRED",
+        stale_executor,
+    )
+    assert stale_executor.calls == []
+
+    expired = apply_reuse_action(approved, "expire", "system", first_stale_moment)
+    assert expired["status"] == "expired"
+    assert_fails_atomically(
+        expired,
+        "execute",
+        "alice",
+        first_stale_moment,
+        "INVALID_STATE",
+        stale_executor,
+    )
+    assert stale_executor.calls == []
+
