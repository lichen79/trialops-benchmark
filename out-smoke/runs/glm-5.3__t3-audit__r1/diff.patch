+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot validated against trusted anchors."""
+
+        if expected_head is None:
+            raise TypeError("from_records() requires expected_head")
+        if expected_length is None:
+            raise TypeError("from_records() requires expected_length")
+
+        # Materialize once so generators are not consumed by verification.
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = cls.verify(
+            materialized,
+            expected_head=expected_head,
+            expected_length=expected_length,
+        )
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(errors))
+
+        chain = cls()
+        chain.records = deepcopy(materialized)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = (
+            GENESIS_HASH if not chain.records else chain.records[-1]["hash"]
+        )
+        return chain
 
