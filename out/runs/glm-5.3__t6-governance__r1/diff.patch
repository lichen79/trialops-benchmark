+def test_privacy_plan_must_be_exact_not_a_legacy_boolean():
+    legacy = request("submitted")
+    legacy["pseudonymized"] = True
+    del legacy["privacy_plan"]
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(legacy, "approve", "bob", NOW)
+
+    approved_legacy = request("approved", approval_expires_on="2025-02-01")
+    approved_legacy["pseudonymized"] = True
+    del approved_legacy["privacy_plan"]
+    with pytest.raises(ValueError, match="PSEUDONYMIZATION_REQUIRED"):
+        apply_reuse_action(approved_legacy, "execute", "alice", NOW, successful_executor)
+
