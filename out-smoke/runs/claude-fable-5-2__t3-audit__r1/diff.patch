diff -ruN -x __pycache__ -x .pytest_cache a/trialops/audit.py b/trialops/audit.py
--- a/trialops/audit.py	2026-11-13 20:17:29
+++ b/trialops/audit.py	2026-11-13 20:21:32
@@ -82,6 +82,49 @@
         self.records: list[dict[str, Any]] = []
         self._event_ids: set[str] = set()
 
+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a chain from a persisted snapshot and its trusted anchors.
+
+        The snapshot is accepted only when it passes ``verify`` against both
+        the trusted head and the trusted length; otherwise ``ValueError`` is
+        raised with ``INVALID_CHAIN:`` followed by the sorted error codes.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN:MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                materialized,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # ``verify`` treats None as "anchor not supplied"; a restore always
+        # needs both anchors, so a missing or non-string one is a mismatch.
+        if not isinstance(expected_head, str):
+            errors.add("HEAD_MISMATCH")
+        if expected_length is None:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN:" + ",".join(sorted(errors)))
+
+        chain = cls()
+        chain.records = deepcopy(materialized)
+        chain._event_ids = {record["event_id"] for record in chain.records}
+        chain.previous_hash = (
+            chain.records[-1]["hash"] if chain.records else GENESIS_HASH
+        )
+        return chain
 
     def head(self) -> str:
         """Return the current trusted head, or the genesis hash when empty."""
