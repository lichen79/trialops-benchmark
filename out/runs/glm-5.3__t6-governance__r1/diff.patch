+def test_repeated_execution_is_invalid_state_without_another_executor_call():
+    approved = request("approved", approval_expires_on="2025-02-01")
+    calls = []
+
+    def counting_executor(approved_request):
+        calls.append(approved_request)
+        return {"receipt": "synthetic-execution-001"}
+
+    executed = apply_reuse_action(approved, "execute", "alice", NOW, counting_executor)
+    assert executed["status"] == "executed"
+    assert executed["execution_result"] == {"receipt": "synthetic-execution-001"}
+    assert executed["history"] == [
+        {"action": "execute", "actor": "alice", "at": "2025-01-01T12:00:00Z"}
+    ]
+
+    with pytest.raises(ValueError, match="INVALID_STATE"):
+        apply_reuse_action(executed, "execute", "alice", NOW, counting_executor)
+
+    assert len(calls) == 1
+    assert executed["status"] == "executed"
+    assert len(executed["history"]) == 1
+
