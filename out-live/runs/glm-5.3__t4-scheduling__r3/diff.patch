+def _visit_day(visit: Mapping[str, object]) -> date:
+    """Recover the planned calendar day of one returned visit."""
+    local = visit.get("local")
+    if not isinstance(local, str):
+        raise ValueError("INVALID_LOCAL_TIME")
+    try:
+        return date.fromisoformat(local[:10])
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError("INVALID_LOCAL_TIME") from exc
+
+
+def book_subject_visits(
+    subject: Mapping[str, Any],
+    protocol: Mapping[str, Any],
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: Mapping[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Evaluate eligibility, plan, and only then commit slot reservations.
+
+    Candidate generation, closure handling, DST resolution, validation, and
+    within-plan slot allocation are all delegated to :func:`plan_visits`, which
+    plans against a private copy of ``capacity``. Reservations are applied to
+    the caller's mapping only after the whole plan succeeded, so any failure
+    leaves ``capacity`` exactly unchanged, while reservations committed by
+    earlier successful calls remain in place.
+    """
+    if not isinstance(capacity, Mapping):
+        raise TypeError("capacity must be a mapping of dates to slots")
+
+    evaluation = evaluate_subject(subject, protocol, on)
+    reasons = evaluation.get("reasons")
+    if not evaluation.get("eligible"):
+        ordered_reasons = list(reasons) if isinstance(reasons, list) else []
+        raise ValueError(f"INELIGIBLE:{','.join(ordered_reasons)}")
+
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+
+    # Compute every reservation first: a successful plan guarantees each listed
+    # day has a positive slot count, but a caller-owned mapping may still be
+    # mutated concurrently or carry exotic types, so validation is repeated
+    # here before any assignment is made. Dates absent from ``capacity`` are
+    # unconstrained and are therefore never inserted.
+    reservations: list[tuple[date, int]] = []
+    for visit in visits:
+        visit_day = _visit_day(visit)
+        if visit_day not in capacity:
+            continue
+        slots = capacity[visit_day]
+        if not _plain_integer(slots) or slots < 1:
+            raise ValueError("INVALID_CAPACITY")
+        reservations.append((visit_day, slots - 1))
+
+    for visit_day, remaining_slots in reservations:
+        capacity[visit_day] = remaining_slots  # type: ignore[index]
+
+    return visits
