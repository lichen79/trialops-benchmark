+            consents=[{"purpose": "research", "signed_on": "2024-06-15", "withdrawn_on": "x"}],
+        ),
+    ]
+    for subject in cases:
+        with pytest.raises(ValueError) as caught:
+            export_subjects([subject], purpose="research", secret="test-secret", on=ON)
+        for identifier in ("sensitive-id", "Fictional Person", "person@example.test", "test-secret"):
