+    @classmethod
+    def from_records(
+        cls,
+        records: Any,
+        *,
+        expected_head: str,
+        expected_length: int,
+    ) -> "AuditChain":
+        """Restore a persisted snapshot validated against trusted anchors.
+
+        Both anchors are required: ``expected_head`` is the hash of the last
+        record (``GENESIS_HASH`` for an empty snapshot) and
+        ``expected_length`` is the number of records. The input is materialized
+        exactly once, verified with those anchors, and only then deep copied
+        into an independent chain that can be extended further.
+        """
+
+        try:
+            materialized = list(records)
+        except (TypeError, ValueError):
+            raise ValueError("INVALID_CHAIN: MALFORMED_RECORD") from None
+
+        errors = set(
+            cls.verify(
+                materialized,
+                expected_head=expected_head,
+                expected_length=expected_length,
+            )
+        )
+        # ``verify`` treats ``None`` anchors as "not supplied"; a restore always
+        # requires both trusted anchors, so reject anything that is not usable.
+        if not isinstance(expected_head, str):
+            errors.add("HEAD_MISMATCH")
+        if type(expected_length) is not int:
+            errors.add("LENGTH_MISMATCH")
+        if errors:
+            raise ValueError("INVALID_CHAIN: " + ", ".join(sorted(errors)))
+
+        try:
+            restored = deepcopy(materialized)
+        except (TypeError, ValueError, AttributeError, RecursionError):
+            raise ValueError("INVALID_CHAIN: MALFORMED_RECORD") from None
+
+        chain = cls()
+        chain.records = restored
+        chain._event_ids = {record["event_id"] for record in restored}
+        chain.previous_hash = restored[-1]["hash"] if restored else GENESIS_HASH
+        return chain
 
