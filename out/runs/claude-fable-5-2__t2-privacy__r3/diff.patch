+def exception_chain_text(error):
+    """Render an exception together with every chained cause and context."""
+    parts, pending, seen = [], [error], set()
+    while pending:
+        current = pending.pop()
+        if current is None or id(current) in seen:
+            continue
+        seen.add(id(current))
+        parts.extend([str(current), repr(current)])
+        pending.extend([current.__cause__, current.__context__])
+    return "\n".join(parts)
+
+
+def exported(subjects, *, on=ON, purpose="research"):
+    result = export_subjects(subjects, purpose=purpose, secret="test-secret", on=on)
+    return [row["pseudonym"] for row in result["rows"]]
+
+
+def test_consent_signature_boundary_is_inclusive():
+    subject = make_subject("signed")  # signed_on == ON, purge far enough out
+    subject["purge_after"] = "2030-01-01"
+    assert exported([subject], on=date(2024, 6, 14)) == []
+    assert exported([subject], on=ON) == [pseudonym("signed")]
+    assert exported([subject], on=date(2024, 6, 16)) == [pseudonym("signed")]
+
+
+def test_withdrawal_boundary_is_exclusive_on_the_withdrawal_day():
+    subject = make_subject("withdrawing", purge_after="2030-01-01")
+    subject["consents"][0]["signed_on"] = "2024-01-01"
+    subject["consents"][0]["withdrawn_on"] = "2024-06-15"
+    assert exported([subject], on=date(2024, 6, 14)) == [pseudonym("withdrawing")]
+    assert exported([subject], on=ON) == []
+    assert exported([subject], on=date(2024, 6, 16)) == []
+
+
+def test_purge_boundary_is_inclusive_on_the_purge_day():
