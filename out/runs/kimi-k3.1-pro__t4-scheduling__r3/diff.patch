+def test_booking_commits_only_listed_dates_and_sequential_calls_contend():
+    january_31 = date(2024, 1, 31)
+    february_29 = date(2024, 2, 29)
+    capacity = {january_31: 1, february_29: 1}
+
+    first = book(capacity)
