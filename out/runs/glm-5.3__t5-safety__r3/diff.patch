+def test_input_order_never_changes_the_output():
+    events = [
+        event("R1", onset="2024-01-05T00:00:00Z", seriousness="hospitalization"),
+        event("R1A", follow_up_of="R1", onset="2024-01-04T00:00:00Z",
+              seriousness="fatal", source="site-a", uncertain=True),
+        event("R2", subject_pseudonym="subject-002", event_code="SYNTH-02",
+              onset="2024-01-04T00:00:00Z"),
+        event("R2A", subject_pseudonym="subject-002", event_code="SYNTH-02",
+              follow_up_of="R2", onset="2024-01-06T00:00:00Z", source="site-a"),
+        event("R3", onset="2024-01-04T00:00:00Z"),
+    ]
+    now = datetime(2024, 2, 1, tzinfo=timezone.utc)
+
+    # All three cases share the earliest onset, so case_id breaks the tie.
+    expected = [
+        {
+            "case_id": "R1",
+            "subject_pseudonym": "subject-001",
+            "event_code": "SYNTH-01",
+            "onset": "2024-01-04T00:00:00Z",
+            "seriousness": "fatal",
+            "report_by": "2024-01-11T00:00:00Z",
+            "sources": ["site-a", "site-b"],
+            "event_ids": ["R1", "R1A"],
+            "uncertain": True,
+            "overdue": True,
+        },
+        {
+            "case_id": "R2",
+            "subject_pseudonym": "subject-002",
+            "event_code": "SYNTH-02",
+            "onset": "2024-01-04T00:00:00Z",
+            "seriousness": "other",
+            "report_by": "2024-02-03T00:00:00Z",
+            "sources": ["site-a", "site-b"],
+            "event_ids": ["R2", "R2A"],
+            "uncertain": False,
+            "overdue": False,
+        },
+        {
+            "case_id": "R3",
+            "subject_pseudonym": "subject-001",
+            "event_code": "SYNTH-01",
+            "onset": "2024-01-04T00:00:00Z",
+            "seriousness": "other",
+            "report_by": "2024-02-03T00:00:00Z",
+            "sources": ["site-b"],
+            "event_ids": ["R3"],
+            "uncertain": False,
+            "overdue": False,
+        },
+    ]
+
+    assert triage_events(events, now=now) == expected
+    for permutation in permutations(events):
+        shuffled = list(permutation)
+        assert triage_events(shuffled, now=now) == expected
