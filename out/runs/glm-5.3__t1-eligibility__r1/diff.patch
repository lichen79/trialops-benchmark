+def test_input_mappings_are_not_mutated():
+    subject = make_subject()
+    protocol = make_protocol()
+    subject_snapshot = deepcopy(subject)
+    protocol_snapshot = deepcopy(protocol)
+
+    evaluate_subject(subject, protocol, date(2024, 6, 15))
+
+    assert subject == subject_snapshot
+    assert protocol == protocol_snapshot
