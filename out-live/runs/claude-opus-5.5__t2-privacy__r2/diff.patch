+def execute_reuse_export(
+    request: dict[str, object],
+    subjects,
+    *,
+    actor: str,
+    secret: str,
+    now: datetime,
+) -> dict[str, object]:
+    """Execute an approved reuse request by running a pseudonymized export.
+
+    Governance checks run first (inside ``apply_reuse_action``); ``subjects`` is
+    only consumed by the executor, which runs after every check has passed.
+    Export failures surface as ``EXECUTION_FAILED`` and leave the caller's
+    request untouched. The secret is never stored on the returned request.
+    """
+    from trialops.privacy import export_subjects
+
+    calls = 0
+
+    def executor(approved_snapshot: dict[str, object]) -> dict[str, object]:
+        nonlocal calls
+        calls += 1
+        if calls != 1:
+            raise RuntimeError("executor already used")
+        # ``now`` has already been validated by apply_reuse_action.
+        on = _aware_utc(now).date()
+        return export_subjects(
+            subjects,
+            purpose=approved_snapshot.get("purpose"),
+            secret=secret,
+            on=on,
+        )
+
+    return apply_reuse_action(request, "execute", actor, now, executor=executor)
