+@pytest.mark.parametrize("defect", PRIVACY_PLAN_DEFECTS)
+def test_execution_requires_the_exact_privacy_plan_not_a_boolean(defect):
+    candidate = approved_request()
+    defect(candidate)
+    executor = RecordingExecutor()
+    assert_fails_atomically(
+        candidate, "execute", "alice", NOW, "PSEUDONYMIZATION_REQUIRED", executor
+    )
+    assert executor.calls == []
