@@ -0,0 +1,259 @@
+from copy import deepcopy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops.scheduling import book_subject_visits, plan_visits
+
+ON = date(2024, 6, 15)
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3], "Z": [10, 20]},
+        "exclusions": ["DO_NOT_ENROLL", "PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+        "labs": {"A": 2, "Z": 15},
+        "flags": [],
+    }
+
+
+def book(capacity, *, subject=None, protocol=None, **overrides):
+    arguments = {
+        "on": ON,
+        "first_day": date(2024, 1, 31),
+        "offsets_months": [0, 1],
+        "hour": 9,
+        "minute": 5,
+        "timezone": "America/New_York",
+        "capacity": capacity,
+    }
+    arguments.update(overrides)
+    return book_subject_visits(
+        make_subject() if subject is None else subject,
+        make_protocol() if protocol is None else protocol,
+        **arguments,
+    )
+
+
+def local_days(visits):
+    return [visit["local"][:10] for visit in visits]
+
+
+def test_sequential_bookings_compete_for_persistent_slots():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 2}
+
+    first = book(capacity)
+    assert local_days(first) == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 1}
+
+    second = book(capacity)
+    assert local_days(second) == ["2024-02-01", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+    third = book(capacity)
+    assert local_days(third) == ["2024-02-01", "2024-03-01"]
+    # Unlisted dates stay unconstrained and are never inserted.
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+
+def test_visits_of_one_booking_share_a_slot_date():
+    closed = {date(2024, 1, 31)} | {date(2024, 2, day) for day in range(1, 29)}
+    original_closed = closed.copy()
+    capacity = {date(2024, 2, 29): 2, date(2024, 3, 1): 5}
+
+    visits = book(capacity, offsets_months=[0, 1, 2], closed_days=closed)
+
+    assert [visit["offset_months"] for visit in visits] == [0, 1, 2]
+    assert local_days(visits) == ["2024-02-29", "2024-02-29", "2024-03-31"]
+    assert capacity == {date(2024, 2, 29): 0, date(2024, 3, 1): 5}
+    assert closed == original_closed
+
+
+def test_returns_the_plan_unchanged_and_does_not_mutate_subject_or_protocol():
+    subject = make_subject()
+    protocol = make_protocol()
+    original_subject = deepcopy(subject)
+    original_protocol = deepcopy(protocol)
+    capacity = {date(2024, 1, 31): 3}
+    expected = plan_visits(
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=5,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+
+    visits = book(capacity, subject=subject, protocol=protocol)
+
+    assert visits == expected
+    assert subject == original_subject
+    assert protocol == original_protocol
+    assert capacity == {date(2024, 1, 31): 2}
+
+
+def test_later_visit_failure_rolls_back_but_earlier_bookings_stay_committed():
+    second_nominal = date(2024, 2, 1)
+    closed = {second_nominal + timedelta(days=days) for days in range(367)}
+    original_closed = closed.copy()
+    capacity = {date(2024, 1, 1): 2}
+
+    book(capacity, first_day=date(2024, 1, 1), offsets_months=[0])
+    assert capacity == {date(2024, 1, 1): 1}
+
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(
+            capacity,
+            first_day=date(2024, 1, 1),
+            offsets_months=[0, 1],
+            closed_days=closed,
+        )
+
+    assert capacity == {date(2024, 1, 1): 1}
+    assert closed == original_closed
+
+
+def test_ineligible_subject_reports_ordered_reasons_and_reserves_nothing():
+    subject = make_subject()
+    subject.update(flags=["PRIOR", "DO_NOT_ENROLL"], labs={"Z": 21, "A": 0})
+    original_subject = deepcopy(subject)
+    capacity = {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError) as raised:
+        book(capacity, subject=subject)
+
+    assert str(raised.value) == (
+        "INELIGIBLE:EXCLUSION_DO_NOT_ENROLL,EXCLUSION_PRIOR,LAB_A_LOW,LAB_Z_HIGH"
+    )
+    assert capacity == {date(2024, 1, 31): 1}
+    assert subject == original_subject
+
+
+def test_eligibility_is_checked_before_planning_inputs():
+    subject = make_subject()
+    subject["flags"] = ["PRIOR"]
+    capacity = {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError, match="^INELIGIBLE:EXCLUSION_PRIOR$"):
+        book(capacity, subject=subject, timezone="Not/A_Real_Zone")
+
+    assert capacity == {date(2024, 1, 31): 1}
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"timezone": "Not/A_Real_Zone"},
+        {"hour": 24},
+        {"minute": 60},
+        {"offsets_months": [0, 0]},
+        {"offsets_months": [-1]},
+    ],
+)
+def test_invalid_planning_input_leaves_capacity_unchanged(overrides):
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 1}
+
+    with pytest.raises(ValueError):
+        book(capacity, **overrides)
+
+    assert capacity == {date(2024, 1, 31): 1, date(2024, 2, 29): 1}
+
+
+def test_invalid_capacity_values_are_rejected_without_changes():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): -1}
+
+    with pytest.raises(ValueError, match="INVALID_CAPACITY"):
+        book(capacity)
+
+    assert capacity == {date(2024, 1, 31): 1, date(2024, 2, 29): -1}
+
+
+def test_capacity_must_be_a_dict():
+    with pytest.raises(TypeError):
+        book(None)
+
+
+def test_month_end_clamping_is_preserved_across_a_leap_year():
+    capacity = {date(2024, 2, 29): 1, date(2025, 2, 28): 1}
+
+    visits = book(capacity, offsets_months=[1, 2, 13])
+
+    assert [visit["local"] for visit in visits] == [
+        "2024-02-29T09:05:00-05:00",
+        "2024-03-31T09:05:00-04:00",
+        "2025-02-28T09:05:00-05:00",
+    ]
+    assert visits[0]["utc"] == "2024-02-29T14:05:00Z"
+    assert capacity == {date(2024, 2, 29): 0, date(2025, 2, 28): 0}
+
+
+def test_spring_forward_gap_and_wall_time_after_rescheduling():
+    capacity = {date(2024, 3, 10): 1}
+    arguments = {
+        "first_day": date(2024, 3, 10),
+        "offsets_months": [0],
+        "hour": 2,
+        "minute": 30,
+    }
+
+    [in_gap] = book(capacity, **arguments)
+    assert in_gap == {
+        "offset_months": 0,
+        "local": "2024-03-10T03:30:00-04:00",
+        "utc": "2024-03-10T07:30:00Z",
+    }
+    assert capacity == {date(2024, 3, 10): 0}
+
+    # The full day pushes the next subject to a day where 02:30 exists.
+    [moved] = book(capacity, **arguments)
+    assert moved == {
+        "offset_months": 0,
+        "local": "2024-03-11T02:30:00-04:00",
+        "utc": "2024-03-11T06:30:00Z",
+    }
+    assert capacity == {date(2024, 3, 10): 0}
+
+
+def test_fall_back_uses_fold_zero_and_reserves_the_slot():
+    capacity = {date(2024, 11, 3): 2}
+
+    [visit] = book(
+        capacity,
+        first_day=date(2024, 11, 3),
+        offsets_months=[0],
+        hour=1,
+        minute=30,
+    )
+
+    assert visit["local"] == "2024-11-03T01:30:00-04:00"
+    assert visit["utc"] == "2024-11-03T05:30:00Z"
+    assert capacity == {date(2024, 11, 3): 1}
+
+
+def test_paris_gap_moves_into_the_closed_day_successor_gap():
+    capacity = {date(2024, 3, 31): 1}
+
+    [visit] = book(
+        capacity,
+        first_day=date(2024, 3, 30),
+        offsets_months=[0],
+        hour=2,
+        minute=30,
+        timezone="Europe/Paris",
+        closed_days=[date(2024, 3, 30)],
+    )
+
+    assert visit["local"] == "2024-03-31T03:30:00+02:00"
+    assert visit["utc"] == "2024-03-31T01:30:00Z"
+    assert capacity == {date(2024, 3, 31): 0}
