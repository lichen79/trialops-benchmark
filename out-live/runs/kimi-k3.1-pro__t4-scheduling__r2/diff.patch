+def book_subject_visits(
+    subject,
+    protocol,
+    *,
+    on: date,
+    first_day: date,
+    offsets_months: Iterable[int],
+    hour: int,
+    minute: int,
+    timezone: str,
+    capacity: dict[date, int],
+    closed_days: Iterable[date] | None = None,
+) -> list[dict[str, object]]:
+    """Plan eligible visits, then atomically commit their persistent slots."""
+    eligibility = evaluate_subject(subject, protocol, on)
+    if not eligibility["eligible"]:
+        raise ValueError("INELIGIBLE: " + ", ".join(eligibility["reasons"]))
+    if not isinstance(capacity, dict):
+        raise TypeError("capacity must be a caller-owned dict of dates to slots")
+
+    # Planning copies every capacity value it uses. Nothing is committed until
+    # the whole plan, including any later visit, has succeeded.
+    visits = plan_visits(
+        first_day=first_day,
+        offsets_months=offsets_months,
+        hour=hour,
+        minute=minute,
+        timezone=timezone,
+        closed_days=closed_days,
+        capacity=capacity,
+    )
+    visit_days = tuple(
+        date.fromisoformat(visit["local"][:10]) for visit in visits
+    )
+    for visit_day in visit_days:
+        if visit_day in capacity:
+            capacity[visit_day] -= 1
 
     return visits
 
