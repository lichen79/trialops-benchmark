--- a/tests/test_booking.py	1970-01-01 01:00:00
+++ b/tests/test_booking.py	2026-11-13 20:36:42
@@ -0,0 +1,230 @@
+import copy
+from datetime import date, timedelta
+
+import pytest
+
+from trialops import scheduling
+from trialops.scheduling import book_subject_visits, plan_visits
+
+ON = date(2024, 6, 15)
+
+
+def make_protocol():
+    return {
+        "min_age": 18,
+        "max_age": 30,
+        "required_consent_version": "v2",
+        "consent_valid_from": "2024-01-01",
+        "labs": {"A": [1, 3], "Z": [10, 20]},
+        "exclusions": ["DO_NOT_ENROLL", "PRIOR"],
+    }
+
+
+def make_subject():
+    return {
+        "birth_date": "2000-06-15",
+        "consents": [{"version": "v2", "signed_on": "2024-06-15"}],
+        "labs": {"A": 2, "Z": 15},
+        "flags": [],
+    }
+
+
+def make_ineligible_subject():
+    subject = make_subject()
+    subject.update(
+        birth_date="1970-01-01",
+        consents=[{"version": "v1", "signed_on": "2023-12-31"}],
+        flags=["PRIOR", "DO_NOT_ENROLL"],
+        labs={"Z": 21, "A": 0},
+    )
+    return subject
+
+
+def book(capacity, subject=None, protocol=None, **overrides):
+    arguments = dict(
+        on=ON,
+        first_day=date(2024, 1, 31),
+        offsets_months=[0, 1],
+        hour=9,
+        minute=0,
+        timezone="America/New_York",
+        capacity=capacity,
+    )
+    arguments.update(overrides)
+    return book_subject_visits(
+        make_subject() if subject is None else subject,
+        make_protocol() if protocol is None else protocol,
+        **arguments,
+    )
+
+
+def _days(visits):
+    return [visit["local"][:10] for visit in visits]
+
+
+def test_sequential_bookings_contend_for_persistent_slots():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 2}
+
+    first = book(capacity)
+    assert _days(first) == ["2024-01-31", "2024-02-29"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 1}
+
+    second = book(capacity)
+    assert _days(second) == ["2024-02-01", "2024-02-29"]
+    # 1 Feb is unlisted: it stays unconstrained and is never inserted.
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+    third = book(capacity)
+    assert _days(third) == ["2024-02-01", "2024-03-01"]
+    assert capacity == {date(2024, 1, 31): 0, date(2024, 2, 29): 0}
+
+
+def test_visits_of_one_booking_sharing_a_day_each_take_a_slot():
+    closed = {date(2024, 1, 31) + timedelta(days=n) for n in range(30)}  # to Feb 29
+    capacity = {date(2024, 3, 1): 3}
+
+    visits = book(capacity, closed_days=closed)
+
+    assert _days(visits) == ["2024-03-01", "2024-03-01"]
+    assert capacity == {date(2024, 3, 1): 1}
+
+    visits = book(capacity, closed_days=closed)
+
+    assert _days(visits) == ["2024-03-01", "2024-03-02"]
+    assert capacity == {date(2024, 3, 1): 0}
+
+
+def test_later_visit_failure_rolls_back_but_keeps_earlier_bookings():
+    capacity = {date(2024, 1, 31): 2}
+    book(capacity, offsets_months=[0])
+    assert capacity == {date(2024, 1, 31): 1}
+
+    closed = {date(2024, 2, 29) + timedelta(days=n) for n in range(367)}
+    original_closed = closed.copy()
+    with pytest.raises(ValueError, match="UNSCHEDULABLE"):
+        book(capacity, closed_days=closed)
+
+    assert capacity == {date(2024, 1, 31): 1}
+    assert closed == original_closed
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"hour": 24},
+        {"minute": 60},
+        {"timezone": "Not/A_Real_Zone"},
+        {"offsets_months": [0, 0]},
+        {"offsets_months": [-1]},
+    ],
+)
+def test_invalid_planning_input_leaves_capacity_unchanged(overrides):
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): 1}
+
+    with pytest.raises(ValueError):
+        book(capacity, **overrides)
+
+    assert capacity == {date(2024, 1, 31): 1, date(2024, 2, 29): 1}
+
+
+def test_invalid_capacity_is_rejected_without_changes():
+    capacity = {date(2024, 1, 31): 1, date(2024, 2, 29): -1}
+    with pytest.raises(ValueError, match="INVALID_CAPACITY"):
+        book(capacity)
+    assert capacity == {date(2024, 1, 31): 1, date(2024, 2, 29): -1}
+
+    with pytest.raises(TypeError):
+        book(None)
+
+
+def test_ineligible_subject_is_rejected_before_planning(monkeypatch):
+    def fail(**_):
+        raise AssertionError("plan_visits must not run for ineligible subjects")
+
+    monkeypatch.setattr(scheduling, "plan_visits", fail)
+    subject = make_ineligible_subject()
+    protocol = make_protocol()
+    subject_before = copy.deepcopy(subject)
+    protocol_before = copy.deepcopy(protocol)
+    capacity = {date(2024, 1, 31): 1}
+
+    with pytest.raises(ValueError) as raised:
+        book(capacity, subject=subject, protocol=protocol)
+
+    assert str(raised.value) == (
+        "INELIGIBLE:CONSENT_MISSING,CONSENT_VERSION,AGE_ABOVE_MAX,"
+        "EXCLUSION_DO_NOT_ENROLL,EXCLUSION_PRIOR,LAB_A_LOW,LAB_Z_HIGH"
+    )
+    assert capacity == {date(2024, 1, 31): 1}
+    assert subject == subject_before
+    assert protocol == protocol_before
+
+
+def test_eligibility_is_evaluated_on_the_given_date():
+    capacity = {date(2024, 1, 31): 1}
+
+    # The only consent is signed on ON, so the day before there is none.
+    with pytest.raises(ValueError, match="^INELIGIBLE:CONSENT_MISSING$"):
+        book(capacity, on=ON - timedelta(days=1))
+
+    assert capacity == {date(2024, 1, 31): 1}
+
+
+def test_booking_returns_the_plan_unchanged_with_dst_and_month_ends():
+    arguments = dict(
+        first_day=date(2024, 1, 31),
+        offsets_months=[2, 1, 9],
+        hour=2,
+        minute=30,
+        timezone="Europe/Paris",
+        closed_days=[date(2024, 10, 31)],
+    )
+    capacity = {date(2024, 3, 31): 1, date(2024, 2, 29): 5}
+    expected = plan_visits(capacity=dict(capacity), **arguments)
+    subject = make_subject()
+    protocol = make_protocol()
+    subject_before = copy.deepcopy(subject)
+    protocol_before = copy.deepcopy(protocol)
+
+    visits = book_subject_visits(
+        subject, protocol, on=ON, capacity=capacity, **arguments
+    )
+
+    assert visits == expected == [
+        {
+            "offset_months": 2,
+            "local": "2024-03-31T03:30:00+02:00",
+            "utc": "2024-03-31T01:30:00Z",
+        },
+        {
+            "offset_months": 1,
+            "local": "2024-02-29T02:30:00+01:00",
+            "utc": "2024-02-29T01:30:00Z",
+        },
+        {
+            "offset_months": 9,
+            "local": "2024-11-01T02:30:00+01:00",
+            "utc": "2024-11-01T01:30:00Z",
+        },
+    ]
+    assert capacity == {date(2024, 3, 31): 0, date(2024, 2, 29): 4}
+    assert arguments["closed_days"] == [date(2024, 10, 31)]
+    assert subject == subject_before
+    assert protocol == protocol_before
+
+
+def test_booking_preserves_new_york_gap_and_fold_handling():
+    capacity = {date(2024, 3, 10): 1, date(2024, 11, 3): 1}
+
+    [spring] = book(
+        capacity, first_day=date(2024, 3, 10), offsets_months=[0], hour=2, minute=30
+    )
+    [autumn] = book(
+        capacity, first_day=date(2024, 11, 3), offsets_months=[0], hour=1, minute=30
+    )
+
+    assert spring["local"] == "2024-03-10T03:30:00-04:00"
+    assert spring["utc"] == "2024-03-10T07:30:00Z"
+    assert autumn["local"] == "2024-11-03T01:30:00-04:00"
+    assert autumn["utc"] == "2024-11-03T05:30:00Z"
+    assert capacity == {date(2024, 3, 10): 0, date(2024, 11, 3): 0}
